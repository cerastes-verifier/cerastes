//
// The diagnostics of the cerastes back end (decisions 0006 item 10, 0007).
// One line per diagnostic: CERASTES_DIAG(tag, severity, "message").  The tag is
// lower case; it is printed as `#cerastes-<tag>` when --display_error_number is
// on, and tests name it as `cerastes-<tag>`.  scripts/run_tests.py reads the tags
// from this file, so a new line here is all a new test needs.  `%s` in a message
// is replaced by the arguments of the report, in order.  Messages follow EDG's
// style: lower case, no final period.
//
// X-macro: this file is included with CERASTES_DIAG defined.

CERASTES_DIAG(contract_not_after_parameters, error,
              "\"cerastes::%s\" must be written directly after the parameter list")
CERASTES_DIAG(annotation_side_effect, error,
              "%s is not allowed in an annotation (annotations must not have side effects)")
CERASTES_DIAG(statement_expression_in_annotation, error,
              "a statement expression is not allowed in an annotation")
CERASTES_DIAG(fold_argument_not_call, error,
              "the argument of \"cerastes::%s\" must be a direct call of a predicate function")
CERASTES_DIAG(fold_callee_not_predicate, error,
              "function \"%s\" is called in \"cerastes::%s\" but is not marked [[cerastes::predicate]]")
CERASTES_DIAG(predicate_not_bool, error,
              "a [[cerastes::predicate]] function must return bool, but \"%s\" returns \"%s\"")
CERASTES_DIAG(pure_returns_void, error,
              "a [[cerastes::pure]] function must return a value, but \"%s\" returns void")
CERASTES_DIAG(predicate_and_pure, error,
              "function \"%s\" cannot be both [[cerastes::predicate]] and [[cerastes::pure]]")
CERASTES_DIAG(contract_on_predicate, error,
              "a [[cerastes::predicate]] function cannot have a contract (\"cerastes::%s\" on \"%s\")")
CERASTES_DIAG(old_outside_ensures, error,
              "\"cerastes::old\" can only be used in \"cerastes::ensures\"")
CERASTES_DIAG(invariant_shadowed_by_loop_variable, error,
              "\"%s\" in this invariant is not the variable of the same name declared by the loop")
CERASTES_DIAG(annotation_on_lambda, error,
              "\"cerastes::%s\" cannot be applied to a lambda expression")
CERASTES_DIAG(modules_unsupported, error,
              "C++20 modules are not supported: contracts are not carried through module files")
CERASTES_DIAG(parameter_after_pack, error,
              "a function with a contract cannot have a parameter after a function parameter pack (\"%s\")")
CERASTES_DIAG(result_name_on_void, error,
              "the result name \"%s\" of \"cerastes::ensures\" is not allowed: \"%s\" returns void")
CERASTES_DIAG(contract_not_propagated, error,
              "the contract of \"%s\" is missing on \"%s\" (the template's contract was not carried to it)")
CERASTES_DIAG(spec_call_in_code, error,
              "specification function \"%s\" cannot be called from ordinary code")
CERASTES_DIAG(annotation_substitution_error, error,
              "an annotation argument is erroneous after template substitution (%s)")
CERASTES_DIAG(generic_lambda_in_annotation, error,
              "a generic lambda (auto or template parameters) is not allowed in an annotation: its call operator is never checked")
CERASTES_DIAG(unsupported_annotation_expression, error,
              "this version cannot check this part of an annotation: %s")
CERASTES_DIAG(cerastes_macro_changed, error,
              "__CERASTES__ is defined by the front end and cannot be %s: code that tests it would no longer see the annotations the front end reads")
CERASTES_DIAG(source_scan_incomplete, error,
              "the source files could not all be checked for a change of __CERASTES__: %s")
CERASTES_DIAG(contract_name_hides_member, error,
              "\"%s\" in this contract is not the member \"%s\" of the class: the class declares it after the function")
CERASTES_DIAG(analysis_limit_reached, error,
              "the checks of this annotation or body reached a limit (%s) and cannot vouch for it")

// ---- M3 re-look R2/R4 (annotation_checks.cpp) ----------------------------------------------------
CERASTES_DIAG(cerastes_header_in_namespace, error,
              "\"%s\" is declared in a namespace \"cerastes\" that is not the global one: <cerastes.h> must be included at "
              "global scope, so that the specification functions are cerastes::owns and the like")
CERASTES_DIAG(in_class_specialization_contract, error,
              "the explicit specialization \"%s\" of a member template, written inside its class, cannot be checked against "
              "the member template's contract: write the specialization at namespace scope (decision 0006 item 6)")
CERASTES_DIAG(spec_marker_on_special_member, error,
              "\"cerastes::%s\" cannot be applied to the special member function \"%s\": a constructor, a destructor "
              "and an assignment operator have effects, and a specification function has none")
CERASTES_DIAG(spec_marker_in_system_file, error,
              "\"cerastes::%s\" cannot be applied to \"%s\": it is declared in a system file or built in, and "
              "specification functions are your own")
CERASTES_DIAG(annotation_macro_changed, error,
              "the macro \"%s\" cannot be %s here: the annotations and <cerastes.h> depend on it (decision 0008)")

// ---- verify mode (`cerastes verify`, decisions 0011 and 0012) ---------------------------------------
// Rejections made while the IL is encoded for verification.  They are reported only in verify mode, for
// code in files that are verified (0011 item 4); `cerastes-fe` never reports them.  Each is an
// "unsupported construct is rejected, never approximated" diagnostic (invariant 3).  In the messages
// `%s` is a short description of the construct, in the user's terms.
CERASTES_DIAG(unsupported_statement, error,
              "%s is not supported by \"cerastes verify\" (decision 0012)")
CERASTES_DIAG(unsupported_expression, error,
              "%s is not supported by \"cerastes verify\" (decision 0012)")
// A tool failure, not a statement about the program (decision 0022 item 12): lowering's own checks, the emitter's checks and the
// encoder's guards.  `cerastes verify` exits 3 after printing it.
CERASTES_DIAG(internal_inconsistency, error,
              "an internal inconsistency: %s (the program was not checked; decision 0022 item 12)")
CERASTES_DIAG(unsupported_declaration, error,
              "%s is not supported by \"cerastes verify\" (decision 0012)")
CERASTES_DIAG(unsupported_type, error,
              "type \"%s\" is not supported by \"cerastes verify\": only integer types, bool and the enumerations of the verified "
              "files are (decisions 0012 and 0018)")
// A permission atom or a place the memory model does not read yet (decision 0037 items 5 and 15); the message says which session lifts it.
CERASTES_DIAG(unsupported_annotation, error,
              "%s is not supported by \"cerastes verify\" (decision 0037)")
CERASTES_DIAG(unsupported_attribute, error,
              "the attribute %s is not supported by \"cerastes verify\": it can change what the code means "
              "(decision 0011 item 7)")
CERASTES_DIAG(unrecognized_attribute, error,
              "the attribute %s is not recognized: it would be ignored, so what it was meant to say would "
              "not be checked (decision 0011 item 7)")
CERASTES_DIAG(line_directive_in_verify, error,
              "a #line directive or linemarker is not allowed in a file that \"cerastes verify\" checks: it "
              "changes the file names of the lines after it (decision 0011 item 4)")
CERASTES_DIAG(contract_on_main, error,
              "\"main\" cannot have \"cerastes::requires\": nothing calls it, so the precondition would be "
              "assumed and never checked (decision 0011 item 7)")
CERASTES_DIAG(call_without_contract, error,
              "the call to \"%s\" cannot be verified: the function has no body in a verified file and no "
              "contract (\"cerastes::requires\" or \"cerastes::ensures\") on a visible declaration")
CERASTES_DIAG(call_in_annotation, error,
              "a call to \"%s\" is not allowed in an annotation: only \"cerastes::old\" can be called here")
CERASTES_DIAG(system_header_pragma_in_verify, error,
              "a \"#pragma ... system_header\" is not allowed in a file that \"cerastes verify\" checks: it would "
              "make the rest of the file a system header, which is never verified (decision 0011 item 4)")
CERASTES_DIAG(diagnostic_pragma_in_verify, error,
              "a diagnostic pragma in a verified file: cerastes relies on the front end's errors, which it could "
              "turn off (decision 0017 item 2)")
CERASTES_DIAG(missing_decreases, error,
              "%s (decision 0013)")
CERASTES_DIAG(ensures_on_noreturn, error,
              "\"cerastes::ensures\" on a function declared not to return: it never returns, so the postcondition "
              "would never be checked (decision 0015)")
// A switch over an enumeration is held to the two rules of -Wswitch (decision 0019 item 11).
CERASTES_DIAG(case_not_in_enumeration, error,
              "case value %s is not the value of an enumerator of \"%s\"")
CERASTES_DIAG(enumerator_not_handled, error,
              "enumerator \"%s\" of \"%s\" is not handled in this switch, which has no default label")

// Side effects inside expressions (decision 0020 items 4-5): C's sequencing rule, and the shapes that clang's and GCC's
// -Wall warn about, which are rejected like errors.
CERASTES_DIAG(unsequenced_modification, error,
              "\"%s\" is modified in this expression and also read or modified elsewhere in it with no sequence point "
              "between: the behavior is undefined (decision 0020)")
CERASTES_DIAG(assignment_as_condition, error,
              "an assignment is used as a condition without extra parentheses: write \"((x = e))\" or compare the value "
              "(\"(x = e) != 0\"), as -Wparentheses asks (decision 0020)")
CERASTES_DIAG(comma_without_effect, error,
              "an operand of this comma operator has no side effect, so the value it computes is thrown away "
              "(decision 0020)")
CERASTES_DIAG(value_not_used, error,
              "the value of this expression is not used, and the expression has a side effect inside it: write the "
              "effect as a statement of its own, or cast the whole expression to void (decision 0020)")
CERASTES_DIAG(side_effect_not_evaluated, error,
              "the side effect in this operand of %s is never evaluated: the operand is not executed "
              "(decision 0020)")

// Calls in expressions and the shapes that clang's -Wself-assign warns about (decision 0021).
CERASTES_DIAG(unsequenced_calls, error,
              "%s: C may call either of them first, and something this expression checks, or evaluates on one path only, "
              "depends on only one of them, so a call that does not return could keep it from being checked; write the calls as "
              "separate statements (decision 0021)")
CERASTES_DIAG(self_assignment, error,
              "this assigns a variable to itself, as -Wself-assign warns: the assignment has no effect and is "
              "almost always a mistake (decision 0021)")

// The shapes the compilers warn about around the bitwise operators (decision 0023 item 5; P41).  Rejections at the operator, in
// both modes, with the compiler flag that warns and the fix.
CERASTES_DIAG(bitwise_operand_parentheses, error,
              "an operand of this bitwise operator is an unparenthesized comparison, `+`, `-` or different bitwise operator, "
              "so the precedence is probably not the one intended (-Wparentheses, -Wbitwise-op-parentheses): add "
              "parentheses (decision 0023)")
CERASTES_DIAG(logical_not_bitwise, error,
              "`!x` is the left operand of this bitwise operator, which is probably meant as `!(x & y)` or as a logical "
              "operator (-Wlogical-not-parentheses, -Wparentheses): write `(!x) & y`, `!(x & y)` or `&&` (decision 0023)")
CERASTES_DIAG(complement_of_truth_value, error,
              "`~` is applied to a truth value (a comparison, a bool, `!`, `&&` or `||`), and the result is not its "
              "negation (-Wbool-operation): write `!` (decision 0023)")
CERASTES_DIAG(bitwise_condition_parentheses, error,
              "the condition of this `?:` is an unparenthesized `&` or `|` whose right operand is a truth value, so the "
              "precedence is probably not the one intended (-Wbitwise-conditional-parentheses): add parentheses "
              "(decision 0023)")
CERASTES_DIAG(bitwise_instead_of_logical, error,
              "`&` or `|` on two truth values that both have side effects evaluates both operands, which `&&` or `||` "
              "would not (-Wbitwise-instead-of-logical): write the logical operator (decision 0023)")
CERASTES_DIAG(tautological_bitwise_compare, error,
              "this bitwise operation with a constant makes the comparison or the condition always true or always false "
              "(-Wtautological-compare, -Wtautological-bitwise-compare): check the constants (decision 0023)")
CERASTES_DIAG(xor_as_power, error,
              "`^` is the bitwise exclusive or, not a power: `2 ^ 8` is 10, not 256 (-Wxor-used-as-pow): write `1 << n` "
              "for a power of two, or the constant (decision 0023)")

// The other shapes the compilers warn about by default or under -Wall (decision 0025 item 6; P48).  Rejections at the operator, in
// both modes, with the compiler flag that warns and the fix.
CERASTES_DIAG(logical_operand_parentheses, error,
              "an operand of this `||` is an unparenthesized `&&`, so the precedence is probably not the one intended "
              "(-Wlogical-op-parentheses, -Wparentheses): add parentheses (decision 0025)")
CERASTES_DIAG(shift_operand_parentheses, error,
              "an operand of this shift is an unparenthesized `+` or `-`, which binds tighter than the shift but is easily "
              "read the other way (-Wshift-op-parentheses, -Wparentheses): add parentheses (decision 0025)")
CERASTES_DIAG(self_comparison, error,
              "both sides of this comparison are the same expression, so its result does not depend on it "
              "(-Wtautological-compare): check the operands (decision 0025)")
CERASTES_DIAG(logical_not_comparison, error,
              "`!x` is the left operand of this comparison, which is probably meant as `!(x == y)` "
              "(-Wlogical-not-parentheses, -Wparentheses): write `(!x) == y` or `!(x == y)` (decision 0025)")
CERASTES_DIAG(chained_comparison, error,
              "an operand of this comparison is itself an unparenthesized comparison, which does not behave as the "
              "mathematical chain `a < b < c` (-Wparentheses): write `a < b && b < c` or add parentheses (decision 0025)")
CERASTES_DIAG(truth_value_compare, error,
              "a truth value is 0 or 1, and this comparison with a constant gives the same result for both "
              "(-Wtautological-constant-out-of-range-compare, -Wbool-compare): check the constant (decision 0025)")
CERASTES_DIAG(int_in_truth_context, error,
              "an integer operation, a `?:` with integer constants or an enumerator is used as a truth value "
              "(-Wint-in-bool-context): write the comparison with 0 explicitly (decision 0025)")

// More shapes clang or GCC warn about by default or under -Wall (decision 0025 item 6, R9-R13; P50).
CERASTES_DIAG(constant_logical_operand, error,
              "the right operand of this `&&` or `||` is an integer constant, so it is probably not the logical operation "
              "that was meant (-Wconstant-logical-operand): write the comparison, or `&` for a mask (decision 0025)")
CERASTES_DIAG(constant_out_of_range_compare, error,
              "this comparison is always the same, because the constant is outside the range of the other operand's type "
              "(-Wtautological-constant-out-of-range-compare): check the constant or the type (decision 0025)")
CERASTES_DIAG(overlapping_comparisons, error,
              "the two comparisons of this `&&` or `||` overlap, so the whole is always false or always true "
              "(-Wtautological-overlap-compare): check the constants and the operator (decision 0025)")
CERASTES_DIAG(dangling_else, error,
              "this `else` belongs to the inner `if`, not to the outer one, which has no braces (-Wdangling-else): add "
              "braces (decision 0025)")
CERASTES_DIAG(empty_body, error,
              "the body of this statement is an empty statement, so the statement does nothing (-Wempty-body): write "
              "`{}` if that is meant (decision 0025)")
