# cerastes's tool code in the owner's Boost style (decision 0051; vlibc's CLAUDE.md "Code style").
# The style lives only in src/.clang-format and include/.clang-format, which are byte-identical
# (scripts/format.sh compares them with cmp); every other directory is covered by the root file, which
# disables formatting.  Pinned clang-format 23.1.3 (scripts/bootstrap.sh); scripts/format.sh applies this
# style to src/ and include/cerastes.h.
# InsertBraces is the only option that changes tokens: RemoveBracesLLVM, RemoveParentheses,
# RemoveSemicolon, QualifierAlignment, IntegerLiteralSeparator, SortIncludes and SortUsingDeclarations
# stay off.  Three options can change comment text, never code: FixNamespaceComments (writes or
# corrects `// namespace x` after a closing brace), SpacesInLineCommentPrefix (minimum 1: `//x` becomes
# `// x`) and ReflowComments: IndentOnly (re-indents comment lines, never re-wraps them).  The rest is
# whitespace.
BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 120
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never

# Allman: a brace goes on its own line after classes, structs, enums, functions, control statements,
# `else`, `catch` and case labels (the exemplars) and before lambda bodies (owner, question 149);
# namespaces and `extern "C"` blocks keep it attached; `} while (c);` stays together.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
InsertBraces: true                     # braces around every controlled statement

PointerAlignment: Left                 # T* p
ReferenceAlignment: Pointer            # T& r
DerivePointerAlignment: false
SpaceBeforeParens: ControlStatements   # if (, for (, while (, switch (; none after a function's name
SpaceBeforeCpp11BracedList: true       # T x {e};

IndentCaseLabels: true
AccessModifierOffset: -4               # public: at the class's column
NamespaceIndentation: None
FixNamespaceComments: true             # } // namespace x
IndentExternBlock: NoIndent
IndentPPDirectives: Leave              # directives in a function are indented by hand, to the code's level
AlignEscapedNewlines: Left             # the backslashes of a macro close up on the longest line
BreakTemplateDeclarations: Yes         # template <...> on its own line

# EDG's headers depend on include order: nothing is reordered.
SortIncludes: Never
IncludeBlocks: Preserve
SortUsingDeclarations: Never           # LLVM style sorts them, which reorders tokens

# Strings stay whole and comments are only re-indented, never re-flowed.
BreakStringLiterals: false
ReflowComments: IndentOnly

AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: Empty
AllowShortLoopsOnASingleLine: false
