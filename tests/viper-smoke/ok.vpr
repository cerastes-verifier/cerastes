// expect: verified
//
// Smoke test: Silicon and Z3 verify a small correct program that uses
// contracts, a loop invariant, a heap field and a predicate.

field val: Int

predicate cell(c: Ref) {
  acc(c.val) && c.val >= 0
}

method sum_to(n: Int) returns (s: Int)
  requires n >= 0
  ensures 2 * s == n * (n + 1)
{
  s := 0
  var i: Int := 0
  while (i < n)
    invariant 0 <= i && i <= n
    invariant 2 * s == i * (i + 1)
  {
    i := i + 1
    s := s + i
  }
}

method bump(c: Ref)
  requires cell(c)
  ensures cell(c)
  ensures (unfolding cell(c) in c.val) == old(unfolding cell(c) in c.val) + 1
{
  unfold cell(c)
  c.val := c.val + 1
  fold cell(c)
}
