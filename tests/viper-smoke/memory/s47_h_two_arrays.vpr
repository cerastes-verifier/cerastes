  exhale forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).v_int)
  exhale forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).d_int)
