  assert !((perm(loc(block_of(vb), offset_of(vb) + 2).v_int) != write) || (perm(loc(block_of(vb), offset_of(vb) + 2).d_int) != write)) //WPERM
  loc(block_of(vb), offset_of(vb) + 2).v_int := 3
  loc(block_of(vb), offset_of(vb) + 2).d_int := true
  assert !((offset_of(va) + 3 < 0) || (len(block_of(va)) <= offset_of(va) + 3)) //BOUND
  assert !((perm(loc(block_of(va), offset_of(va) + 3).v_int) != write) || (perm(loc(block_of(va), offset_of(va) + 3).d_int) != write)) //WPERM
  loc(block_of(va), offset_of(va) + 3).v_int := 0
  loc(block_of(va), offset_of(va) + 3).d_int := true
  assert !((offset_of(vb) + 3 < 0) || (len(block_of(vb)) <= offset_of(vb) + 3)) //BOUND
  assert !((perm(loc(block_of(vb), offset_of(vb) + 3).v_int) != write) || (perm(loc(block_of(vb), offset_of(vb) + 3).d_int) != write)) //WPERM
  loc(block_of(vb), offset_of(vb) + 3).v_int := 4
  loc(block_of(vb), offset_of(vb) + 3).d_int := true
  v_i := 0
  assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).d_int) //MARKED
  assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).d_int) //MARKED
  kl_0 := perm(lvloc(block_of(v_w)).lv)
  kv_n := perm(loc(member(v_w, 2), 0).v_int)
  kd_n := perm(loc(member(v_w, 2), 0).d_int)
  ds_n := false
  if (kd_n > none) { ds_n := loc(member(v_w, 2), 0).d_int }
  vs_n := perm(loc(member(v_w, 2), 0).v_int) > none ? loc(member(v_w, 2), 0).v_int : 0
  label lh_0
  while ((v_i < 4))
    invariant acc(lvloc(block_of(v_w)).lv, kl_0)
    invariant forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).v_int)
    invariant forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).d_int)
    invariant forall k: Int :: { loc(block_of(va), k) } (((0 <= k) && (k < 4)) && old[lh_0](loc(block_of(va), k).d_int)) ==> loc(block_of(va), k).d_int
    invariant forall k: Int :: { loc(block_of(va), k) } (((0 <= k) && (k < 4)) && loc(block_of(va), k).d_int) ==> (((-2147483648) <= loc(block_of(va), k).v_int) && (loc(block_of(va), k).v_int <= 2147483647))
    invariant forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).v_int)
    invariant forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).d_int)
    invariant forall k: Int :: { loc(block_of(vb), k) } (((0 <= k) && (k < 4)) && old[lh_0](loc(block_of(vb), k).d_int)) ==> loc(block_of(vb), k).d_int
    invariant forall k: Int :: { loc(block_of(vb), k) } (((0 <= k) && (k < 4)) && loc(block_of(vb), k).d_int) ==> (((-2147483648) <= loc(block_of(vb), k).v_int) && (loc(block_of(vb), k).v_int <= 2147483647))
    invariant forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> (loc(block_of(vb), k).v_int == old[lh_0](loc(block_of(vb), k).v_int))
    invariant acc(loc(member(v_w, 2), 0).v_int, kv_n) && acc(loc(member(v_w, 2), 0).d_int, kd_n)
    invariant ((kd_n > none) && ds_n) ==> loc(member(v_w, 2), 0).d_int
    invariant (((kv_n > none) && (kd_n > none)) && loc(member(v_w, 2), 0).d_int) ==> (((-2147483648) <= loc(member(v_w, 2), 0).v_int) && (loc(member(v_w, 2), 0).v_int <= 2147483647))
    invariant ((none < kv_n) && (kv_n < write)) ==> (loc(member(v_w, 2), 0).v_int == vs_n)
    invariant (0 <= v_i) && (v_i <= 4)
  {
    assert !((offset_of(va) + v_i < 0) || (len(block_of(va)) <= offset_of(va) + v_i)) //BOUND
    assert !((perm(loc(block_of(va), offset_of(va) + v_i).v_int) != write) || (perm(loc(block_of(va), offset_of(va) + v_i).d_int) != write)) //WPERM
    loc(block_of(va), offset_of(va) + v_i).v_int := v_i
    loc(block_of(va), offset_of(va) + v_i).d_int := true
    v_i := v_i + 1
    assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).v_int) //MARKED
    assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).d_int) //MARKED
    assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).v_int) //MARKED
    assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).d_int) //MARKED
    assert !(perm(lvloc(block_of(v_w)).lv) < kl_0) //LIVE
  }
  v_i := 0
  v_sum := 0
  assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).d_int) //MARKED
  assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).d_int) //MARKED
  kl_1 := perm(lvloc(block_of(v_w)).lv)
  kv_n := perm(loc(member(v_w, 2), 0).v_int)
  kd_n := perm(loc(member(v_w, 2), 0).d_int)
  ds_n := false
  if (kd_n > none) { ds_n := loc(member(v_w, 2), 0).d_int }
  vs_n := perm(loc(member(v_w, 2), 0).v_int) > none ? loc(member(v_w, 2), 0).v_int : 0
  label lh_1
  while ((v_i < 4))
    invariant acc(lvloc(block_of(v_w)).lv, kl_1)
    invariant forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).v_int)
    invariant forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).d_int)
    invariant forall k: Int :: { loc(block_of(va), k) } (((0 <= k) && (k < 4)) && old[lh_1](loc(block_of(va), k).d_int)) ==> loc(block_of(va), k).d_int
    invariant forall k: Int :: { loc(block_of(va), k) } (((0 <= k) && (k < 4)) && loc(block_of(va), k).d_int) ==> (((-2147483648) <= loc(block_of(va), k).v_int) && (loc(block_of(va), k).v_int <= 2147483647))
    invariant forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> (loc(block_of(va), k).v_int == old[lh_1](loc(block_of(va), k).v_int))
    invariant forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).v_int)
    invariant forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).d_int)
    invariant forall k: Int :: { loc(block_of(vb), k) } (((0 <= k) && (k < 4)) && old[lh_1](loc(block_of(vb), k).d_int)) ==> loc(block_of(vb), k).d_int
    invariant forall k: Int :: { loc(block_of(vb), k) } (((0 <= k) && (k < 4)) && loc(block_of(vb), k).d_int) ==> (((-2147483648) <= loc(block_of(vb), k).v_int) && (loc(block_of(vb), k).v_int <= 2147483647))
    invariant forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> (loc(block_of(vb), k).v_int == old[lh_1](loc(block_of(vb), k).v_int))
    invariant acc(loc(member(v_w, 2), 0).v_int, kv_n) && acc(loc(member(v_w, 2), 0).d_int, kd_n)
    invariant ((kd_n > none) && ds_n) ==> loc(member(v_w, 2), 0).d_int
    invariant (((kv_n > none) && (kd_n > none)) && loc(member(v_w, 2), 0).d_int) ==> (((-2147483648) <= loc(member(v_w, 2), 0).v_int) && (loc(member(v_w, 2), 0).v_int <= 2147483647))
    invariant ((none < kv_n) && (kv_n < write)) ==> (loc(member(v_w, 2), 0).v_int == vs_n)
    invariant (0 <= v_i) && (v_i <= 4)
    invariant 0 <= v_sum
    invariant v_sum <= 4 * v_i
  {
    assert !((offset_of(vb) + v_i < 0) || (len(block_of(vb)) <= offset_of(vb) + v_i)) //BOUND
    assert perm(loc(block_of(vb), offset_of(vb) + v_i).v_int) > none //PERM
    assert loc(block_of(vb), offset_of(vb) + v_i).d_int //INIT
    assert !(((v_sum + loc(block_of(vb), offset_of(vb) + v_i).v_int) < (-2147483648)) || (2147483647 < (v_sum + loc(block_of(vb), offset_of(vb) + v_i).v_int)))
    v_sum := v_sum + loc(block_of(vb), offset_of(vb) + v_i).v_int
    v_i := v_i + 1
    assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).v_int) //MARKED
    assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).d_int) //MARKED
    assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).v_int) //MARKED
    assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).d_int) //MARKED
    assert !(perm(lvloc(block_of(v_w)).lv) < kl_1) //LIVE
  }
  assert v_sum <= 16
  assert !((perm(loc(member(v_w, 2), 0).v_int) != write) || (perm(loc(member(v_w, 2), 0).d_int) != write))
  assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(va), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(va), k).d_int) //MARKED
  assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(vb), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(vb), k).d_int) //MARKED
