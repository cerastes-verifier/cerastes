  assert !((perm(loc(block_of(vb), offset_of(vb) + 1).v_int) != write) || (perm(loc(block_of(vb), offset_of(vb) + 1).d_int) != write)) //WPERM
  loc(block_of(vb), offset_of(vb) + 1).v_int := 2
  loc(block_of(vb), offset_of(vb) + 1).d_int := true
  assert !((offset_of(va) + 2 < 0) || (len(block_of(va)) <= offset_of(va) + 2)) //BOUND
  assert !((perm(loc(block_of(va), offset_of(va) + 2).v_int) != write) || (perm(loc(block_of(va), offset_of(va) + 2).d_int) != write)) //WPERM
  loc(block_of(va), offset_of(va) + 2).v_int := 0
