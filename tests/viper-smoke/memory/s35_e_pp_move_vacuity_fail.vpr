// S35 (e) vacuity of s35_e_pp_move.vpr: `assert false` at the end of each method must FAIL (record 0045 item 7)
// Hand-written in the emitted style (see the positive fixture).
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// the contract atoms, as macros over the emitted shapes (record 0037 items 6-7, 0040 item 2): WF; an int range; a cell owned (root, full permission, flag set, range or WF of the pointer, the liveness amount); live
define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define RNGV(v) ((-2147483648) <= v && v <= 2147483647)
define ROOT(p) (p != null && WF(p) && offset_of(p) < len(block_of(p)))
define LVF(p, a) acc(lvloc(block_of(p)).lv, a)
define CI(c) (acc(c.v_int) && acc(c.d_int) && c.d_int && RNGV(c.v_int))
define CP(c) (acc(c.v_ptr_int) && acc(c.d_ptr_int) && c.d_ptr_int && WF(c.v_ptr_int))
define OWNI(p, a) (ROOT(p) && CI(p) && LVF(p, a))
define OWNP(p, a) (ROOT(p) && CP(p) && LVF(p, a))
define LIVE(p, a) (p != null && WF(p) && LVF(p, a))

// cerastes:trusted-contract allocation of an address-taken local of type int: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_int() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(r.v_int) && acc(r.d_int) && !r.d_int && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of an address-taken local of type int*: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_ptr_int() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(r.v_ptr_int) && acc(r.d_ptr_int) && !r.d_ptr_int && acc(lvloc(block_of(r)).lv)
  decreases _

// void move(int **pp, int *q) requires(owns(*pp) && owns(**pp) && owns(*q)) ensures(owns(*pp) && *pp == q && owns(**pp) && **pp == old(*q)) { *pp = q; }
// the ensures atom on **pp is the object on return (q): its liveness amount is the amount of the requires atom of its kind whose entry place is that object (decision 108): ite(post == old(*pp), a1, ite(post == q, a2, a1))
method f_move__0(p_pp: Ref, p_q: Ref, a0: Perm, a1: Perm, a2: Perm)
  requires (none < a0) && (a0 < write)
  requires (none < a1) && (a1 < write)
  requires (none < a2) && (a2 < write)
  requires WF(p_pp) && WF(p_q)
  requires OWNP(p_pp, a0) && OWNI(p_pp.v_ptr_int, a1) && OWNI(p_q, a2)
  ensures OWNP(p_pp, a0) && p_pp.v_ptr_int == p_q && OWNI(p_pp.v_ptr_int, (p_pp.v_ptr_int == old(p_pp.v_ptr_int) ? a1 : (p_pp.v_ptr_int == p_q ? a2 : a1))) && p_pp.v_ptr_int.v_int == old(p_q.v_int)
  decreases
{
  var eb_1: Ref
  eb_1 := p_pp.v_ptr_int
  if (lvloc(block_of(p_pp)) == lvloc(block_of(eb_1))) { }
  if (lvloc(block_of(p_pp)) == lvloc(block_of(p_q))) { }
  if (lvloc(block_of(eb_1)) == lvloc(block_of(p_q))) { }
  assert p_q != eb_1
  // *pp = q (no load: the pointer cell is stored to)
  assert p_pp != null
  assert !((perm(p_pp.v_ptr_int) != write) || (perm(p_pp.d_ptr_int) != write))
  p_pp.v_ptr_int := p_q
  p_pp.d_ptr_int := true
  // return rows: pass 0, then the per-atom rows in clause order with the liveness sums inside (the amount of **pp is the three-way ite)
  assert perm(p_pp.v_ptr_int) > none
  assert p_pp != null
  assert WF(p_pp)
  assert offset_of(p_pp) < len(block_of(p_pp))
  assert perm(p_pp.v_ptr_int) == write
  assert perm(p_pp.d_ptr_int) == write
  assert p_pp.d_ptr_int
  assert WF(p_pp.v_ptr_int)
  assert perm(lvloc(block_of(p_pp)).lv) >= (a0 + ((lvloc(block_of(p_pp)) == lvloc(block_of(p_pp.v_ptr_int))) ? (p_pp.v_ptr_int == old(p_pp.v_ptr_int) ? a1 : (p_pp.v_ptr_int == p_q ? a2 : a1)) : none))
  assert p_pp.v_ptr_int == p_q
  assert p_pp.v_ptr_int != null
  assert WF(p_pp.v_ptr_int)
  assert offset_of(p_pp.v_ptr_int) < len(block_of(p_pp.v_ptr_int))
  assert perm(p_pp.v_ptr_int.v_int) == write
  assert perm(p_pp.v_ptr_int.d_int) == write
  assert p_pp.v_ptr_int.d_int
  assert RNGV(p_pp.v_ptr_int.v_int)
  assert perm(lvloc(block_of(p_pp.v_ptr_int)).lv) >= ((p_pp.v_ptr_int == old(p_pp.v_ptr_int) ? a1 : (p_pp.v_ptr_int == p_q ? a2 : a1)) + ((lvloc(block_of(p_pp.v_ptr_int)) == lvloc(block_of(p_pp))) ? a0 : none))
  assert p_pp.v_ptr_int.v_int == old(p_q.v_int)
  assert false // <- vacuity
}

