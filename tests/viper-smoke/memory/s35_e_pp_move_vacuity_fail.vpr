  ensures OWNP(p_a, a0) && OWNP(p_b, a1) && p_a.v_ptr_int == old(p_b.v_ptr_int) && p_b.v_ptr_int == old(p_a.v_ptr_int) && OWNI(p_a.v_ptr_int, (p_a.v_ptr_int == old(p_a.v_ptr_int) ? a2 : (p_a.v_ptr_int == old(p_b.v_ptr_int) ? a3 : a2))) && OWNI(p_b.v_ptr_int, (p_b.v_ptr_int == old(p_b.v_ptr_int) ? a3 : (p_b.v_ptr_int == old(p_a.v_ptr_int) ? a2 : a3))) && p_a.v_ptr_int.v_int == old(p_b.v_ptr_int.v_int) && p_b.v_ptr_int.v_int == old(p_a.v_ptr_int.v_int)
