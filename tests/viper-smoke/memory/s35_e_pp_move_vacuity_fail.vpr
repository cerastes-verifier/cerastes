  assert perm(lvloc(block_of(v_q.v_ptr_int)).lv) >= ((perm(lvloc(block_of(v_q.v_ptr_int)).lv) / 5) + ((lvloc(block_of(v_q.v_ptr_int)) == lvloc(block_of(v_p))) ? (perm(lvloc(block_of(v_p)).lv) / 5) : none) + ((lvloc(block_of(v_q.v_ptr_int)) == lvloc(block_of(v_q))) ? (perm(lvloc(block_of(v_q)).lv) / 5) : none) + ((lvloc(block_of(v_q.v_ptr_int)) == lvloc(block_of(v_p.v_ptr_int))) ? (perm(lvloc(block_of(v_p.v_ptr_int)).lv) / 5) : none))
  f_swap_targets__2(v_p, v_q, perm(lvloc(block_of(v_p)).lv) / 5, perm(lvloc(block_of(v_q)).lv) / 5, perm(lvloc(block_of(v_p.v_ptr_int)).lv) / 5, perm(lvloc(block_of(v_q.v_ptr_int)).lv) / 5)
