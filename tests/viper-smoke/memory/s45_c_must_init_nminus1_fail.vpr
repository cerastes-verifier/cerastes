    invariant forall k: Int :: { loc(block_of(p), k) } (((offset_of(p) <= k) && (k < offset_of(p) + n)) && loc(block_of(p), k).d_int) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647))
    invariant acc(lvloc(block_of(p)).lv, kl_p)
    invariant forall q0: Int :: { loc(block_of(p), q0) } (-2147483648 <= (q0 - offset_of(p)) && (q0 - offset_of(p)) <= 2147483647) && (0 <= (q0 - offset_of(p)) && (q0 - offset_of(p)) < i) ==> loc(block_of(p), q0).d_int //FLAG
    invariant forall q0: Int :: { loc(block_of(p), q0) } (-2147483648 <= (q0 - offset_of(p)) && (q0 - offset_of(p)) <= 2147483647) ==> (!(0 <= (q0 - offset_of(p)) && (q0 - offset_of(p)) < i) || ((((block_of(loc(block_of(p), q0)) == block_of(p)) && (offset_of(p) <= offset_of(loc(block_of(p), q0))) && (offset_of(loc(block_of(p), q0)) < offset_of(p) + n)) ? loc(block_of(p), q0).v_int : 0) == 0))
