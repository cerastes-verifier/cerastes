// expect: verified
// S45 (r): the pin of question 238 (keep_slot called twice on &p[1], then peek(p, n)) with the amount taken from a minimum over the range: mv and md are the minimum permission over the range per field (inhale of the lower-bound quantifier and of a witness slot, under n > 0), and the amount is min(mv, md, the liveness cell, the function's own amount) / 2. The original program fails at the marked row of the call (tests/memory/negative/range_call_reads_unequal_pin.c, the frozen build's Viper); this one verifies.
// S45 (r) (recorded, for M4.5e1f; nothing is built from it): the program is the frozen build's kept Viper of tests/memory/negative/range_call_reads_unequal_pin.c (c23), with the minimum amount of the call to peek taken over the range instead of from its first slot. Hand-modified, not lint-checked; the two `inhale` lines carry the tag `// cerastes:inhale-ok` as record invariant 4 would require.
// cerastes: Viper emitted from VIR (internal/encoding.md); do not edit

// the memory model (decision 0032 item 5, decision 0028 item 2): one value field and one flag field per cell type, the liveness cell
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

