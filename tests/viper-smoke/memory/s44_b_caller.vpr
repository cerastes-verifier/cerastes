  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> acc(loc(block_of(ra1), k).d_int) //MARKED
  assert !((ra1 == null) || !((ra1 == loc(block_of(ra1), offset_of(ra1))) && (0 <= offset_of(ra1)) && (offset_of(ra1) <= len(block_of(ra1)))) || (4 < 0) || (len(block_of(ra1)) < offset_of(ra1) + 4)) //SHAPE
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> loc(block_of(ra1), k).d_int //FLAGS
