// expect: verified
// S43 (c): a nested loop over int a[3] (no initializer). The outer loop writes a[i] and an inner loop only reads it (a[i] again, each time round): record 0042 item 5's case. The inner loop keeps the values, the flags and the type's range (every array the loop holds, reached or not), so the outer loop's own flag and range rows survive the inner loop. Verifies.
// S43 hand-written fixture of the target shapes of record 0059 (draft; plan .claude/plans/m4-5e1-arrays.md 3.5), written from the emitted shapes in build/m4.5e1a/baseline/vpr. No inhale or assume.
// (hand-written spike fixture, not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it)
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field tok: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// cerastes:trusted-contract allocation of an address-taken local of type int: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_int() returns (r: Ref)
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == 1)
  ensures ((((lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(r.v_int)) && acc(r.d_int)) && (!r.d_int)) && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of an automatic array of int with n elements (n >= 1): a fresh block of n slots, every element uninitialized, the block's liveness token; full permission to both fields of every slot in [0, n), each its own quantifier over the absolute slot (record 0059 item 3, draft)
method alloc_arr_int(n: Int) returns (r: Ref)
  requires 1 <= n
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> (!loc(block_of(r), k).d_int)
  decreases _

// cerastes:trusted-contract the static-object part of an array initializer: it takes and returns the same permissions and ensures every element zero and initialized (record 0059 item 3, draft)
method zero_arr_int(r: Ref, n: Int)
  requires (1 <= n) && (r == loc(block_of(r), 0)) && (len(block_of(r)) == n)
  requires forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  requires forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> (loc(block_of(r), k).v_int == 0)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> loc(block_of(r), k).d_int
  decreases _


method nested_loops()
{
  var v_a: Ref
  var v_i: Int
  var v_j: Int
  var v_s: Int
  var kl_a: Perm
  var kl_b: Perm
  v_a := alloc_arr_int(3)
  v_i := 0
  v_s := 0
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
  kl_a := perm(lvloc(block_of(v_a)).lv)
  label lh_0
  while (v_i < 3)
    invariant (0 <= v_i) && (v_i <= 3)
    invariant acc(lvloc(block_of(v_a)).lv, kl_a)
    invariant forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_int)
    invariant forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_int)
    invariant forall k: Int :: { loc(block_of(v_a), k) } (((0 <= k) && (k < 3)) && old[lh_0](loc(block_of(v_a), k).d_int)) ==> loc(block_of(v_a), k).d_int
    invariant forall k: Int :: { loc(block_of(v_a), k) } (((0 <= k) && (k < 3)) && loc(block_of(v_a), k).d_int) ==> (((-2147483648) <= loc(block_of(v_a), k).v_int) && (loc(block_of(v_a), k).v_int <= 2147483647))
  {
    assert !((offset_of(v_a) + v_i < 0) || (len(block_of(v_a)) <= offset_of(v_a) + v_i)) //BOUND
    assert !((perm(loc(block_of(v_a), offset_of(v_a) + v_i).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + v_i).d_int) != write)) //WPERM
    loc(block_of(v_a), offset_of(v_a) + v_i).v_int := v_i
    loc(block_of(v_a), offset_of(v_a) + v_i).d_int := true
    v_j := 0
    assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
    assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
    kl_b := perm(lvloc(block_of(v_a)).lv)
    label lh_1
    while (v_j < 3)
      invariant (0 <= v_j) && (v_j <= 3)
      invariant acc(lvloc(block_of(v_a)).lv, kl_b)
      invariant forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_int)
      invariant forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_int)
      invariant forall k: Int :: { loc(block_of(v_a), k) } (((0 <= k) && (k < 3)) && old[lh_1](loc(block_of(v_a), k).d_int)) ==> loc(block_of(v_a), k).d_int
      invariant forall k: Int :: { loc(block_of(v_a), k) } (((0 <= k) && (k < 3)) && loc(block_of(v_a), k).d_int) ==> (((-2147483648) <= loc(block_of(v_a), k).v_int) && (loc(block_of(v_a), k).v_int <= 2147483647))
      invariant forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> (loc(block_of(v_a), k).v_int == old[lh_1](loc(block_of(v_a), k).v_int))
    {
      assert !((offset_of(v_a) + v_i < 0) || (len(block_of(v_a)) <= offset_of(v_a) + v_i)) //BOUND
      assert perm(loc(block_of(v_a), offset_of(v_a) + v_i).v_int) > none //PERM
      assert loc(block_of(v_a), offset_of(v_a) + v_i).d_int //INIT
      v_s := v_s + loc(block_of(v_a), offset_of(v_a) + v_i).v_int
      v_j := v_j + 1
      assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
      assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
    }
    v_i := v_i + 1
    assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
    assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
  }
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
  assert !(perm(lvloc(block_of(v_a)).lv) != write) //LIVE
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_int)
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_int)
  exhale acc(lvloc(block_of(v_a)).lv)
}
