  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 2), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 2), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 2), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 2), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 2), 0) } (((0 <= k) && (k < n))) ==> (!loc(member(loc(block_of(r), k), 2), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 3), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 3), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 3), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 3), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 3), 0) } (((0 <= k) && (k < n))) ==> (!loc(member(loc(block_of(r), k), 3), 0).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _
