// expect: verified
// S35 (a) pp_contract: `owns(*pp) && owns(**pp)` in requires and ensures with `**pp == old(**pp) + 1` over a `T**` parameter (the receiver of the inner atom is the plain load `p_pp.v_ptr_int`) (record 0045 item 3, 4)
// Hand-written in the emitted style: explicit atomic asserts before every access, call and return (0028 item 11), ghost Perm amounts (0037 item 6), the four axioms with their tags; the allocation methods are the trusted ones (record 0032 item 4).
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// the contract atoms, as macros over the emitted shapes (record 0037 items 6-7, 0040 item 2): WF; an int range; a cell owned (root, full permission, flag set, range or WF of the pointer, the liveness amount); live
define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define RNGV(v) ((-2147483648) <= v && v <= 2147483647)
define ROOT(p) (p != null && WF(p) && offset_of(p) < len(block_of(p)))
define LVF(p, a) acc(lvloc(block_of(p)).lv, a)
define CI(c) (acc(c.v_int) && acc(c.d_int) && c.d_int && RNGV(c.v_int))
define CP(c) (acc(c.v_ptr_int) && acc(c.d_ptr_int) && c.d_ptr_int && WF(c.v_ptr_int))
define OWNI(p, a) (ROOT(p) && CI(p) && LVF(p, a))
define OWNP(p, a) (ROOT(p) && CP(p) && LVF(p, a))
define LIVE(p, a) (p != null && WF(p) && LVF(p, a))

// cerastes:trusted-contract allocation of an address-taken local of type int: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_int() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(r.v_int) && acc(r.d_int) && !r.d_int && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of an address-taken local of type int*: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_ptr_int() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(r.v_ptr_int) && acc(r.d_ptr_int) && !r.d_ptr_int && acc(lvloc(block_of(r)).lv)
  decreases _

// void inc2(int **pp) requires(owns(*pp) && owns(**pp) && **pp < 100) ensures(owns(*pp) && owns(**pp) && **pp == old(**pp) + 1) { **pp += 1; }
// the atom on **pp reads *pp: chain-guarded plain (owns(*pp) is unconditional, so the load is framed on every path); in the ensures the place is the object on return (decision 104), old(...) the entry value of the entry object
method f_inc2__0(p_pp: Ref, a0: Perm, a1: Perm)
  requires (none < a0) && (a0 < write)
  requires (none < a1) && (a1 < write)
  requires WF(p_pp)
  requires OWNP(p_pp, a0) && OWNI(p_pp.v_ptr_int, a1) && p_pp.v_ptr_int.v_int < 100
  ensures OWNP(p_pp, a0) && OWNI(p_pp.v_ptr_int, a1) && p_pp.v_ptr_int.v_int == old(p_pp.v_ptr_int.v_int) + 1
  decreases
{
  var eb_1: Ref
  var t0: Ref
  // entry (item 6): the entry snapshot of the load-rooted place, from the requires-framed chain
  eb_1 := p_pp.v_ptr_int
  if (lvloc(block_of(p_pp)) == lvloc(block_of(eb_1))) { }
  // **pp += 1: the load *pp (a contract-style read: cell held, flag set), then the read and the store through it
  assert p_pp != null
  assert perm(p_pp.v_ptr_int) > none
  assert p_pp.d_ptr_int
  t0 := p_pp.v_ptr_int
  assert t0 != null
  assert perm(t0.v_int) > none
  assert t0.d_int
  assert !((t0.v_int + 1 < (-2147483648)) || (2147483647 < t0.v_int + 1))
  assert !((perm(t0.v_int) != write) || (perm(t0.d_int) != write))
  t0.v_int := t0.v_int + 1
  t0.d_int := true
  // return rows (item 6): pass 0 (the cell that frames the base of the load-rooted ensures place is still held), then the per-atom rows in clause order with the liveness sums inside, then the user's ensures
  assert perm(p_pp.v_ptr_int) > none
  assert p_pp != null
  assert WF(p_pp)
  assert offset_of(p_pp) < len(block_of(p_pp))
  assert perm(p_pp.v_ptr_int) == write
  assert perm(p_pp.d_ptr_int) == write
  assert p_pp.d_ptr_int
  assert WF(p_pp.v_ptr_int)
  assert perm(lvloc(block_of(p_pp)).lv) >= (a0 + ((lvloc(block_of(p_pp)) == lvloc(block_of(p_pp.v_ptr_int))) ? a1 : none))
  assert p_pp.v_ptr_int != null
  assert WF(p_pp.v_ptr_int)
  assert offset_of(p_pp.v_ptr_int) < len(block_of(p_pp.v_ptr_int))
  assert perm(p_pp.v_ptr_int.v_int) == write
  assert perm(p_pp.v_ptr_int.d_int) == write
  assert p_pp.v_ptr_int.d_int
  assert RNGV(p_pp.v_ptr_int.v_int)
  assert perm(lvloc(block_of(p_pp.v_ptr_int)).lv) >= (a1 + ((lvloc(block_of(p_pp.v_ptr_int)) == lvloc(block_of(p_pp))) ? a0 : none))
  assert p_pp.v_ptr_int.v_int == old(p_pp.v_ptr_int.v_int) + 1
}

// well-formedness of the contract of inc2: ghost values for the loads (the value of *pp and of **pp in the entry and return states), WF as requires; the framing of *pp for owns(**pp) holds on every path (the atom before it is unconditional)
method f_inc2__0__wf(p_pp: Ref, a0: Perm, a1: Perm, hv_0_pre: Ref, hv_1_pre: Int, hv_0_post: Ref, hv_1_post: Int)
  requires (none < a0) && (a0 < write)
  requires (none < a1) && (a1 < write)
  requires WF(p_pp)
  requires WF(hv_0_pre) && WF(hv_0_post)
  requires RNGV(hv_1_pre) && RNGV(hv_1_post)
  decreases
{
  assert (hv_1_pre < 100) ==> (!((hv_1_pre + 1 < (-2147483648)) || (2147483647 < hv_1_pre + 1)))
}
