// expect: error assert:assertion.false @ L80
// expect: error assert:assertion.false @ L91
// expect: error assert:assertion.false @ L99
// expect: error postcondition:assertion.false @ L104
// S24 candidate FINAL: struct_fail
// Final design: a pointer is a Ref; Block domain with four axioms (loc_inv, loc_nonnull, member_inv, member_lv); ghost init flag per cell; liveness token lvloc(b) at slot -2; explicit checks at every access, call, return and pointer use. Structs and arrays: every member and inner array is a block (member(r, k)).
//
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field tok: Bool
field lv: Bool

domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define OWN(p) (offset_of(p) < len(block_of(p)) && acc(p.v_int) && acc(p.d_int))
define INIT(p) (OWN(p) && p.d_int)
define UNINIT(p) (OWN(p) && !p.d_int)
define LVQ(p) lvloc(block_of(p))
define LV(p, l) (acc(lvloc(block_of(p)).lv, l))
define BLK(p) (offset_of(p) == 0 && acc(loc(block_of(p), -1).tok) && loc(block_of(p), -1).tok && lvloc(block_of(p)) == loc(block_of(p), -2) && acc(lvloc(block_of(p)).lv) && (forall i: Int :: { loc(block_of(p), i) } 0 <= i && i < len(block_of(p)) ==> acc(loc(block_of(p), i).v_int) && acc(loc(block_of(p), i).d_int)))
define RDP(p, r) (offset_of(p) < len(block_of(p)) && acc(p.v_int, r) && acc(p.d_int, r) && p.d_int)

// cerastes:trusted-contract allocation of an address-taken local of type int: the cell and the block's liveness token (lvloc(b) == loc(b, -2)), full permission
method alloc_int() returns (r: Ref)
  ensures r != null && WF(r) && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures UNINIT(r) && lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)

define CELLOWN(c) (offset_of(c) < len(block_of(c)) && acc(c.v_int) && acc(c.d_int) && c.d_int)
define CELLUN(c) (offset_of(c) < len(block_of(c)) && acc(c.v_int) && acc(c.d_int) && !c.d_int)
define MX(s) loc(member(s, 0), 0)
define MY(s) loc(member(s, 1), 0)
define SLEN(s) (len(member(s, 0)) == 1 && len(member(s, 1)) == 1)
define SINIT(s) (SLEN(s) && CELLOWN(MX(s)) && CELLOWN(MY(s)))
define SUNINIT(s) (SLEN(s) && CELLUN(MX(s)) && CELLUN(MY(s)))

// cerastes:trusted-contract allocation of an address-taken local struct S { int x; int y; } (a one-slot block; its members are blocks of their own; the liveness token is the root block's)
method alloc_S() returns (r: Ref)
  ensures r != null && WF(r) && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures SUNINIT(r) && lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)

method bump_x(p: Ref, l_p: Perm)
  requires none < l_p && l_p < write && WF(p) && p != null && offset_of(p) < len(block_of(p)) && SINIT(p) && LV(p, l_p)
  ensures SINIT(p) && LV(p, l_p) && MX(p).v_int == old(MX(p).v_int) + 1 && MY(p).v_int == old(MY(p).v_int)
{
  assert perm(MX(p).v_int) > none && perm(MX(p).d_int) > none && MX(p).d_int
  assert perm(MX(p).v_int) == write && perm(MX(p).d_int) == write
  MX(p).v_int := MX(p).v_int + 1
  MX(p).d_int := true
  assert perm(MX(p).v_int) == write && perm(MX(p).d_int) == write
  assert MX(p).d_int
  assert perm(MY(p).v_int) == write && perm(MY(p).d_int) == write
  assert MY(p).d_int
  assert perm(lvloc(block_of(p)).lv) >= l_p
}

method deref_one_past_x(p: Ref, l_p: Perm) returns (v: Int)   // *(&s.x + 1)
  requires none < l_p && l_p < write && WF(p) && p != null && offset_of(p) < len(block_of(p)) && SINIT(p) && LV(p, l_p)
{
  v := 0
  var q: Ref := loc(member(p, 0), 0)
  assert q != null ==> perm(lvloc(block_of(q)).lv) > none // lifetime
  assert 0 <= offset_of(q) + 1 && offset_of(q) + 1 <= len(block_of(q))
  var e: Ref := loc(block_of(q), offset_of(q) + 1)
  assert offset_of(e) < len(block_of(e)) // x's block ends here: y is another block
  assert perm(e.v_int) > none
}

method compare_one_past_x_with_y(p: Ref, l_p: Perm) returns (b: Bool)   // &s.x + 1 == &s.y may be true in C: not decided
  requires none < l_p && l_p < write && WF(p) && p != null && offset_of(p) < len(block_of(p)) && SINIT(p) && LV(p, l_p)
{
  var e: Ref := loc(member(p, 0), 1)
  var y: Ref := loc(member(p, 1), 0)
  assert e != null ==> perm(lvloc(block_of(e)).lv) > none // lifetime
  assert y != null ==> perm(lvloc(block_of(y)).lv) > none // lifetime
  assert e == null || y == null || block_of(e) == block_of(y) || (offset_of(e) < len(block_of(e)) && offset_of(y) < len(block_of(y)))
  b := e == y
}

method owns_only_x(p: Ref, l_p: Perm) returns (v: Int)
  requires none < l_p && l_p < write && WF(p) && p != null && offset_of(p) < len(block_of(p)) && len(member(p, 0)) == 1 && len(member(p, 1)) == 1 && CELLOWN(MX(p)) && LV(p, l_p)
{
  v := 0
  assert perm(MY(p).v_int) > none // y is not owned: p->y read
}

method bump_x_wrong(p: Ref, l_p: Perm)
  requires none < l_p && l_p < write && WF(p) && p != null && offset_of(p) < len(block_of(p)) && SINIT(p) && LV(p, l_p)
  ensures SINIT(p) && LV(p, l_p) && MX(p).v_int == old(MX(p).v_int) + 1 && MY(p).v_int == old(MY(p).v_int)
{
  assert perm(MX(p).v_int) == write && perm(MX(p).d_int) == write && perm(MY(p).v_int) == write && perm(MY(p).d_int) == write
  MX(p).v_int := MX(p).v_int + 1
  MY(p).v_int := MY(p).v_int + 1 // also changes y
  assert perm(MX(p).v_int) == write && perm(MX(p).d_int) == write
  assert MX(p).d_int
  assert perm(MY(p).v_int) == write && perm(MY(p).d_int) == write
  assert MY(p).d_int
  assert perm(lvloc(block_of(p)).lv) >= l_p
}
