  assert perm(v_p.v_ptr_int.v_int) == write
  assert perm(v_p.v_ptr_int.d_int) == write
  assert v_p.v_ptr_int.d_int
  assert RNGV(v_p.v_ptr_int.v_int)
  assert v_x != v_p.v_ptr_int // <- fails
