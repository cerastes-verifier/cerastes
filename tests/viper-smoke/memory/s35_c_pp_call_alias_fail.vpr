  assert perm(lvloc(block_of(v_p.v_ptr_int)).lv) >= ((perm(lvloc(block_of(v_p.v_ptr_int)).lv) / 4) + ((lvloc(block_of(v_p.v_ptr_int)) == lvloc(block_of(v_x))) ? (perm(lvloc(block_of(v_x)).lv) / 4) : none) + ((lvloc(block_of(v_p.v_ptr_int)) == lvloc(block_of(v_p))) ? (perm(lvloc(block_of(v_p)).lv) / 4) : none))
  f_two__0(v_p, v_x, perm(lvloc(block_of(v_x)).lv) / 4, perm(lvloc(block_of(v_p)).lv) / 4, perm(lvloc(block_of(v_p.v_ptr_int)).lv) / 4)
