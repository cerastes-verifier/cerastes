  assert (perm(lvloc(block_of(v_p)).lv) / 4) < write
  assert none < (perm(lvloc(block_of(v_p.v_ptr_int)).lv) / 4)
  assert (perm(lvloc(block_of(v_p.v_ptr_int)).lv) / 4) < write
  assert perm(lvloc(block_of(v_x)).lv) >= ((perm(lvloc(block_of(v_x)).lv) / 4) + ((lvloc(block_of(v_x)) == lvloc(block_of(v_p))) ? (perm(lvloc(block_of(v_p)).lv) / 4) : none) + ((lvloc(block_of(v_x)) == lvloc(block_of(v_p.v_ptr_int))) ? (perm(lvloc(block_of(v_p.v_ptr_int)).lv) / 4) : none))
