// expect: verified
// S48 after audit round 1: record 0064 item 6, zero_arr for an array of rows (audit round 1 issue 6 (b)), over TWO bound variables, with alloc_arr_row_int_3(n) in the n form (the method takes n; this caller passes 2): int m[2][3] = {{1}, {4}}: zero_arr_row_int_3 takes and returns the two quantified permissions per cell and ensures every cell zero and initialized; m[0][0] and m[1][0] written, m[1][2] reads zero, m[ci][cj] for symbolic ci, cj is one of 0, 1, 4.
// (hand-written spike fixture of record 0064 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// cerastes:trusted-contract allocation of a local array of n rows of int[3] (record 0064 item 6; the name spells the row's cell type and bound, audit round 1 issue 7): per element the row's length fact, over two bound variables the permissions of each cell (one quantifier each, the receiver as trigger), every flag false
method alloc_arr_row_int_3(n: Int) returns (r: Ref)
  requires 1 <= n
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  ensures forall i: Int :: { loc(block_of(r), i) } ((0 <= i) && (i < n)) ==> (len(member(loc(block_of(r), i), 0)) == 3)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(r), i), 0), j).v_int)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(r), i), 0), j).d_int)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> (!loc(member(loc(block_of(r), i), 0), j).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _
// cerastes:trusted-contract the static-object part of an initializer of an array of int[3] rows: it takes and returns the same permissions over two bound variables and ensures every cell zero and initialized; it states no length facts
method zero_arr_row_int_3(r: Ref, n: Int)
  requires ((1 <= n) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  requires forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(r), i), 0), j).v_int)
  requires forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(r), i), 0), j).d_int)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(r), i), 0), j).v_int)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(r), i), 0), j).d_int)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> (loc(member(loc(block_of(r), i), 0), j).v_int == 0)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < n)) && ((0 <= j) && (j < 3))) ==> loc(member(loc(block_of(r), i), 0), j).d_int
  decreases _
method f_mat(ci: Int, cj: Int)
  requires (0 <= ci) && (ci < 2)
  requires (0 <= cj) && (cj < 3)
{
  var v_m: Ref
  var tin: Ref
  var tw: Ref
  var v_r: Int
  v_m := alloc_arr_row_int_3(2)
  zero_arr_row_int_3(v_m, 2)
  assert !((offset_of(v_m) + 0 < 0) || (len(block_of(v_m)) <= offset_of(v_m) + 0)) //BOUND1
  tin := loc(member(loc(block_of(v_m), offset_of(v_m) + 0), 0), 0)
  assert !((offset_of(tin) + 0 < 0) || (len(block_of(tin)) <= offset_of(tin) + 0)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 1
  tw.d_int := true
  assert !((offset_of(v_m) + 1 < 0) || (len(block_of(v_m)) <= offset_of(v_m) + 1)) //BOUND1
  tin := loc(member(loc(block_of(v_m), offset_of(v_m) + 1), 0), 0)
  assert !((offset_of(tin) + 0 < 0) || (len(block_of(tin)) <= offset_of(tin) + 0)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 4
  tw.d_int := true
  assert !((offset_of(v_m) + 1 < 0) || (len(block_of(v_m)) <= offset_of(v_m) + 1)) //BOUND1
  tin := loc(member(loc(block_of(v_m), offset_of(v_m) + 1), 0), 0)
  assert !((offset_of(tin) + 2 < 0) || (len(block_of(tin)) <= offset_of(tin) + 2)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 2)
  assert perm(tw.v_int) > none //PERM
  assert tw.d_int //INIT
  v_r := tw.v_int
  assert v_r == 0 //VALUE
  assert !((offset_of(v_m) + ci < 0) || (len(block_of(v_m)) <= offset_of(v_m) + ci)) //BOUND1
  tin := loc(member(loc(block_of(v_m), offset_of(v_m) + ci), 0), 0)
  assert !((offset_of(tin) + cj < 0) || (len(block_of(tin)) <= offset_of(tin) + cj)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + cj)
  assert perm(tw.v_int) > none //PERM
  assert tw.d_int //INIT
  v_r := tw.v_int
  assert (v_r == 0) || (v_r == 1) || (v_r == 4) //VALUE
  assert forall i: Int, j: Int :: { loc(member(loc(block_of(v_m), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(v_m), i), 0), j).v_int) //MARKED
  assert forall i: Int, j: Int :: { loc(member(loc(block_of(v_m), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(v_m), i), 0), j).d_int) //MARKED
  assert perm(lvloc(block_of(v_m)).lv) == write //LIVE
  exhale forall i: Int, j: Int :: { loc(member(loc(block_of(v_m), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(v_m), i), 0), j).v_int)
  exhale forall i: Int, j: Int :: { loc(member(loc(block_of(v_m), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(v_m), i), 0), j).d_int)
  exhale acc(lvloc(block_of(v_m)).lv)
}
