  requires (none < a1) && (a1 < write)
  requires WF(p_pp) && WF(hv_0_pre) && WF(hv_0_post) && RNGV(hv_1_pre) && RNGV(hv_1_post)
  decreases
{
  // the measure's load of *pp is framed by owns(*pp) on every path
  assert true ==> true
  assert false // <- vacuity
}
