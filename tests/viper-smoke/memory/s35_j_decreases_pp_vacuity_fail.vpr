  assert perm(p_pp.v_ptr_int) > none
  assert p_pp.d_ptr_int
  t0 := p_pp.v_ptr_int
  assert t0 != null
  assert perm(t0.v_int) > none
  assert t0.d_int
  t1 := t0.v_int
