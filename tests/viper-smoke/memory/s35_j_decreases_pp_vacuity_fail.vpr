    assert p_pp.v_ptr_int.v_int >= 0
    assert none < (perm(lvloc(block_of(p_pp)).lv) / 3)
    assert (perm(lvloc(block_of(p_pp)).lv) / 3) < write
    assert none < (perm(lvloc(block_of(p_pp.v_ptr_int)).lv) / 3)
    assert (perm(lvloc(block_of(p_pp.v_ptr_int)).lv) / 3) < write
    assert perm(lvloc(block_of(p_pp)).lv) >= ((perm(lvloc(block_of(p_pp)).lv) / 3) + ((lvloc(block_of(p_pp)) == lvloc(block_of(p_pp.v_ptr_int))) ? (perm(lvloc(block_of(p_pp.v_ptr_int)).lv) / 3) : none))
    assert perm(lvloc(block_of(p_pp.v_ptr_int)).lv) >= ((perm(lvloc(block_of(p_pp.v_ptr_int)).lv) / 3) + ((lvloc(block_of(p_pp.v_ptr_int)) == lvloc(block_of(p_pp))) ? (perm(lvloc(block_of(p_pp)).lv) / 3) : none))
    assert (p_pp.v_ptr_int.v_int < old(p_pp.v_ptr_int.v_int)) && (0 <= old(p_pp.v_ptr_int.v_int))
    f_countdown__0(p_pp, perm(lvloc(block_of(p_pp)).lv) / 3, perm(lvloc(block_of(p_pp.v_ptr_int)).lv) / 3)
