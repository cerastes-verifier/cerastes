  decreases p_pp.v_ptr_int.v_int
{
  var eb_1: Ref
  var t0: Ref
  var t1: Int
  eb_1 := p_pp.v_ptr_int
  if (lvloc(block_of(p_pp)) == lvloc(block_of(eb_1))) { }
