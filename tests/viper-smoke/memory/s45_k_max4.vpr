    }
    i := i + 1
    assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int)
    assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int)
    assert perm(lvloc(block_of(v_a)).lv) >= kl //LIVEBACK
    assert forall q0: Int :: { loc(block_of(v_a), q0) } (-2147483648 <= (q0 - offset_of(v_a)) && (q0 - offset_of(v_a)) <= 2147483647) && (0 <= (q0 - offset_of(v_a)) && (q0 - offset_of(v_a)) < i) ==> ((0 <= q0) && (q0 < 4)) //FRAME
  }
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  assert perm(loc(block_of(v_a), offset_of(v_a) + 2).v_int) > none && perm(loc(block_of(v_a), offset_of(v_a) + 2).d_int) > none && loc(block_of(v_a), offset_of(v_a) + 2).d_int
  assert loc(block_of(v_a), offset_of(v_a) + 2).v_int <= r
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
