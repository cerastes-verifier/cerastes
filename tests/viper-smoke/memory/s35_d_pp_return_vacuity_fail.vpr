// void gd(int **pp, int *q, int *r) requires(owns(*pp) && (*pp == NULL || owns(*q)) && owns(*r)) ensures(owns(*pp) && *pp == old(*pp) && (*pp == NULL || owns(*q)) && owns(*r)) { keep(pp); }
// no ensures PLACE loads, but the guard of owns(*q) reads *pp: the separation row of the int places q and r is guarded by it, so it reads *pp before any per-atom row: pass 0 asserts the cell the guard reads first
method f_gd__4(p_pp: Ref, p_q: Ref, p_r: Ref, a0: Perm, a1: Perm, a2: Perm)
  requires (none < a0) && (a0 < write)
  requires (none < a1) && (a1 < write)
  requires (none < a2) && (a2 < write)
  requires WF(p_pp) && WF(p_q) && WF(p_r)
  requires OWNP(p_pp, a0)
  requires (!(p_pp.v_ptr_int == null)) ==> OWNI(p_q, a1)
  requires OWNI(p_r, a2)
  ensures OWNP(p_pp, a0) && p_pp.v_ptr_int == old(p_pp.v_ptr_int)
  ensures (!(p_pp.v_ptr_int == null)) ==> OWNI(p_q, a1)
  ensures OWNI(p_r, a2)
  decreases
{
  if (lvloc(block_of(p_pp)) == lvloc(block_of(p_q))) { }
  if (lvloc(block_of(p_pp)) == lvloc(block_of(p_r))) { }
  if (lvloc(block_of(p_q)) == lvloc(block_of(p_r))) { }
  assert (!(p_pp.v_ptr_int == null)) ==> (p_q != p_r)
  assert p_pp != null
  assert WF(p_pp)
  assert offset_of(p_pp) < len(block_of(p_pp))
  assert perm(p_pp.v_ptr_int) == write
  assert perm(p_pp.d_ptr_int) == write
  assert p_pp.d_ptr_int
  assert WF(p_pp.v_ptr_int)
  assert none < (perm(lvloc(block_of(p_pp)).lv) / 2)
  assert (perm(lvloc(block_of(p_pp)).lv) / 2) < write
  assert perm(lvloc(block_of(p_pp)).lv) >= (perm(lvloc(block_of(p_pp)).lv) / 2)
  f_keep__0(p_pp, perm(lvloc(block_of(p_pp)).lv) / 2)
  // return rows: pass 0 (the guard's cell), the separation row, the per-atom rows
  assert perm(p_pp.v_ptr_int) > none
  assert (!(p_pp.v_ptr_int == null)) ==> (p_q != p_r)
  assert p_pp != null
  assert WF(p_pp)
  assert offset_of(p_pp) < len(block_of(p_pp))
  assert perm(p_pp.v_ptr_int) == write
  assert perm(p_pp.d_ptr_int) == write
  assert p_pp.d_ptr_int
  assert WF(p_pp.v_ptr_int)
  assert perm(lvloc(block_of(p_pp)).lv) >= (a0 + ((lvloc(block_of(p_pp)) == lvloc(block_of(p_q))) ? ((!(p_pp.v_ptr_int == null)) ? a1 : none) : none) + ((lvloc(block_of(p_pp)) == lvloc(block_of(p_r))) ? a2 : none))
  assert p_pp.v_ptr_int == old(p_pp.v_ptr_int)
  assert (!(p_pp.v_ptr_int == null)) ==> (p_q != null)
  assert (!(p_pp.v_ptr_int == null)) ==> (WF(p_q))
  assert (!(p_pp.v_ptr_int == null)) ==> (offset_of(p_q) < len(block_of(p_q)))
  assert (!(p_pp.v_ptr_int == null)) ==> (perm(p_q.v_int) == write)
  assert (!(p_pp.v_ptr_int == null)) ==> (perm(p_q.d_int) == write)
  assert (!(p_pp.v_ptr_int == null)) ==> (p_q.d_int)
  assert (!(p_pp.v_ptr_int == null)) ==> (RNGV(p_q.v_int))
  assert (!(p_pp.v_ptr_int == null)) ==> (perm(lvloc(block_of(p_q)).lv) >= (((!(p_pp.v_ptr_int == null)) ? a1 : none) + ((lvloc(block_of(p_q)) == lvloc(block_of(p_pp))) ? a0 : none) + ((lvloc(block_of(p_q)) == lvloc(block_of(p_r))) ? a2 : none)))
  assert p_r != null
  assert WF(p_r)
  assert offset_of(p_r) < len(block_of(p_r))
  assert perm(p_r.v_int) == write
  assert perm(p_r.d_int) == write
  assert p_r.d_int
  assert RNGV(p_r.v_int)
  assert perm(lvloc(block_of(p_r)).lv) >= (a2 + ((lvloc(block_of(p_r)) == lvloc(block_of(p_pp))) ? a0 : none) + ((lvloc(block_of(p_r)) == lvloc(block_of(p_q))) ? ((!(p_pp.v_ptr_int == null)) ? a1 : none) : none))
  assert false // <- vacuity
}
