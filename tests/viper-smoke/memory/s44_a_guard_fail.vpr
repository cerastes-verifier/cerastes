  requires (n != 0) ==> (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647)))
  requires (n != 0) ==> acc(lvloc(block_of(p)).lv, l_p)
  requires 0 <= n
  ensures (n != 0) ==> ((p != null) && ((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))) && (0 <= n) && (offset_of(p) + n <= len(block_of(p))))
  ensures (n != 0) ==> (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).v_int))
  ensures (n != 0) ==> (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).d_int))
  ensures (n != 0) ==> (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> loc(block_of(p), k).d_int)
  ensures (n != 0) ==> (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647)))
  ensures (n != 0) ==> acc(lvloc(block_of(p)).lv, l_p)
{
  assert p != null //NULL // <- expected failure
  assert p != null ==> perm(lvloc(block_of(p)).lv) > none //LIFETIME // <- expected failure
