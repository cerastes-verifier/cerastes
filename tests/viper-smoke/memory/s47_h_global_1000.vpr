// expect: verified
// S47 (h) cost, record 0063 item 9: int big[1000] with 16 listed values {1, 2, 1, 2, ...} and the zero rest (one quantifier): program_start with 16 value conjuncts, main reads big[3] and big[999] and sums the array in a loop (e1a's conjuncts over v_g). Time recorded.
// (hand-written spike fixture of record 0063 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  unique function GB_big__1(): Block
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// cerastes:trusted-contract program start: every global holds its initial value with full permission and its liveness cell; an array global's row group in the order of record 0063 item 9
method program_start()
  ensures (len(GB_big__1()) == 1000) && (lvloc(GB_big__1()) == loc(GB_big__1(), (-2)))
  ensures forall k: Int :: { loc(GB_big__1(), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(GB_big__1(), k).v_int)
  ensures forall k: Int :: { loc(GB_big__1(), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(GB_big__1(), k).d_int)
  ensures forall k: Int :: { loc(GB_big__1(), k) } ((0 <= k) && (k < 1000)) ==> loc(GB_big__1(), k).d_int
  ensures loc(GB_big__1(), 0).v_int == 1
  ensures loc(GB_big__1(), 1).v_int == 2
  ensures loc(GB_big__1(), 2).v_int == 1
  ensures loc(GB_big__1(), 3).v_int == 2
  ensures loc(GB_big__1(), 4).v_int == 1
  ensures loc(GB_big__1(), 5).v_int == 2
  ensures loc(GB_big__1(), 6).v_int == 1
  ensures loc(GB_big__1(), 7).v_int == 2
  ensures loc(GB_big__1(), 8).v_int == 1
  ensures loc(GB_big__1(), 9).v_int == 2
  ensures loc(GB_big__1(), 10).v_int == 1
  ensures loc(GB_big__1(), 11).v_int == 2
  ensures loc(GB_big__1(), 12).v_int == 1
  ensures loc(GB_big__1(), 13).v_int == 2
  ensures loc(GB_big__1(), 14).v_int == 1
  ensures loc(GB_big__1(), 15).v_int == 2
  ensures forall k: Int :: { loc(GB_big__1(), k) } ((16 <= k) && (k < 1000)) ==> loc(GB_big__1(), k).v_int == 0
  ensures acc(lvloc(GB_big__1()).lv)
  decreases _

method f_main()
{
  var v_g: Ref
  var v_i: Int
  var v_s: Int
  var kl_0: Perm
  program_start()
  v_g := loc(GB_big__1(), 0)
  assert !((offset_of(v_g) + 3 < 0) || (len(block_of(v_g)) <= offset_of(v_g) + 3)) //BOUND
  assert perm(loc(block_of(v_g), offset_of(v_g) + 3).v_int) > none //PERM
  assert loc(block_of(v_g), offset_of(v_g) + 3).d_int //INIT
  assert loc(block_of(v_g), offset_of(v_g) + 3).v_int == 2
  assert !((offset_of(v_g) + 999 < 0) || (len(block_of(v_g)) <= offset_of(v_g) + 999)) //BOUND
  assert perm(loc(block_of(v_g), offset_of(v_g) + 999).v_int) > none //PERM
  assert loc(block_of(v_g), offset_of(v_g) + 999).d_int //INIT
  assert loc(block_of(v_g), offset_of(v_g) + 999).v_int == 0
  v_i := 0
  v_s := 0
  assert forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(block_of(v_g), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(block_of(v_g), k).d_int) //MARKED
  kl_0 := perm(lvloc(block_of(v_g)).lv)
  label lh_0
  while ((v_i < 1000))
    invariant acc(lvloc(block_of(v_g)).lv, kl_0)
    invariant forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(block_of(v_g), k).v_int)
    invariant forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(block_of(v_g), k).d_int)
    invariant forall k: Int :: { loc(block_of(v_g), k) } (((0 <= k) && (k < 1000)) && old[lh_0](loc(block_of(v_g), k).d_int)) ==> loc(block_of(v_g), k).d_int
    invariant forall k: Int :: { loc(block_of(v_g), k) } (((0 <= k) && (k < 1000)) && loc(block_of(v_g), k).d_int) ==> (((-2147483648) <= loc(block_of(v_g), k).v_int) && (loc(block_of(v_g), k).v_int <= 2147483647))
    invariant forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> (loc(block_of(v_g), k).v_int == old[lh_0](loc(block_of(v_g), k).v_int))
    invariant (0 <= v_i) && (v_i <= 1000)
    invariant 0 <= v_s
    invariant v_s <= 2 * v_i
  {
    assert !((offset_of(v_g) + v_i < 0) || (len(block_of(v_g)) <= offset_of(v_g) + v_i)) //BOUND
    assert perm(loc(block_of(v_g), offset_of(v_g) + v_i).v_int) > none //PERM
    assert loc(block_of(v_g), offset_of(v_g) + v_i).d_int //INIT
    assert !(((v_s + loc(block_of(v_g), offset_of(v_g) + v_i).v_int) < (-2147483648)) || (2147483647 < (v_s + loc(block_of(v_g), offset_of(v_g) + v_i).v_int)))
    v_s := v_s + loc(block_of(v_g), offset_of(v_g) + v_i).v_int
    v_i := v_i + 1
    assert forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(block_of(v_g), k).v_int) //MARKED
    assert forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(block_of(v_g), k).d_int) //MARKED
    assert !(perm(lvloc(block_of(v_g)).lv) < kl_0) //LIVE
  }
  assert v_s <= 2000
  assert forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(block_of(v_g), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_g), k) } ((0 <= k) && (k < 1000)) ==> acc(loc(block_of(v_g), k).d_int) //MARKED
}
