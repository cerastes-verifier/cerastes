  loc(block_of(v_q), offset_of(v_q) + 0).v_int := 5
  loc(block_of(v_q), offset_of(v_q) + 0).d_int := true
  assert !((offset_of(v_q) + 1 < 0) || (len(block_of(v_q)) <= offset_of(v_q) + 1)) //BOUND
  assert !((perm(loc(block_of(v_q), offset_of(v_q) + 1).v_int) != write) || (perm(loc(block_of(v_q), offset_of(v_q) + 1).d_int) != write)) //WPERM
  loc(block_of(v_q), offset_of(v_q) + 1).v_int := 6
  loc(block_of(v_q), offset_of(v_q) + 1).d_int := true
  assert !((offset_of(v_q) + 2 < 0) || (len(block_of(v_q)) <= offset_of(v_q) + 2)) //BOUND
  assert !((perm(loc(block_of(v_q), offset_of(v_q) + 2).v_int) != write) || (perm(loc(block_of(v_q), offset_of(v_q) + 2).d_int) != write)) //WPERM
  loc(block_of(v_q), offset_of(v_q) + 2).v_int := 7
  loc(block_of(v_q), offset_of(v_q) + 2).d_int := true
  assert !((offset_of(v_q) + 3 < 0) || (len(block_of(v_q)) <= offset_of(v_q) + 3)) //BOUND
  assert !((perm(loc(block_of(v_q), offset_of(v_q) + 3).v_int) != write) || (perm(loc(block_of(v_q), offset_of(v_q) + 3).d_int) != write)) //WPERM
  loc(block_of(v_q), offset_of(v_q) + 3).v_int := 8
  loc(block_of(v_q), offset_of(v_q) + 3).d_int := true
  ra1 := loc(block_of(v_p), offset_of(v_p) + 0)
  ra2 := loc(block_of(v_q), offset_of(v_q) + 0)
  assert perm(lvloc(block_of(ra1)).lv) > none //LIVEROW
  assert perm(lvloc(block_of(ra2)).lv) > none //LIVEROW
  assert !((block_of(ra1) == block_of(ra2)) && (0 < 4) && (0 < 4) && (offset_of(ra1) < offset_of(ra2) + 4) && (offset_of(ra2) < offset_of(ra1) + 4)) //SEP
  l1 := perm(lvloc(block_of(ra1)).lv) / 3
  l2 := ((4 > 0) ? ((perm(loc(block_of(ra2), offset_of(ra2)).v_int) < perm(loc(block_of(ra2), offset_of(ra2)).d_int) ? perm(loc(block_of(ra2), offset_of(ra2)).v_int) : perm(loc(block_of(ra2), offset_of(ra2)).d_int)) < perm(lvloc(block_of(ra2)).lv) ? (perm(loc(block_of(ra2), offset_of(ra2)).v_int) < perm(loc(block_of(ra2), offset_of(ra2)).d_int) ? perm(loc(block_of(ra2), offset_of(ra2)).v_int) : perm(loc(block_of(ra2), offset_of(ra2)).d_int)) : perm(lvloc(block_of(ra2)).lv)) : perm(lvloc(block_of(ra2)).lv)) / 3
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> acc(loc(block_of(ra1), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> acc(loc(block_of(ra1), k).d_int) //MARKED
  assert !((ra1 == null) || !((ra1 == loc(block_of(ra1), offset_of(ra1))) && (0 <= offset_of(ra1)) && (offset_of(ra1) <= len(block_of(ra1)))) || (4 < 0) || (len(block_of(ra1)) < offset_of(ra1) + 4)) //SHAPE
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> loc(block_of(ra1), k).d_int //FLAGS
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> (loc(block_of(ra1), k).d_int ==> ((-2147483648 <= loc(block_of(ra1), k).v_int) && (loc(block_of(ra1), k).v_int <= 2147483647))) //RANGE
  assert forall k: Int :: { loc(block_of(ra2), k) } ((offset_of(ra2) <= k) && (k < offset_of(ra2) + 4)) ==> acc(loc(block_of(ra2), k).v_int, l2) //MARKED
  assert forall k: Int :: { loc(block_of(ra2), k) } ((offset_of(ra2) <= k) && (k < offset_of(ra2) + 4)) ==> acc(loc(block_of(ra2), k).d_int, l2) //MARKED
  assert !((ra2 == null) || !((ra2 == loc(block_of(ra2), offset_of(ra2))) && (0 <= offset_of(ra2)) && (offset_of(ra2) <= len(block_of(ra2)))) || (4 < 0) || (len(block_of(ra2)) < offset_of(ra2) + 4)) //SHAPE
  assert forall k: Int :: { loc(block_of(ra2), k) } ((offset_of(ra2) <= k) && (k < offset_of(ra2) + 4)) ==> loc(block_of(ra2), k).d_int //FLAGS
  assert forall k: Int :: { loc(block_of(ra2), k) } ((offset_of(ra2) <= k) && (k < offset_of(ra2) + 4)) ==> (loc(block_of(ra2), k).d_int ==> ((-2147483648 <= loc(block_of(ra2), k).v_int) && (loc(block_of(ra2), k).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(ra1)).lv) >= l1 + (lvloc(block_of(ra2)) == lvloc(block_of(ra1)) ? l2 : none) //LIVESUM
  assert perm(lvloc(block_of(ra2)).lv) >= l2 + (lvloc(block_of(ra1)) == lvloc(block_of(ra2)) ? l1 : none) //LIVESUM
  copy(ra1, 4, ra2, 4, l1, l2)
  assert perm(loc(block_of(v_p), offset_of(v_p) + 2).v_int) > none && perm(loc(block_of(v_p), offset_of(v_p) + 2).d_int) > none && loc(block_of(v_p), offset_of(v_p) + 2).d_int
  assert perm(loc(block_of(v_q), offset_of(v_q) + 2).v_int) > none && perm(loc(block_of(v_q), offset_of(v_q) + 2).d_int) > none && loc(block_of(v_q), offset_of(v_q) + 2).d_int
  assert loc(block_of(v_p), offset_of(v_p) + 2).v_int == loc(block_of(v_q), offset_of(v_q) + 2).v_int
  assert perm(loc(block_of(v_p), offset_of(v_p) + 0).v_int) > none && perm(loc(block_of(v_p), offset_of(v_p) + 0).d_int) > none && loc(block_of(v_p), offset_of(v_p) + 0).d_int
  assert perm(loc(block_of(v_q), offset_of(v_q) + 0).v_int) > none && perm(loc(block_of(v_q), offset_of(v_q) + 0).d_int) > none && loc(block_of(v_q), offset_of(v_q) + 0).d_int
  assert loc(block_of(v_p), offset_of(v_p) + 0).v_int == loc(block_of(v_q), offset_of(v_q) + 0).v_int
  assert forall k: Int :: { loc(block_of(v_p), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_p), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_p), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_p), k).d_int) //MARKED
  assert !(perm(lvloc(block_of(v_p)).lv) != write) //LIVE
  exhale forall k: Int :: { loc(block_of(v_p), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_p), k).v_int)
  exhale forall k: Int :: { loc(block_of(v_p), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_p), k).d_int)
  exhale acc(lvloc(block_of(v_p)).lv)
  assert forall k: Int :: { loc(block_of(v_q), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_q), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_q), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_q), k).d_int) //MARKED
  assert !(perm(lvloc(block_of(v_q)).lv) != write) //LIVE
  exhale forall k: Int :: { loc(block_of(v_q), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_q), k).v_int)
  exhale forall k: Int :: { loc(block_of(v_q), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_q), k).d_int)
  exhale acc(lvloc(block_of(v_q)).lv)
}

