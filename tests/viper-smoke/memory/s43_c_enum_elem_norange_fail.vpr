method enum_elem_norange_fail()
{
  var v_a: Ref
  var v_i: Int
  var kl_a: Perm
  var s: Int
  v_a := alloc_arr_enum_1_enum_x20E(3)
  zero_arr_enum_1_enum_x20E(v_a, 3)
  v_i := 0
  assert forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_enum_1_enum_x20E) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_enum_1_enum_x20E) //MARKED
  kl_a := perm(lvloc(block_of(v_a)).lv)
  label lh_0
  while (v_i < 3)
    invariant (0 <= v_i) && (v_i <= 3)
    invariant acc(lvloc(block_of(v_a)).lv, kl_a)
    invariant forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_enum_1_enum_x20E)
    invariant forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_enum_1_enum_x20E)
    invariant forall k: Int :: { loc(block_of(v_a), k) } ((((0 <= k) && (k < 3)) && old[lh_0](loc(block_of(v_a), k).d_enum_1_enum_x20E))) ==> loc(block_of(v_a), k).d_enum_1_enum_x20E
  {
    assert !((offset_of(v_a) + v_i < 0) || (len(block_of(v_a)) <= offset_of(v_a) + v_i)) //BOUND
    assert !((perm(loc(block_of(v_a), offset_of(v_a) + v_i).v_enum_1_enum_x20E) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + v_i).d_enum_1_enum_x20E) != write)) //WPERM
    loc(block_of(v_a), offset_of(v_a) + v_i).v_enum_1_enum_x20E := 2
    loc(block_of(v_a), offset_of(v_a) + v_i).d_enum_1_enum_x20E := true
    v_i := v_i + 1
    assert forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_enum_1_enum_x20E) //MARKED
    assert forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_enum_1_enum_x20E) //MARKED
  }
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  assert perm(loc(block_of(v_a), offset_of(v_a) + 1).v_enum_1_enum_x20E) > none //PERM
  assert loc(block_of(v_a), offset_of(v_a) + 1).d_enum_1_enum_x20E //INIT
  s := loc(block_of(v_a), offset_of(v_a) + 1).v_enum_1_enum_x20E
  assert !((s < 0) || (2 < s)) // an enumeration element's range fact: needs the range conjunct
  assert forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_enum_1_enum_x20E) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_enum_1_enum_x20E) //MARKED
  assert !(perm(lvloc(block_of(v_a)).lv) != write) //LIVE
  exhale forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).v_enum_1_enum_x20E)
  exhale forall k: Int :: { loc(block_of(v_a), k) } (((0) <= k) && (k < 3)) ==> acc(loc(block_of(v_a), k).d_enum_1_enum_x20E)
  exhale acc(lvloc(block_of(v_a)).lv)
}
