// void call_g(void) { struct T t, u; ...; g(&t, &u.s); }
method call_g()
  decreases
{
  var t: Ref
  var u: Ref
  var s: Ref
  t := alloc_struct_1_T()
  u := alloc_struct_1_T()
  assert loc(member(loc(member(t, 0), 0), 0), 0) != null
  assert perm(loc(member(loc(member(t, 0), 0), 0), 0).v_int) == write && perm(loc(member(loc(member(t, 0), 0), 0), 0).d_int) == write
  loc(member(loc(member(t, 0), 0), 0), 0).v_int := 1
  loc(member(loc(member(t, 0), 0), 0), 0).d_int := true
  assert loc(member(loc(member(t, 0), 0), 1), 0) != null
  assert perm(loc(member(loc(member(t, 0), 0), 1), 0).v_int) == write && perm(loc(member(loc(member(t, 0), 0), 1), 0).d_int) == write
  loc(member(loc(member(t, 0), 0), 1), 0).v_int := 2
  loc(member(loc(member(t, 0), 0), 1), 0).d_int := true
  assert loc(member(t, 1), 0) != null
  assert perm(loc(member(t, 1), 0).v_int) == write && perm(loc(member(t, 1), 0).d_int) == write
  loc(member(t, 1), 0).v_int := 4
  loc(member(t, 1), 0).d_int := true
  assert loc(member(loc(member(u, 0), 0), 0), 0) != null
  assert perm(loc(member(loc(member(u, 0), 0), 0), 0).v_int) == write && perm(loc(member(loc(member(u, 0), 0), 0), 0).d_int) == write
  loc(member(loc(member(u, 0), 0), 0), 0).v_int := 5
  loc(member(loc(member(u, 0), 0), 0), 0).d_int := true
  assert loc(member(loc(member(u, 0), 0), 1), 0) != null
  assert perm(loc(member(loc(member(u, 0), 0), 1), 0).v_int) == write && perm(loc(member(loc(member(u, 0), 0), 1), 0).d_int) == write
  loc(member(loc(member(u, 0), 0), 1), 0).v_int := 6
  loc(member(loc(member(u, 0), 0), 1), 0).d_int := true
  s := loc(member(u, 0), 0)   // &u.s
  assert perm(lvloc(block_of(t)).lv) > none
  assert perm(lvloc(block_of(s)).lv) > none
  assert WF(t) && WF(s)
  assert t != null
  assert WF(t)
