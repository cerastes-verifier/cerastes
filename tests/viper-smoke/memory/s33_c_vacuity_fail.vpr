  assert perm(loc(member(t, 1), 0).v_int) == write && perm(loc(member(t, 1), 0).d_int) == write
  assert perm(lvloc(block_of(t)).lv) == write
  exhale acc(loc(member(loc(member(t, 0), 0), 0), 0).v_int) && acc(loc(member(loc(member(t, 0), 0), 0), 0).d_int) && acc(loc(member(loc(member(t, 0), 0), 1), 0).v_int) && acc(loc(member(loc(member(t, 0), 0), 1), 0).d_int) && acc(loc(member(t, 1), 0).v_int) && acc(loc(member(t, 1), 0).d_int) && acc(lvloc(block_of(t)).lv)
  assert perm(loc(member(loc(member(u, 0), 0), 0), 0).v_int) == write && perm(loc(member(loc(member(u, 0), 0), 0), 0).d_int) == write
  assert perm(loc(member(loc(member(u, 0), 0), 1), 0).v_int) == write && perm(loc(member(loc(member(u, 0), 0), 1), 0).d_int) == write
  assert perm(loc(member(u, 1), 0).v_int) == write && perm(loc(member(u, 1), 0).d_int) == write
  assert perm(lvloc(block_of(u)).lv) == write
  exhale acc(loc(member(loc(member(u, 0), 0), 0), 0).v_int) && acc(loc(member(loc(member(u, 0), 0), 0), 0).d_int) && acc(loc(member(loc(member(u, 0), 0), 1), 0).v_int) && acc(loc(member(loc(member(u, 0), 0), 1), 0).d_int) && acc(loc(member(u, 1), 0).v_int) && acc(loc(member(u, 1), 0).d_int) && acc(lvloc(block_of(u)).lv)
  assert false // <- fails: vacuity
}
