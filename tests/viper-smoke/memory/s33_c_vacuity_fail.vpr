// void g(struct T *t, struct S *s) [owns(*t), owns(*s)]: t->z = s->x
method g_v1(t: Ref, s: Ref, a_t: Perm, a_s: Perm)
  requires none < a_t && a_t < write && none < a_s && a_s < write
  requires WF(t) && WF(s)
