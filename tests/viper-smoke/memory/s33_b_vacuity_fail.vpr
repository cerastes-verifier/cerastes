// void call_f(void) { struct S s; struct S t; s.x = 1; s.y = 2; t.x = 3; f(&s, &t.x); ... }
method call_f()
  decreases
{
  var s: Ref
  var t: Ref
  var q: Ref
  s := alloc_struct_0_S()
  t := alloc_struct_0_S()
  assert loc(member(s, 0), 0) != null
  assert perm(loc(member(s, 0), 0).v_int) == write && perm(loc(member(s, 0), 0).d_int) == write
  loc(member(s, 0), 0).v_int := 1
  loc(member(s, 0), 0).d_int := true
  assert loc(member(s, 1), 0) != null
  assert perm(loc(member(s, 1), 0).v_int) == write && perm(loc(member(s, 1), 0).d_int) == write
  loc(member(s, 1), 0).v_int := 2
  loc(member(s, 1), 0).d_int := true
  assert loc(member(t, 0), 0) != null
  assert perm(loc(member(t, 0), 0).v_int) == write && perm(loc(member(t, 0), 0).d_int) == write
  loc(member(t, 0), 0).v_int := 3
  loc(member(t, 0), 0).d_int := true
  q := loc(member(t, 0), 0)   // &t.x
  assert perm(lvloc(block_of(s)).lv) > none   // lifetime of s
  assert perm(lvloc(block_of(q)).lv) > none   // lifetime of q (a member's liveness is its root's)
  assert WF(s) && WF(q)
  assert s != null
  assert WF(s)
  assert offset_of(s) < len(block_of(s))
  assert len(member(s, 0)) == 1 && len(member(s, 1)) == 1
  assert perm(loc(member(s, 0), 0).v_int) == write && perm(loc(member(s, 0), 0).d_int) == write
  assert loc(member(s, 0), 0).d_int
  assert RNG(loc(member(s, 0), 0))
  assert perm(loc(member(s, 1), 0).v_int) == write && perm(loc(member(s, 1), 0).d_int) == write
  assert loc(member(s, 1), 0).d_int
  assert RNG(loc(member(s, 1), 0))
  assert q != null
  assert WF(q)
  assert offset_of(q) < len(block_of(q))
  assert perm(q.v_int) == write && perm(q.d_int) == write
  assert q.d_int
  assert RNG(q)
  assert q != loc(member(s, 0), 0)   // separation of the int atom from s's leaves (permission)
  assert q != loc(member(s, 1), 0)
  if (lvloc(block_of(s)) == lvloc(block_of(q))) { }   // the case split of 0028 item 8 on the two liveness cells
  var m: Perm := perm(lvloc(block_of(s)).lv) < perm(lvloc(block_of(q)).lv) ? perm(lvloc(block_of(s)).lv) : perm(lvloc(block_of(q)).lv)
  var a_s: Perm := m / 3
  var a_q: Perm := m / 3
  assert none < a_s && a_s < write && none < a_q && a_q < write
  assert perm(lvloc(block_of(s)).lv) >= a_s && perm(lvloc(block_of(q)).lv) >= a_q
  f(s, q, a_s, a_q)
  assert loc(member(s, 0), 0) != null
  assert perm(loc(member(s, 0), 0).v_int) > none && perm(loc(member(s, 0), 0).d_int) > none
  assert loc(member(s, 0), 0).d_int
  assert loc(member(s, 0), 0).v_int == 1
  assert q != null
  assert perm(q.v_int) > none && perm(q.d_int) > none
  assert q.d_int
  assert q.v_int == 2
  assert loc(member(s, 1), 0) != null
  assert perm(loc(member(s, 1), 0).v_int) > none && perm(loc(member(s, 1), 0).d_int) > none
  assert loc(member(s, 1), 0).d_int
  assert loc(member(s, 1), 0).v_int == 2
  assert perm(loc(member(t, 0), 0).v_int) == write && perm(loc(member(t, 0), 0).d_int) == write
  assert perm(loc(member(t, 1), 0).v_int) == write && perm(loc(member(t, 1), 0).d_int) == write
  assert perm(lvloc(block_of(t)).lv) == write
  exhale acc(loc(member(t, 0), 0).v_int) && acc(loc(member(t, 0), 0).d_int) && acc(loc(member(t, 1), 0).v_int) && acc(loc(member(t, 1), 0).d_int) && acc(lvloc(block_of(t)).lv)
  assert perm(loc(member(s, 0), 0).v_int) == write && perm(loc(member(s, 0), 0).d_int) == write
  assert perm(loc(member(s, 1), 0).v_int) == write && perm(loc(member(s, 1), 0).d_int) == write
  assert perm(lvloc(block_of(s)).lv) == write
  exhale acc(loc(member(s, 0), 0).v_int) && acc(loc(member(s, 0), 0).d_int) && acc(loc(member(s, 1), 0).v_int) && acc(loc(member(s, 1), 0).d_int) && acc(lvloc(block_of(s)).lv)
}

