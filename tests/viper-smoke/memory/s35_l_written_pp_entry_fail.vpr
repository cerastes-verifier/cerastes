// expect: error assert:assertion.false @ L124
// S35 (l) twin of s35_l_written_pp.vpr: x's cell is given away before the loop, so the atom's entry row `perm(q.v_int) == write` fails (the only error: the path stops) (record 0045 item 10)
// Hand-written in the emitted style (see the positive fixture).
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// the contract atoms, as macros over the emitted shapes (record 0037 items 6-7, 0040 item 2): WF; an int range; a cell owned (root, full permission, flag set, range or WF of the pointer, the liveness amount); live
define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define RNGV(v) ((-2147483648) <= v && v <= 2147483647)
define ROOT(p) (p != null && WF(p) && offset_of(p) < len(block_of(p)))
define LVF(p, a) acc(lvloc(block_of(p)).lv, a)
define CI(c) (acc(c.v_int) && acc(c.d_int) && c.d_int && RNGV(c.v_int))
define CP(c) (acc(c.v_ptr_int) && acc(c.d_ptr_int) && c.d_ptr_int && WF(c.v_ptr_int))
define OWNI(p, a) (ROOT(p) && CI(p) && LVF(p, a))
define OWNP(p, a) (ROOT(p) && CP(p) && LVF(p, a))
define LIVE(p, a) (p != null && WF(p) && LVF(p, a))

// cerastes:trusted-contract allocation of an address-taken local of type int: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_int() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(r.v_int) && acc(r.d_int) && !r.d_int && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of an address-taken local of type int*: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_ptr_int() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(r.v_ptr_int) && acc(r.d_ptr_int) && !r.d_ptr_int && acc(lvloc(block_of(r)).lv)
  decreases _

