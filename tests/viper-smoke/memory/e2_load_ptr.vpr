// expect: verified
// S24 candidate FINAL: load_ptr
// Final design: a pointer is a Ref; Block domain with four axioms (loc_inv, loc_nonnull, member_inv, member_lv); ghost init flag per cell; liveness token lvloc(b) at slot -2; explicit checks at every access, call, return and pointer use.
//
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field tok: Bool
field lv: Bool

domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define OWN(p) (offset_of(p) < len(block_of(p)) && acc(p.v_int) && acc(p.d_int))
define INIT(p) (OWN(p) && p.d_int)
define UNINIT(p) (OWN(p) && !p.d_int)
define LVQ(p) lvloc(block_of(p))
define LV(p, l) (acc(lvloc(block_of(p)).lv, l))
define BLK(p) (offset_of(p) == 0 && acc(loc(block_of(p), -1).tok) && loc(block_of(p), -1).tok && lvloc(block_of(p)) == loc(block_of(p), -2) && acc(lvloc(block_of(p)).lv) && (forall i: Int :: { loc(block_of(p), i) } 0 <= i && i < len(block_of(p)) ==> acc(loc(block_of(p), i).v_int) && acc(loc(block_of(p), i).d_int)))
define RDP(p, r) (offset_of(p) < len(block_of(p)) && acc(p.v_int, r) && acc(p.d_int, r) && p.d_int)

// cerastes:trusted-contract allocation of an address-taken local of type int: the cell and the block's liveness token (lvloc(b) == loc(b, -2)), full permission
method alloc_int() returns (r: Ref)
  ensures r != null && WF(r) && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures UNINIT(r) && lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)

// cerastes:trusted-contract allocation of an address-taken local of type int*
method alloc_ptr() returns (r: Ref)
  ensures r != null && WF(r) && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures offset_of(r) < len(block_of(r)) && acc(r.v_ptr_int) && acc(r.d_ptr_int) && !r.d_ptr_int && lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)

// A pointer stored in a cell: the cell's contract carries WF of its content (no surjectivity axiom needed).
method load_then_index(pp: Ref, l_pp: Perm, l_q: Perm)
  requires none < l_pp && l_pp < write && none < l_q && l_q < write
  requires pp != null && offset_of(pp) < len(block_of(pp)) && acc(pp.v_ptr_int) && acc(pp.d_ptr_int) && pp.d_ptr_int && WF(pp.v_ptr_int) && pp.v_ptr_int != null && LV(pp, l_pp)
  requires offset_of(pp.v_ptr_int) < len(block_of(pp.v_ptr_int)) && acc(pp.v_ptr_int.v_int) && acc(pp.v_ptr_int.d_int) && pp.v_ptr_int.d_int && LV(pp.v_ptr_int, l_q)
  ensures acc(pp.v_ptr_int) && LV(pp, l_pp)
{
  var q: Ref := pp.v_ptr_int
  assert q != null ==> perm(lvloc(block_of(q)).lv) > none // lifetime
  // q + 0: the pointer arithmetic reaches the cell by loc(block_of(q), offset_of(q) + 0), which must be q's own cell
  assert perm(loc(block_of(q), offset_of(q) + 0).v_int) > none
  assert perm(pp.v_ptr_int) == write
  assert perm(lvloc(block_of(pp)).lv) >= l_pp + (block_of(pp) == block_of(q) ? l_q : none)
}

method pointer_in_cell_roundtrip(x: Ref, l_x: Perm)
  requires none < l_x && l_x < write && WF(x) && INIT(x) && LV(x, l_x)
  ensures LV(x, l_x)
{
  var c: Ref
  c := alloc_ptr()
  assert perm(c.v_ptr_int) == write
  assert x != null ==> perm(lvloc(block_of(x)).lv) > none // lifetime
  assert 0 <= offset_of(x) + 0 && offset_of(x) + 0 <= len(block_of(x))
  c.v_ptr_int := loc(block_of(x), offset_of(x) + 0)
  c.d_ptr_int := true
  var q: Ref := c.v_ptr_int
  assert q == x
  assert perm(c.v_ptr_int) == write && perm(c.d_ptr_int) == write
  assert perm(lvloc(block_of(c)).lv) == write
  exhale acc(c.v_ptr_int) && acc(c.d_ptr_int) && acc(lvloc(block_of(c)).lv)
  assert perm(lvloc(block_of(x)).lv) >= l_x
}
