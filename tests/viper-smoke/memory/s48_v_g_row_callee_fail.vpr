// expect: error assert:assertion.false @ L72
// expect: error assert:assertion.false @ L154
// S48 after audit round 1, vacuity twin of s48_g_row_callee (audit round 1 issue 6 (a), question 324): an assert false before the closing brace of each method. 2 asserts (end of a method: 2; end of an inner block: 0); each is reachable and registers one error; nothing else fails. The remaining lines are the positive's, unchanged.
// S48 (g): a row m[1] passed to a callee with owns_range(q, 3) over int through a local bound to the row's first slot (the rows of e1b unchanged over it: shape, amount, marked rows over loc(block_of(r), k), flags, type range): the callee's quantifier over one variable is taken out of the caller's two-variable chunk; m[1][0] == 4 read back, the scope exit. Verifies. Time recorded.
// (hand-written spike fixture of record 0064 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}


// cerastes:trusted-contract allocation of int m[2][3] (S47 (x2)): the outer block of 2 slots, slot i's member 0 the inner block of 3; each permission one quantifier over two bound variables
method alloc_mat() returns (r: Ref)
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == 2)
  ensures forall i: Int :: { loc(block_of(r), i) } (((0 <= i) && (i < 2))) ==> (len(member(loc(block_of(r), i), 0)) == 3)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(r), i), 0), j).v_int)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(r), i), 0), j).d_int)
  ensures forall i: Int, j: Int :: { loc(member(loc(block_of(r), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> (!loc(member(loc(block_of(r), i), 0), j).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _
// owns_range(q, n) over int (S44's shape): q[0] = 4
method f_range1(q: Ref, n: Int, amt_0: Perm)
  requires none < amt_0 && amt_0 < write
  requires q != null
  requires (q == loc(block_of(q), offset_of(q))) && (0 <= offset_of(q)) && (offset_of(q) <= len(block_of(q)))
  requires 0 <= n
  requires (offset_of(q) + n) <= len(block_of(q))
  requires forall k: Int :: { loc(block_of(q), k) } (((offset_of(q) <= k) && (k < (offset_of(q) + n)))) ==> acc(loc(block_of(q), k).v_int)
  requires forall k: Int :: { loc(block_of(q), k) } (((offset_of(q) <= k) && (k < (offset_of(q) + n)))) ==> acc(loc(block_of(q), k).d_int)
  requires forall k: Int :: { loc(block_of(q), k) } (((offset_of(q) <= k) && (k < (offset_of(q) + n)))) ==> loc(block_of(q), k).d_int
  requires forall k: Int :: { loc(block_of(q), k) } (((offset_of(q) <= k) && (k < (offset_of(q) + n)))) ==> (loc(block_of(q), k).d_int ==> (((-2147483648) <= loc(block_of(q), k).v_int) && (loc(block_of(q), k).v_int <= 2147483647)))
  requires acc(lvloc(block_of(q)).lv, amt_0)
  requires 1 <= n
  ensures q != null
  ensures (q == loc(block_of(q), offset_of(q))) && (0 <= offset_of(q)) && (offset_of(q) <= len(block_of(q)))
  ensures 0 <= n
  ensures (offset_of(q) + n) <= len(block_of(q))
  ensures forall k: Int :: { loc(block_of(q), k) } (((offset_of(q) <= k) && (k < (offset_of(q) + n)))) ==> acc(loc(block_of(q), k).v_int)
  ensures forall k: Int :: { loc(block_of(q), k) } (((offset_of(q) <= k) && (k < (offset_of(q) + n)))) ==> acc(loc(block_of(q), k).d_int)
  ensures forall k: Int :: { loc(block_of(q), k) } (((offset_of(q) <= k) && (k < (offset_of(q) + n)))) ==> loc(block_of(q), k).d_int
  ensures forall k: Int :: { loc(block_of(q), k) } (((offset_of(q) <= k) && (k < (offset_of(q) + n)))) ==> (loc(block_of(q), k).d_int ==> (((-2147483648) <= loc(block_of(q), k).v_int) && (loc(block_of(q), k).v_int <= 2147483647)))
  ensures acc(lvloc(block_of(q)).lv, amt_0)
  ensures loc(block_of(q), offset_of(q)).v_int == 4
{
  var tw: Ref
  assert q != null //NULL
  assert perm(lvloc(block_of(q)).lv) > none //LIVEROW
  assert !((offset_of(q) + 0 < 0) || (len(block_of(q)) <= offset_of(q) + 0)) //BOUND
  tw := loc(block_of(q), offset_of(q) + 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 4
  tw.d_int := true
  assert false //VAC-END
}
method f_use()
{
  var vm: Ref
  var tin: Ref
  var tw: Ref
  var r: Ref
  var t5: Int
  var t6: Perm
  var v_r: Int
  vm := alloc_mat()
  assert !((offset_of(vm) + 0 < 0) || (len(block_of(vm)) <= offset_of(vm) + 0)) //BOUND1
  tin := loc(member(loc(block_of(vm), offset_of(vm) + 0), 0), 0)
  assert !((offset_of(tin) + 0 < 0) || (len(block_of(tin)) <= offset_of(tin) + 0)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 0
  tw.d_int := true
  assert !((offset_of(vm) + 0 < 0) || (len(block_of(vm)) <= offset_of(vm) + 0)) //BOUND1
  tin := loc(member(loc(block_of(vm), offset_of(vm) + 0), 0), 0)
  assert !((offset_of(tin) + 1 < 0) || (len(block_of(tin)) <= offset_of(tin) + 1)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 1)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 1
  tw.d_int := true
  assert !((offset_of(vm) + 0 < 0) || (len(block_of(vm)) <= offset_of(vm) + 0)) //BOUND1
  tin := loc(member(loc(block_of(vm), offset_of(vm) + 0), 0), 0)
  assert !((offset_of(tin) + 2 < 0) || (len(block_of(tin)) <= offset_of(tin) + 2)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 2)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 2
  tw.d_int := true
  assert !((offset_of(vm) + 1 < 0) || (len(block_of(vm)) <= offset_of(vm) + 1)) //BOUND1
  tin := loc(member(loc(block_of(vm), offset_of(vm) + 1), 0), 0)
  assert !((offset_of(tin) + 0 < 0) || (len(block_of(tin)) <= offset_of(tin) + 0)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 10
  tw.d_int := true
  assert !((offset_of(vm) + 1 < 0) || (len(block_of(vm)) <= offset_of(vm) + 1)) //BOUND1
  tin := loc(member(loc(block_of(vm), offset_of(vm) + 1), 0), 0)
  assert !((offset_of(tin) + 1 < 0) || (len(block_of(tin)) <= offset_of(tin) + 1)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 1)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 11
  tw.d_int := true
  assert !((offset_of(vm) + 1 < 0) || (len(block_of(vm)) <= offset_of(vm) + 1)) //BOUND1
  tin := loc(member(loc(block_of(vm), offset_of(vm) + 1), 0), 0)
  assert !((offset_of(tin) + 2 < 0) || (len(block_of(tin)) <= offset_of(tin) + 2)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 2)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 12
  tw.d_int := true
  assert !((offset_of(vm) + 1 < 0) || (len(block_of(vm)) <= offset_of(vm) + 1)) //BOUND1
  r := loc(member(loc(block_of(vm), offset_of(vm) + 1), 0), 0)
  t5 := 3
  assert (((r != null) && ((r == loc(block_of(r), offset_of(r))) && (0 <= offset_of(r)) && (offset_of(r) <= len(block_of(r))))) && (0 <= t5)) && ((offset_of(r) + t5) <= len(block_of(r))) //SHAPE
  assert perm(lvloc(block_of(r)).lv) > none //LIVEROW
  t6 := perm(lvloc(block_of(r)).lv) / 2
  assert none < t6
  assert t6 < write
  assert forall k: Int :: { loc(block_of(r), k) } (((offset_of(r) <= k) && (k < (offset_of(r) + t5)))) ==> acc(loc(block_of(r), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(r), k) } (((offset_of(r) <= k) && (k < (offset_of(r) + t5)))) ==> acc(loc(block_of(r), k).d_int) //MARKED
  assert forall k: Int :: { loc(block_of(r), k) } (((offset_of(r) <= k) && (k < (offset_of(r) + t5)))) ==> loc(block_of(r), k).d_int //FLAGS
  assert forall k: Int :: { loc(block_of(r), k) } (((offset_of(r) <= k) && (k < (offset_of(r) + t5)))) ==> (loc(block_of(r), k).d_int ==> (((-2147483648) <= loc(block_of(r), k).v_int) && (loc(block_of(r), k).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(r)).lv) >= t6 //LIVE
  f_range1(r, t5, t6)
  assert !((offset_of(vm) + 1 < 0) || (len(block_of(vm)) <= offset_of(vm) + 1)) //BOUND1
  tin := loc(member(loc(block_of(vm), offset_of(vm) + 1), 0), 0)
  assert !((offset_of(tin) + 0 < 0) || (len(block_of(tin)) <= offset_of(tin) + 0)) //BOUND2
  tw := loc(block_of(tin), offset_of(tin) + 0)
  assert perm(tw.v_int) > none //PERM
  assert tw.d_int //INIT
  v_r := tw.v_int
  assert v_r == 4
  assert forall i: Int, j: Int :: { loc(member(loc(block_of(vm), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(vm), i), 0), j).v_int) //MARKED
  assert forall i: Int, j: Int :: { loc(member(loc(block_of(vm), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(vm), i), 0), j).d_int) //MARKED
  assert perm(lvloc(block_of(vm)).lv) == write //LIVE
  exhale forall i: Int, j: Int :: { loc(member(loc(block_of(vm), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(vm), i), 0), j).v_int)
  exhale forall i: Int, j: Int :: { loc(member(loc(block_of(vm), i), 0), j) } (((0 <= i) && (i < 2)) && ((0 <= j) && (j < 3))) ==> acc(loc(member(loc(block_of(vm), i), 0), j).d_int)
  exhale acc(lvloc(block_of(vm)).lv)
  assert false //VAC-END
}

