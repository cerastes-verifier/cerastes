    invariant ((v_p != null) && (((v_p == null) || (((v_p == loc(block_of(v_p), offset_of(v_p))) && (0 <= offset_of(v_p))) && (offset_of(v_p) <= len(block_of(v_p))))) && (((v_p != null) && (offset_of(v_p) < len(block_of(v_p)))) ==> ((len(member(v_p, 0)) == 1) && (len(member(v_p, 1)) == 4))))) && (offset_of(v_p) < len(block_of(v_p)))
