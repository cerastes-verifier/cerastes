  assert (((-2147483648) <= loc(member(v_p, 0), 0).v_int) && (loc(member(v_p, 0), 0).v_int <= 2147483647))
  assert (aw_vn > none) && (aw_dn > none)
  assert forall k: Int :: { loc(member(v_p, 1), k) } (((0 <= k) && (k < 4))) ==> acc(loc(member(v_p, 1), k).v_int, aw_va) //MARKED
  assert forall k: Int :: { loc(member(v_p, 1), k) } (((0 <= k) && (k < 4))) ==> acc(loc(member(v_p, 1), k).d_int, aw_da) //MARKED
  assert forall k: Int :: { loc(member(v_p, 1), k) } (((0 <= k) && (k < 4))) ==> loc(member(v_p, 1), k).d_int //FLAGS
  assert forall k: Int :: { loc(member(v_p, 1), k) } (((0 <= k) && (k < 4))) ==> (((-2147483648) <= loc(member(v_p, 1), k).v_int) && (loc(member(v_p, 1), k).v_int <= 2147483647)) //RANGE
  assert (aw_va > none) && (aw_da > none)
