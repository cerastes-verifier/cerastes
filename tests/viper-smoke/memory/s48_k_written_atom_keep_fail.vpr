    invariant (aw_vn < write) ==> (loc(member(v_p, 0), 0).v_int == aw_sn)
    invariant (aw_va > none) && (aw_da > none)
    invariant forall k: Int :: { loc(member(v_p, 1), k) } (((0 <= k) && (k < 4))) ==> acc(loc(member(v_p, 1), k).v_int, aw_va)
    invariant forall k: Int :: { loc(member(v_p, 1), k) } (((0 <= k) && (k < 4))) ==> acc(loc(member(v_p, 1), k).d_int, aw_da)
    invariant forall k: Int :: { loc(member(v_p, 1), k) } (((0 <= k) && (k < 4))) ==> loc(member(v_p, 1), k).d_int
