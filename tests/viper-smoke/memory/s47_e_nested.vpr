// expect: verified
// S47 (e), record 0063 items 3 and 6: t.s.a[i], an array member of a nested structure, through a pointer to T: the chain loc(member(loc(member(p, 0), 0), 1), i), the callee's owns(*p) in the block-term form over that chain (cells n and z, the array leaf), the bound local over the nested member, a caller holding a T local. The callee keeps z unchanged and writes t.s.a[2]. Verifies.
// struct S { int n; int a[4]; }; struct T { struct S s; int z; }: member 0 of T is the slot of the nested S (X = loc(member(p, 0), 0)), whose member 1 is the array leaf member(X, 1); member 1 of T is z. The chain of t.s.a[i] is loc(member(loc(member(p, 0), 0), 1), i) (0043 item 13).
// (hand-written spike fixture of record 0063 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// cerastes:trusted-contract allocation of a local of type struct T (record 0063 item 6, 0043 item 4): the nested S's members are blocks of the slot X = loc(member(r, 0), 0), its array member of length 4
method alloc_struct_1_T() returns (r: Ref)
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == 1)
  ensures (len(member(r, 0)) == 1) && (r != loc(member(r, 0), 0))
  ensures (((len(member(loc(member(r, 0), 0), 0)) == 1) && acc(loc(member(loc(member(r, 0), 0), 0), 0).v_int)) && acc(loc(member(loc(member(r, 0), 0), 0), 0).d_int)) && (!loc(member(loc(member(r, 0), 0), 0), 0).d_int)
  ensures len(member(loc(member(r, 0), 0), 1)) == 4
  ensures forall j: Int :: { loc(member(loc(member(r, 0), 0), 1), j) } ((0 <= j) && (j < 4)) ==> acc(loc(member(loc(member(r, 0), 0), 1), j).v_int)
  ensures forall j: Int :: { loc(member(loc(member(r, 0), 0), 1), j) } ((0 <= j) && (j < 4)) ==> acc(loc(member(loc(member(r, 0), 0), 1), j).d_int)
  ensures forall j: Int :: { loc(member(loc(member(r, 0), 0), 1), j) } ((0 <= j) && (j < 4)) ==> (!loc(member(loc(member(r, 0), 0), 1), j).d_int)
  ensures (((len(member(r, 1)) == 1) && acc(loc(member(r, 1), 0).v_int)) && acc(loc(member(r, 1), 0).d_int)) && (!loc(member(r, 1), 0).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _

method f_upd(p: Ref, amt_0: Perm)
  requires (none < amt_0) && (amt_0 < write)
  requires (p == null) || (((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p))) && (offset_of(p) <= len(block_of(p))))
  requires p != null
  requires offset_of(p) < len(block_of(p))
  requires (len(member(p, 0)) == 1) && (len(member(p, 1)) == 1)
  requires (len(member(loc(member(p, 0), 0), 0)) == 1) && (len(member(loc(member(p, 0), 0), 1)) == 4)
  requires acc(loc(member(loc(member(p, 0), 0), 0), 0).v_int)
  requires acc(loc(member(loc(member(p, 0), 0), 0), 0).d_int)
  requires loc(member(loc(member(p, 0), 0), 0), 0).d_int
  requires (((-2147483648) <= loc(member(loc(member(p, 0), 0), 0), 0).v_int) && (loc(member(loc(member(p, 0), 0), 0), 0).v_int <= 2147483647))
  requires forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(loc(member(p, 0), 0), 1), k).v_int)
  requires forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(loc(member(p, 0), 0), 1), k).d_int)
  requires forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> loc(member(loc(member(p, 0), 0), 1), k).d_int
  requires forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> (((-2147483648) <= loc(member(loc(member(p, 0), 0), 1), k).v_int) && (loc(member(loc(member(p, 0), 0), 1), k).v_int <= 2147483647))
  requires acc(loc(member(p, 1), 0).v_int)
  requires acc(loc(member(p, 1), 0).d_int)
  requires loc(member(p, 1), 0).d_int
  requires (((-2147483648) <= loc(member(p, 1), 0).v_int) && (loc(member(p, 1), 0).v_int <= 2147483647))
  requires acc(lvloc(block_of(p)).lv, amt_0)
  ensures (p == null) || (((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p))) && (offset_of(p) <= len(block_of(p))))
  ensures p != null
  ensures offset_of(p) < len(block_of(p))
  ensures (len(member(p, 0)) == 1) && (len(member(p, 1)) == 1)
  ensures (len(member(loc(member(p, 0), 0), 0)) == 1) && (len(member(loc(member(p, 0), 0), 1)) == 4)
  ensures acc(loc(member(loc(member(p, 0), 0), 0), 0).v_int)
  ensures acc(loc(member(loc(member(p, 0), 0), 0), 0).d_int)
  ensures loc(member(loc(member(p, 0), 0), 0), 0).d_int
  ensures (((-2147483648) <= loc(member(loc(member(p, 0), 0), 0), 0).v_int) && (loc(member(loc(member(p, 0), 0), 0), 0).v_int <= 2147483647))
  ensures forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(loc(member(p, 0), 0), 1), k).v_int)
  ensures forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(loc(member(p, 0), 0), 1), k).d_int)
  ensures forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> loc(member(loc(member(p, 0), 0), 1), k).d_int
  ensures forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> (((-2147483648) <= loc(member(loc(member(p, 0), 0), 1), k).v_int) && (loc(member(loc(member(p, 0), 0), 1), k).v_int <= 2147483647))
  ensures acc(loc(member(p, 1), 0).v_int)
  ensures acc(loc(member(p, 1), 0).d_int)
  ensures loc(member(p, 1), 0).d_int
  ensures (((-2147483648) <= loc(member(p, 1), 0).v_int) && (loc(member(p, 1), 0).v_int <= 2147483647))
  ensures acc(lvloc(block_of(p)).lv, amt_0)
  ensures loc(member(loc(member(p, 0), 0), 1), 2).v_int == 1
  ensures loc(member(p, 1), 0).v_int == old(loc(member(p, 1), 0).v_int)
{
  var v_a: Ref
  var t0: Ref
  assert p != null
  v_a := loc(member(loc(member(p, 0), 0), 1), 0)   // the bound local of p->s.a: the chain of 0043 item 13
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 2).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 2).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 2).v_int := 1
  loc(block_of(v_a), offset_of(v_a) + 2).d_int := true
  assert p != null
  assert offset_of(p) < len(block_of(p))
  assert perm(loc(member(loc(member(p, 0), 0), 0), 0).v_int) == write
  assert perm(loc(member(loc(member(p, 0), 0), 0), 0).d_int) == write
  assert loc(member(loc(member(p, 0), 0), 0), 0).d_int
  assert (((-2147483648) <= loc(member(loc(member(p, 0), 0), 0), 0).v_int) && (loc(member(loc(member(p, 0), 0), 0), 0).v_int <= 2147483647))
  assert perm(loc(member(p, 1), 0).v_int) == write
  assert perm(loc(member(p, 1), 0).d_int) == write
  assert loc(member(p, 1), 0).d_int
  assert (((-2147483648) <= loc(member(p, 1), 0).v_int) && (loc(member(p, 1), 0).v_int <= 2147483647))
  assert forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(loc(member(p, 0), 0), 1), k).v_int)
  assert forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(loc(member(p, 0), 0), 1), k).d_int)
  assert forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> loc(member(loc(member(p, 0), 0), 1), k).d_int
  assert forall k: Int :: { loc(member(loc(member(p, 0), 0), 1), k) } ((0 <= k) && (k < 4)) ==> (((-2147483648) <= loc(member(loc(member(p, 0), 0), 1), k).v_int) && (loc(member(loc(member(p, 0), 0), 1), k).v_int <= 2147483647))
