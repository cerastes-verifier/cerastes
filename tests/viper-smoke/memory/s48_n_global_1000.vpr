    invariant forall k: Int :: { loc(member(loc(block_of(v_g), k), 0), 0) } (((0 <= k) && (k < 1000))) ==> (loc(member(loc(block_of(v_g), k), 0), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(v_g), k), 0), 0).v_int) && (loc(member(loc(block_of(v_g), k), 0), 0).v_int <= 2147483647)))
    invariant forall k: Int :: { loc(member(loc(block_of(v_g), k), 0), 0) } (((0 <= k) && (k < 1000))) ==> (loc(member(loc(block_of(v_g), k), 0), 0).v_int == old[lh_0](loc(member(loc(block_of(v_g), k), 0), 0).v_int))
