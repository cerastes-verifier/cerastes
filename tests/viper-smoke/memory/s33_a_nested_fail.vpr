// expect: error assert:assertion.false @ L115
// S33 (a) twin of s33_a_nested.vpr: the read of `t.z`, which was never written, fails its flag assert (`uninitialized`).
// Hand-written in the emitted style (see the positive fixture).
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// the contract atoms, as macros over the emitted shapes (record 0043 items 3, 9): WF; a leaf's range; a leaf at allocation (uninitialized); a leaf owned (full permission, flag set, range); a leaf owned without its flag (must_init's requires); one liveness fraction
define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define RNG(c) ((-2147483648) <= c.v_int && c.v_int <= 2147483647)
define LEAFU(c) (acc(c.v_int) && acc(c.d_int) && !c.d_int)
define LEAF(c) (acc(c.v_int) && acc(c.d_int) && c.d_int && RNG(c))
define LEAFN(c) (acc(c.v_int) && acc(c.d_int) && (c.d_int ==> RNG(c)))
define LVF(p, a) acc(lvloc(block_of(p)).lv, a)
// struct S { int x; int y; }: member 0 is x, member 1 is y; struct T { struct S s; int z; }: member 0 is the slot of the nested S, member 1 is z
define MX(s) loc(member(s, 0), 0)
define MY(s) loc(member(s, 1), 0)
define TS(t) loc(member(t, 0), 0)
define TZ(t) loc(member(t, 1), 0)
define SLEN(s) (len(member(s, 0)) == 1 && len(member(s, 1)) == 1)
define SOWN(s) (SLEN(s) && LEAF(MX(s)) && LEAF(MY(s)))
define TLEN(t) (len(member(t, 0)) == 1 && len(member(t, 1)) == 1)
define TOWN(t) (TLEN(t) && SOWN(TS(t)) && LEAF(TZ(t)))
define ROOT(p) (p != null && WF(p) && offset_of(p) < len(block_of(p)))

// cerastes:trusted-contract allocation of a struct S local: a one-slot block; each member is a block of length 1 whose leaf is uninitialized with full permission; the liveness token is the root block's (record 0043 item 4)
method alloc_struct_0_S() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures len(member(r, 0)) == 1 && acc(loc(member(r, 0), 0).v_int) && acc(loc(member(r, 0), 0).d_int) && !loc(member(r, 0), 0).d_int
  ensures len(member(r, 1)) == 1 && acc(loc(member(r, 1), 0).v_int) && acc(loc(member(r, 1), 0).d_int) && !loc(member(r, 1), 0).d_int
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of a struct T local: the nested struct S is the slot loc(member(r, 0), 0) whose members are blocks of their own; every leaf uninitialized with full permission; the liveness token is the root block's
method alloc_struct_1_T() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures len(member(r, 0)) == 1
  ensures len(member(loc(member(r, 0), 0), 0)) == 1 && acc(loc(member(loc(member(r, 0), 0), 0), 0).v_int) && acc(loc(member(loc(member(r, 0), 0), 0), 0).d_int) && !loc(member(loc(member(r, 0), 0), 0), 0).d_int
  ensures len(member(loc(member(r, 0), 0), 1)) == 1 && acc(loc(member(loc(member(r, 0), 0), 1), 0).v_int) && acc(loc(member(loc(member(r, 0), 0), 1), 0).d_int) && !loc(member(loc(member(r, 0), 0), 1), 0).d_int
  ensures len(member(r, 1)) == 1 && acc(loc(member(r, 1), 0).v_int) && acc(loc(member(r, 1), 0).d_int) && !loc(member(r, 1), 0).d_int
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)
  decreases _

// void set_s(struct S *s) [owns(*s)]: s->x = 7; ensures s->x == 7 && s->y == old(s->y)
method set_s(s: Ref, a_s: Perm)
  requires none < a_s && a_s < write
  requires WF(s)
  requires ROOT(s) && SOWN(s) && LVF(s, a_s)
  ensures ROOT(s) && SOWN(s) && LVF(s, a_s) && MX(s).v_int == 7 && MY(s).v_int == old(MY(s).v_int)
  decreases
{
  var oy: Int := loc(member(s, 1), 0).v_int
  assert loc(member(s, 0), 0) != null
  assert perm(loc(member(s, 0), 0).v_int) == write && perm(loc(member(s, 0), 0).d_int) == write
  loc(member(s, 0), 0).v_int := 7
  loc(member(s, 0), 0).d_int := true
  assert s != null
  assert WF(s)
  assert offset_of(s) < len(block_of(s))
  assert len(member(s, 0)) == 1 && len(member(s, 1)) == 1
  assert perm(loc(member(s, 0), 0).v_int) == write
  assert perm(loc(member(s, 0), 0).d_int) == write
  assert loc(member(s, 0), 0).d_int
  assert RNG(loc(member(s, 0), 0))
  assert perm(loc(member(s, 1), 0).v_int) == write
  assert perm(loc(member(s, 1), 0).d_int) == write
  assert loc(member(s, 1), 0).d_int
  assert RNG(loc(member(s, 1), 0))
  assert perm(lvloc(block_of(s)).lv) >= a_s
  assert loc(member(s, 0), 0).v_int == 7
  assert loc(member(s, 1), 0).v_int == oy
}

// void use_T(void) { struct T t; t.s.x = 1; t.s.y = 3; check(t.s.x == 1); check(t.z == 2); set_s(&t.s); ... }
method use_T()
  decreases
{
  var t: Ref
  var sp: Ref
  t := alloc_struct_1_T()
  assert loc(member(loc(member(t, 0), 0), 0), 0) != null
  assert perm(loc(member(loc(member(t, 0), 0), 0), 0).v_int) == write && perm(loc(member(loc(member(t, 0), 0), 0), 0).d_int) == write
  loc(member(loc(member(t, 0), 0), 0), 0).v_int := 1
  loc(member(loc(member(t, 0), 0), 0), 0).d_int := true
  assert loc(member(loc(member(t, 0), 0), 1), 0) != null
  assert perm(loc(member(loc(member(t, 0), 0), 1), 0).v_int) == write && perm(loc(member(loc(member(t, 0), 0), 1), 0).d_int) == write
  loc(member(loc(member(t, 0), 0), 1), 0).v_int := 3
  loc(member(loc(member(t, 0), 0), 1), 0).d_int := true
  assert loc(member(loc(member(t, 0), 0), 0), 0) != null
  assert perm(loc(member(loc(member(t, 0), 0), 0), 0).v_int) > none && perm(loc(member(loc(member(t, 0), 0), 0), 0).d_int) > none
  assert loc(member(loc(member(t, 0), 0), 0), 0).d_int
  assert loc(member(loc(member(t, 0), 0), 0), 0).v_int == 1
  assert loc(member(t, 1), 0) != null
  assert perm(loc(member(t, 1), 0).v_int) > none && perm(loc(member(t, 1), 0).d_int) > none
  assert loc(member(t, 1), 0).d_int // <- fails
  sp := loc(member(t, 0), 0)   // &t.s
  assert perm(lvloc(block_of(sp)).lv) > none   // lifetime: &t.s is a use of t
  assert WF(sp)
  assert sp != null
  assert WF(sp)
  assert offset_of(sp) < len(block_of(sp))
  assert len(member(sp, 0)) == 1 && len(member(sp, 1)) == 1
  assert perm(loc(member(sp, 0), 0).v_int) == write && perm(loc(member(sp, 0), 0).d_int) == write
  assert loc(member(sp, 0), 0).d_int
  assert RNG(loc(member(sp, 0), 0))
  assert perm(loc(member(sp, 1), 0).v_int) == write && perm(loc(member(sp, 1), 0).d_int) == write
  assert loc(member(sp, 1), 0).d_int
  assert RNG(loc(member(sp, 1), 0))
  assert perm(lvloc(block_of(sp)).lv) > none
  var a_sp: Perm := perm(lvloc(block_of(sp)).lv) / 2
  assert none < a_sp && a_sp < write
  assert perm(lvloc(block_of(sp)).lv) >= a_sp
  set_s(sp, a_sp)
  assert loc(member(loc(member(t, 0), 0), 0), 0) != null
  assert perm(loc(member(loc(member(t, 0), 0), 0), 0).v_int) > none && perm(loc(member(loc(member(t, 0), 0), 0), 0).d_int) > none
  assert loc(member(loc(member(t, 0), 0), 0), 0).d_int
  assert loc(member(loc(member(t, 0), 0), 0), 0).v_int == 7
  assert loc(member(loc(member(t, 0), 0), 1), 0) != null
  assert perm(loc(member(loc(member(t, 0), 0), 1), 0).v_int) > none && perm(loc(member(loc(member(t, 0), 0), 1), 0).d_int) > none
  assert loc(member(loc(member(t, 0), 0), 1), 0).d_int
  assert loc(member(loc(member(t, 0), 0), 1), 0).v_int == 3
  assert perm(loc(member(loc(member(t, 0), 0), 0), 0).v_int) == write && perm(loc(member(loc(member(t, 0), 0), 0), 0).d_int) == write
  assert perm(loc(member(loc(member(t, 0), 0), 1), 0).v_int) == write && perm(loc(member(loc(member(t, 0), 0), 1), 0).d_int) == write
  assert perm(loc(member(t, 1), 0).v_int) == write && perm(loc(member(t, 1), 0).d_int) == write
  assert perm(lvloc(block_of(t)).lv) == write
  exhale acc(loc(member(loc(member(t, 0), 0), 0), 0).v_int) && acc(loc(member(loc(member(t, 0), 0), 0), 0).d_int) && acc(loc(member(loc(member(t, 0), 0), 1), 0).v_int) && acc(loc(member(loc(member(t, 0), 0), 1), 0).d_int) && acc(loc(member(t, 1), 0).v_int) && acc(loc(member(t, 1), 0).d_int) && acc(lvloc(block_of(t)).lv)
}
