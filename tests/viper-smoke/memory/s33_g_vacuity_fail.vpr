// void touch_y(struct S *p) [owns(*p)]: bump_int(&p->y). The owns atom states len(member(p, 1)) == 1, which makes WF(&p->y) provable (0 <= 0 && 0 <= len(member(p, 1)))
method touch_y(p: Ref, l: Perm)
  requires none < l && l < write
  requires WF(p)
  requires ROOT(p) && SOWN(p) && LVF(p, l)
  ensures ROOT(p) && SOWN(p) && LVF(p, l) && MY(p).v_int == 9 && MX(p).v_int == old(MX(p).v_int)
  decreases
{
  var ox: Int := loc(member(p, 0), 0).v_int
  var q: Ref
  q := loc(member(p, 1), 0)   // q = &p->y
  assert p != null
  assert perm(lvloc(block_of(p)).lv) > none   // lifetime: &p->y is arithmetic on p (0028 item 3a)
  assert WF(q)
  assert q != null
  assert offset_of(q) < len(block_of(q))
  assert perm(q.v_int) == write && perm(q.d_int) == write
  assert q.d_int
  assert RNG(q)
  assert perm(lvloc(block_of(q)).lv) > none
  var a_q: Perm := perm(lvloc(block_of(q)).lv) / 2
  assert none < a_q && a_q < write
  assert perm(lvloc(block_of(q)).lv) >= a_q
  bump_int(q, a_q)
  assert p != null
  assert WF(p)
  assert offset_of(p) < len(block_of(p))
  assert len(member(p, 0)) == 1 && len(member(p, 1)) == 1
  assert perm(loc(member(p, 0), 0).v_int) == write
  assert perm(loc(member(p, 0), 0).d_int) == write
  assert loc(member(p, 0), 0).d_int
  assert RNG(loc(member(p, 0), 0))
  assert perm(loc(member(p, 1), 0).v_int) == write
  assert perm(loc(member(p, 1), 0).d_int) == write
  assert loc(member(p, 1), 0).d_int
  assert RNG(loc(member(p, 1), 0))
  assert perm(lvloc(block_of(p)).lv) >= l
  assert loc(member(p, 1), 0).v_int == 9
  assert loc(member(p, 0), 0).v_int == ox
}

