  requires forall q0: Int :: { loc(block_of(q), q0) } (-2147483648 <= (q0 - offset_of(q)) && (q0 - offset_of(q)) <= 2147483647) ==> (!(0 <= (q0 - offset_of(q)) && (q0 - offset_of(q)) < 4) || ((((block_of(loc(block_of(q), q0)) == block_of(q)) && (offset_of(q) <= offset_of(loc(block_of(q), q0))) && (offset_of(loc(block_of(q), q0)) < offset_of(q) + 4)) ? loc(block_of(q), q0).v_int : 0) >= 0))
  ensures ((p != null) && ((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))) && (0 <= 4) && (offset_of(p) + 4 <= len(block_of(p))))
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + 4)) ==> acc(loc(block_of(p), k).v_int)
