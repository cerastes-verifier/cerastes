    assert RNGV(MB(v_q).v_int)
    assert ((MB(v_q) != MB(v_s1)) && (MB(v_q) != MB(v_s2))) ==> ((aw_vqb > none) && (aw_dqb > none))
    assert perm(lvloc(block_of(v_q)).lv) >= aw_lq
    assert ((lvloc(block_of(v_q)) != lvloc(block_of(v_s1))) && (lvloc(block_of(v_q)) != lvloc(block_of(v_s2)))) ==> (aw_lq > none)
    assert v_r != null
    assert WF(v_r)
    assert offset_of(v_r) < len(block_of(v_r))
    assert SLEN(v_r)
    assert perm(MA(v_r).v_int) >= aw_vra
    assert perm(MA(v_r).d_int) >= aw_dra
    assert MA(v_r).d_int
    assert RNGV(MA(v_r).v_int)
    assert ((MA(v_r) != MA(v_s1)) && (MA(v_r) != MA(v_s2))) ==> ((aw_vra > none) && (aw_dra > none))
    assert perm(lvloc(block_of(v_r)).lv) >= aw_lr
    assert ((lvloc(block_of(v_r)) != lvloc(block_of(v_s1))) && (lvloc(block_of(v_r)) != lvloc(block_of(v_s2)))) ==> (aw_lr > none)
    assert MA(v_q) != MA(v_r)
  }
  // return q->a
  if (v_q == v_s1) { }
  if (v_q == v_s2) { }
  assert MA(v_q) != null
  assert perm(MA(v_q).v_int) > none
  assert MA(v_q).d_int
  res := MA(v_q).v_int
  assert perm(MA(v_s2).v_int) == write && perm(MA(v_s2).d_int) == write && perm(MB(v_s2).v_int) == write && perm(MB(v_s2).d_int) == write && perm(lvloc(block_of(v_s2)).lv) == write
  exhale acc(MA(v_s2).v_int) && acc(MA(v_s2).d_int) && acc(MB(v_s2).v_int) && acc(MB(v_s2).d_int) && acc(lvloc(block_of(v_s2)).lv)
  assert perm(MA(v_s1).v_int) == write && perm(MA(v_s1).d_int) == write && perm(MB(v_s1).v_int) == write && perm(MB(v_s1).d_int) == write && perm(lvloc(block_of(v_s1)).lv) == write
  exhale acc(MA(v_s1).v_int) && acc(MA(v_s1).d_int) && acc(MB(v_s1).v_int) && acc(MB(v_s1).d_int) && acc(lvloc(block_of(v_s1)).lv)
}
