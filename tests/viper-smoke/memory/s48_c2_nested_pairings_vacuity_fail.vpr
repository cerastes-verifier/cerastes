  assert forall k: Int :: { loc(member(loc(member(loc(block_of(ra1), k), 1), 0), 0), 0) } ((offset_of(ra1) <= k) && (k < (offset_of(ra1) + t5))) ==> acc(loc(member(loc(member(loc(block_of(ra1), k), 1), 0), 0), 0).v_int) //MARKED
