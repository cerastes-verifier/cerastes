// expect: error assert:assertion.false @ L145
// S45 (a) twin: the caller of top3 asserts a[1] > r after the call; the quantified ensures gives a[1] <= r, so the assert fails, alone.
// S45 hand-written fixture of the target shapes of record 0061 (draft; plan .claude/plans/m4-5e1c-quantifiers.md section 5), written from the emitted shapes of e1b (build/m4.5e1c/baseline/vpr) and the S44 fixtures. No inhale or assume (except where a line says so: spike (r)).
// (hand-written spike fixture, not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it)
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field tok: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// cerastes:trusted-contract allocation of an address-taken local of type int: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_int() returns (r: Ref)
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == 1)
  ensures ((((lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(r.v_int)) && acc(r.d_int)) && (!r.d_int)) && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of an automatic array of int with n elements (n >= 1): a fresh block of n slots, every element uninitialized, the block's liveness token; full permission to both fields of every slot in [0, n), each its own quantifier over the absolute slot (record 0059 item 3, draft)
method alloc_arr_int(n: Int) returns (r: Ref)
  requires 1 <= n
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> (!loc(block_of(r), k).d_int)
  decreases _

// cerastes:trusted-contract the static-object part of an array initializer: it takes and returns the same permissions and ensures every element zero and initialized (record 0059 item 3, draft)
method zero_arr_int(r: Ref, n: Int)
  requires (1 <= n) && (r == loc(block_of(r), 0)) && (len(block_of(r)) == n)
  requires forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  requires forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> (loc(block_of(r), k).v_int == 0)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> loc(block_of(r), k).d_int
  decreases _


method top3(a: Ref, amt: Perm) returns (r: Int)
  requires none < amt && amt < write
  requires ((a != null) && ((a == loc(block_of(a), offset_of(a))) && (0 <= offset_of(a)) && (offset_of(a) <= len(block_of(a)))) && (0 <= 3) && (offset_of(a) + 3 <= len(block_of(a))))
  requires forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> acc(loc(block_of(a), k).v_int, amt)
  requires forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> acc(loc(block_of(a), k).d_int, amt)
  requires forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> loc(block_of(a), k).d_int
  requires forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> ((-2147483648 <= loc(block_of(a), k).v_int) && (loc(block_of(a), k).v_int <= 2147483647))
  requires acc(lvloc(block_of(a)).lv, amt)
  ensures ((a != null) && ((a == loc(block_of(a), offset_of(a))) && (0 <= offset_of(a)) && (offset_of(a) <= len(block_of(a)))) && (0 <= 3) && (offset_of(a) + 3 <= len(block_of(a))))
  ensures forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> acc(loc(block_of(a), k).v_int, amt)
  ensures forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> acc(loc(block_of(a), k).d_int, amt)
  ensures forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> loc(block_of(a), k).d_int
  ensures forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> ((-2147483648 <= loc(block_of(a), k).v_int) && (loc(block_of(a), k).v_int <= 2147483647))
  ensures acc(lvloc(block_of(a)).lv, amt)
  ensures (-2147483648 <= r) && (r <= 2147483647)
  ensures forall q0: Int :: { loc(block_of(a), q0) } (-2147483648 <= (q0 - offset_of(a)) && (q0 - offset_of(a)) <= 2147483647) ==> (!(0 <= (q0 - offset_of(a)) && (q0 - offset_of(a)) < 3) || ((((block_of(loc(block_of(a), q0)) == block_of(a)) && (offset_of(a) <= offset_of(loc(block_of(a), q0))) && (offset_of(loc(block_of(a), q0)) < offset_of(a) + 3)) ? loc(block_of(a), q0).v_int : 0) <= r))
{
  var t0: Int
  var t1: Int
  var t2: Int
  assert a != null //NULL
  assert a != null ==> perm(lvloc(block_of(a)).lv) > none //LIFETIME
  assert !((offset_of(a) + 0 < 0) || (len(block_of(a)) <= offset_of(a) + 0)) //BOUND
  assert perm(loc(block_of(a), offset_of(a) + 0).v_int) > none && perm(loc(block_of(a), offset_of(a) + 0).d_int) > none && loc(block_of(a), offset_of(a) + 0).d_int
  t0 := loc(block_of(a), offset_of(a) + 0).v_int
  assert a != null //NULL
  assert a != null ==> perm(lvloc(block_of(a)).lv) > none //LIFETIME
  assert !((offset_of(a) + 1 < 0) || (len(block_of(a)) <= offset_of(a) + 1)) //BOUND
  assert perm(loc(block_of(a), offset_of(a) + 1).v_int) > none && perm(loc(block_of(a), offset_of(a) + 1).d_int) > none && loc(block_of(a), offset_of(a) + 1).d_int
  t1 := loc(block_of(a), offset_of(a) + 1).v_int
  assert a != null //NULL
  assert a != null ==> perm(lvloc(block_of(a)).lv) > none //LIFETIME
  assert !((offset_of(a) + 2 < 0) || (len(block_of(a)) <= offset_of(a) + 2)) //BOUND
  assert perm(loc(block_of(a), offset_of(a) + 2).v_int) > none && perm(loc(block_of(a), offset_of(a) + 2).d_int) > none && loc(block_of(a), offset_of(a) + 2).d_int
  t2 := loc(block_of(a), offset_of(a) + 2).v_int
  r := t0
  if (t1 > r) {
    r := t1
  }
  if (t2 > r) {
    r := t2
  }
  assert forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> acc(loc(block_of(a), k).v_int, amt) //MARKED
  assert forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> acc(loc(block_of(a), k).d_int, amt) //MARKED
  assert !((a == null) || !((a == loc(block_of(a), offset_of(a))) && (0 <= offset_of(a)) && (offset_of(a) <= len(block_of(a)))) || (3 < 0) || (len(block_of(a)) < offset_of(a) + 3)) //SHAPE
  assert (forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> loc(block_of(a), k).d_int) //FLAGS
  assert (forall k: Int :: { loc(block_of(a), k) } ((offset_of(a) <= k) && (k < offset_of(a) + 3)) ==> ((-2147483648 <= loc(block_of(a), k).v_int) && (loc(block_of(a), k).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(a)).lv) >= amt //LIVE
