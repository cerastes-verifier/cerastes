method caller_top3()
{
  var v_a: Ref
  var ra1: Ref
  var l1: Perm
  var r: Int
  v_a := alloc_arr_int(4)
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 0).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 0).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 0).v_int := 5
  loc(block_of(v_a), offset_of(v_a) + 0).d_int := true
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 1).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 1).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 1).v_int := 9
  loc(block_of(v_a), offset_of(v_a) + 1).d_int := true
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 2).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 2).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 2).v_int := 7
  loc(block_of(v_a), offset_of(v_a) + 2).d_int := true
  assert !((offset_of(v_a) + 3 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 3)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 3).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 3).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 3).v_int := 1
  loc(block_of(v_a), offset_of(v_a) + 3).d_int := true
  ra1 := loc(block_of(v_a), offset_of(v_a) + 0)
  assert !((ra1 == null) || !((ra1 == loc(block_of(ra1), offset_of(ra1))) && (0 <= offset_of(ra1)) && (offset_of(ra1) <= len(block_of(ra1)))) || (3 < 0) || (len(block_of(ra1)) < offset_of(ra1) + 3)) //SHAPE
  assert !((3 > 0) && ((perm(loc(block_of(ra1), offset_of(ra1)).v_int) == none) || (perm(loc(block_of(ra1), offset_of(ra1)).d_int) == none))) //RDROW
  assert perm(lvloc(block_of(ra1)).lv) > none //LIVEROW
  l1 := ((3 > 0) ? ((perm(loc(block_of(ra1), offset_of(ra1)).v_int) < perm(loc(block_of(ra1), offset_of(ra1)).d_int) ? perm(loc(block_of(ra1), offset_of(ra1)).v_int) : perm(loc(block_of(ra1), offset_of(ra1)).d_int)) < perm(lvloc(block_of(ra1)).lv) ? (perm(loc(block_of(ra1), offset_of(ra1)).v_int) < perm(loc(block_of(ra1), offset_of(ra1)).d_int) ? perm(loc(block_of(ra1), offset_of(ra1)).v_int) : perm(loc(block_of(ra1), offset_of(ra1)).d_int)) : perm(lvloc(block_of(ra1)).lv)) : perm(lvloc(block_of(ra1)).lv)) / 2
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 3)) ==> acc(loc(block_of(ra1), k).v_int, l1) //MARKED
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 3)) ==> acc(loc(block_of(ra1), k).d_int, l1) //MARKED
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 3)) ==> loc(block_of(ra1), k).d_int //FLAGS
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 3)) ==> (loc(block_of(ra1), k).d_int ==> ((-2147483648 <= loc(block_of(ra1), k).v_int) && (loc(block_of(ra1), k).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(ra1)).lv) >= l1 //LIVESUM
  r := top3(ra1, l1)
  assert perm(loc(block_of(v_a), offset_of(v_a) + 1).v_int) > none && perm(loc(block_of(v_a), offset_of(v_a) + 1).d_int) > none && loc(block_of(v_a), offset_of(v_a) + 1).d_int
  assert loc(block_of(v_a), offset_of(v_a) + 1).v_int > r //TWIN
  assert perm(loc(block_of(v_a), offset_of(v_a) + 0).v_int) > none && perm(loc(block_of(v_a), offset_of(v_a) + 0).d_int) > none && loc(block_of(v_a), offset_of(v_a) + 0).d_int
  assert loc(block_of(v_a), offset_of(v_a) + 0).v_int <= r
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
  assert !(perm(lvloc(block_of(v_a)).lv) != write) //LIVE
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int)
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int)
  exhale acc(lvloc(block_of(v_a)).lv)
}

