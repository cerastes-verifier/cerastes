  assert (!(v_p.v_ptr_int == null)) ==> (RNGV(v_p.v_ptr_int.v_int))
  if (!(v_p.v_ptr_int == null)) {
    if (lvloc(block_of(v_p)) == lvloc(block_of(v_p.v_ptr_int))) { }
  }
  assert none < (perm(lvloc(block_of(v_p)).lv) / 3)
  assert (perm(lvloc(block_of(v_p)).lv) / 3) < write
  assert none < (((!(v_p.v_ptr_int == null)) ? perm(lvloc(block_of(v_p.v_ptr_int)).lv) : write) / 3)
  assert (((!(v_p.v_ptr_int == null)) ? perm(lvloc(block_of(v_p.v_ptr_int)).lv) : write) / 3) < write
  assert perm(lvloc(block_of(v_p)).lv) >= ((perm(lvloc(block_of(v_p)).lv) / 3) + ((lvloc(block_of(v_p)) == lvloc(block_of(v_p.v_ptr_int))) ? (((!(v_p.v_ptr_int == null)) ? perm(lvloc(block_of(v_p.v_ptr_int)).lv) : write) / 3) : none))
  assert (!(v_p.v_ptr_int == null)) ==> (perm(lvloc(block_of(v_p.v_ptr_int)).lv) >= ((((!(v_p.v_ptr_int == null)) ? perm(lvloc(block_of(v_p.v_ptr_int)).lv) : write) / 3) + ((lvloc(block_of(v_p.v_ptr_int)) == lvloc(block_of(v_p))) ? (perm(lvloc(block_of(v_p)).lv) / 3) : none)))
  f_h__0(v_p, perm(lvloc(block_of(v_p)).lv) / 3, ((!(v_p.v_ptr_int == null)) ? perm(lvloc(block_of(v_p.v_ptr_int)).lv) : write) / 3)
  assert perm(v_x.v_int) > none
