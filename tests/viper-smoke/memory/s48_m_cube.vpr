// expect: verified
// S48 (m), record 0064 item 2 (depth 3): int c[2][3][4] (depth 3): the three blocks nested through member 0 of a slot, one quantifier per permission over three bound variables i, j, l with the trigger loc(member(loc(member(loc(block_of(c), i), 0), j), 0), l); three nested fill loops (each loop carries the three-variable place: v, d, the kept flag, the range, one liveness amount, the outer indexes fixed in the inner loops), then c[1][2][3] = 5 read back through three bound rows and the scope exit. Verifies. Time recorded.
// (hand-written spike fixture of record 0064 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}


// cerastes:trusted-contract allocation of a local int c[2][3][4] (0028 item 16 at depth 3): the outer block of 2 slots whose member 0 is a block of 3 slots whose member 0 is a block of 4; each permission one quantifier over i, j and l with the trigger loc(member(loc(member(loc(block_of(r), i), 0), j), 0), l)
