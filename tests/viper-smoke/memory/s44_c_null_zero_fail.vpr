// expect: error assert:assertion.false @ L107
// S44 (c) twin, built order: peek(NULL, 0) on an unguarded reads_range atom: the shape row fails alone (where the planned order gave two errors, the liveness row and then the shape row).
// S44 hand-written fixture of the target shapes of record 0060 (draft; plan .claude/plans/m4-5e1b-ranges-in-contracts.md section 5/6), written from the emitted shapes in build/m4.5e1b/baseline/vpr and the S43 fixtures. No inhale or assume.
// (hand-written spike fixture, not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it)
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field tok: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// cerastes:trusted-contract allocation of an address-taken local of type int: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_int() returns (r: Ref)
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == 1)
  ensures ((((lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(r.v_int)) && acc(r.d_int)) && (!r.d_int)) && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of an automatic array of int with n elements (n >= 1): a fresh block of n slots, every element uninitialized, the block's liveness token; full permission to both fields of every slot in [0, n), each its own quantifier over the absolute slot (record 0059 item 3, draft)
method alloc_arr_int(n: Int) returns (r: Ref)
  requires 1 <= n
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> (!loc(block_of(r), k).d_int)
  decreases _

// cerastes:trusted-contract the static-object part of an array initializer: it takes and returns the same permissions and ensures every element zero and initialized (record 0059 item 3, draft)
method zero_arr_int(r: Ref, n: Int)
  requires (1 <= n) && (r == loc(block_of(r), 0)) && (len(block_of(r)) == n)
  requires forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  requires forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).v_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> acc(loc(block_of(r), k).d_int)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> (loc(block_of(r), k).v_int == 0)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> loc(block_of(r), k).d_int
  decreases _

method peek(p: Ref, n: Int, amt: Perm)
  requires none < amt && amt < write
  requires ((p != null) && ((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))) && (0 <= n) && (offset_of(p) + n <= len(block_of(p))))
  requires forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).v_int, amt)
  requires forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).d_int, amt)
  requires forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> loc(block_of(p), k).d_int
  requires forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647))
  requires acc(lvloc(block_of(p)).lv, amt)
  ensures ((p != null) && ((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))) && (0 <= n) && (offset_of(p) + n <= len(block_of(p))))
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).v_int, amt)
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).d_int, amt)
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> loc(block_of(p), k).d_int
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647))
  ensures acc(lvloc(block_of(p)).lv, amt)
{
  assert forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).v_int, amt) //MARKED
  assert forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).d_int, amt) //MARKED
  assert !((p == null) || !((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))) || (n < 0) || (len(block_of(p)) < offset_of(p) + n)) //SHAPE
  assert (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> loc(block_of(p), k).d_int) //FLAGS
  assert (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(p)).lv) >= amt //LIVE
}

method main()
{
  var v_a: Ref
  var l1: Perm
  var l2: Perm
  var ra1: Ref
  var ra2: Ref
  v_a := alloc_arr_int(4)
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 0).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 0).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 0).v_int := 1
  loc(block_of(v_a), offset_of(v_a) + 0).d_int := true
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 1).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 1).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 1).v_int := 2
  loc(block_of(v_a), offset_of(v_a) + 1).d_int := true
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 2).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 2).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 2).v_int := 3
  loc(block_of(v_a), offset_of(v_a) + 2).d_int := true
  assert !((offset_of(v_a) + 3 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 3)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 3).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 3).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 3).v_int := 4
  loc(block_of(v_a), offset_of(v_a) + 3).d_int := true
  ra1 := null
  assert !((ra1 == null) || !((ra1 == loc(block_of(ra1), offset_of(ra1))) && (0 <= offset_of(ra1)) && (offset_of(ra1) <= len(block_of(ra1)))) || (0 < 0) || (len(block_of(ra1)) < offset_of(ra1) + 0)) //SHAPE // <- expected failure
  assert !((0 > 0) && ((perm(loc(block_of(ra1), offset_of(ra1)).v_int) == none) || (perm(loc(block_of(ra1), offset_of(ra1)).d_int) == none))) //RDROW
  assert perm(lvloc(block_of(ra1)).lv) > none //LIVEROW
  l1 := ((0 > 0) ? ((perm(loc(block_of(ra1), offset_of(ra1)).v_int) < perm(loc(block_of(ra1), offset_of(ra1)).d_int) ? perm(loc(block_of(ra1), offset_of(ra1)).v_int) : perm(loc(block_of(ra1), offset_of(ra1)).d_int)) < perm(lvloc(block_of(ra1)).lv) ? (perm(loc(block_of(ra1), offset_of(ra1)).v_int) < perm(loc(block_of(ra1), offset_of(ra1)).d_int) ? perm(loc(block_of(ra1), offset_of(ra1)).v_int) : perm(loc(block_of(ra1), offset_of(ra1)).d_int)) : perm(lvloc(block_of(ra1)).lv)) : perm(lvloc(block_of(ra1)).lv)) / 2
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 0)) ==> acc(loc(block_of(ra1), k).v_int, l1) //MARKED
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 0)) ==> acc(loc(block_of(ra1), k).d_int, l1) //MARKED
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 0)) ==> loc(block_of(ra1), k).d_int //FLAGS
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 0)) ==> (loc(block_of(ra1), k).d_int ==> ((-2147483648 <= loc(block_of(ra1), k).v_int) && (loc(block_of(ra1), k).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(ra1)).lv) >= l1 //LIVESUM
  peek(ra1, 0, l1)
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
  assert !(perm(lvloc(block_of(v_a)).lv) != write) //LIVE
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int)
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int)
  exhale acc(lvloc(block_of(v_a)).lv)
}
