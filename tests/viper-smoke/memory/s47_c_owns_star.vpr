// expect: verified
// S47 (c), record 0063 items 3, 6, 7, 8: a callee with requires/ensures owns(*p) in the block-term form (the root facts len(member(p, 0)) == 1 && len(member(p, 1)) == 4, the cell leaf, the array leaf's quantified permissions over loc(member(p, 1), k), one liveness fraction); the body writes p->a[i] and p->n (the root's null row once, no liveness row for the element access, the bound local); a caller that holds a structure local calls it (the cell rows as today, the array leaf's marked rows over a bound local) and reads the element back. Verifies.
// struct S { int n; int a[4]; }: member 0 is n (a cell), member 1 is a (the array leaf, the block member(p, 1), 4 elements).
// (hand-written spike fixture of record 0063 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// cerastes:trusted-contract allocation of a local of type struct S (record 0063 item 6): a one-slot block whose members are blocks; a cell member of length 1 uninitialized with full permission, an array member of its length with each element uninitialized, each quantified permission its own
method alloc_struct_0_S() returns (r: Ref)
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == 1)
  ensures (((len(member(r, 0)) == 1) && acc(loc(member(r, 0), 0).v_int)) && acc(loc(member(r, 0), 0).d_int)) && (!loc(member(r, 0), 0).d_int)
  ensures len(member(r, 1)) == 4
  ensures forall j: Int :: { loc(member(r, 1), j) } ((0 <= j) && (j < 4)) ==> acc(loc(member(r, 1), j).v_int)
  ensures forall j: Int :: { loc(member(r, 1), j) } ((0 <= j) && (j < 4)) ==> acc(loc(member(r, 1), j).d_int)
  ensures forall j: Int :: { loc(member(r, 1), j) } ((0 <= j) && (j < 4)) ==> (!loc(member(r, 1), j).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _

method f_touch(p: Ref, i: Int, amt_0: Perm)
  requires (none < amt_0) && (amt_0 < write)
  requires (p == null) || (((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p))) && (offset_of(p) <= len(block_of(p))))
  requires p != null
  requires offset_of(p) < len(block_of(p))
  requires (len(member(p, 0)) == 1) && (len(member(p, 1)) == 4)
  requires acc(loc(member(p, 0), 0).v_int)
  requires acc(loc(member(p, 0), 0).d_int)
  requires loc(member(p, 0), 0).d_int
  requires (((-2147483648) <= loc(member(p, 0), 0).v_int) && (loc(member(p, 0), 0).v_int <= 2147483647))
  requires forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(p, 1), k).v_int)
  requires forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(p, 1), k).d_int)
  requires forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> loc(member(p, 1), k).d_int
  requires forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> (((-2147483648) <= loc(member(p, 1), k).v_int) && (loc(member(p, 1), k).v_int <= 2147483647))
  requires acc(lvloc(block_of(p)).lv, amt_0)
  requires 0 <= i && i < 4
  ensures (p == null) || (((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p))) && (offset_of(p) <= len(block_of(p))))
  ensures p != null
  ensures offset_of(p) < len(block_of(p))
  ensures (len(member(p, 0)) == 1) && (len(member(p, 1)) == 4)
  ensures acc(loc(member(p, 0), 0).v_int)
  ensures acc(loc(member(p, 0), 0).d_int)
  ensures loc(member(p, 0), 0).d_int
  ensures (((-2147483648) <= loc(member(p, 0), 0).v_int) && (loc(member(p, 0), 0).v_int <= 2147483647))
  ensures forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(p, 1), k).v_int)
  ensures forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(p, 1), k).d_int)
  ensures forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> loc(member(p, 1), k).d_int
  ensures forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> (((-2147483648) <= loc(member(p, 1), k).v_int) && (loc(member(p, 1), k).v_int <= 2147483647))
  ensures acc(lvloc(block_of(p)).lv, amt_0)
  ensures loc(member(p, 0), 0).v_int == 3
  ensures loc(member(p, 1), i).v_int == old(loc(member(p, 0), 0).v_int)
{
  var v_a: Ref
  var t0: Ref
  assert p != null
  v_a := loc(member(p, 1), 0)   // the bound local of p->a (record 0063 item 5): the access is no use of p's value, no liveness row
  assert perm(loc(member(p, 0), 0).v_int) > none
  assert loc(member(p, 0), 0).d_int
  assert !((offset_of(v_a) + i < 0) || (len(block_of(v_a)) <= offset_of(v_a) + i)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + i).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + i).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + i).v_int := loc(member(p, 0), 0).v_int
  loc(block_of(v_a), offset_of(v_a) + i).d_int := true
  t0 := loc(member(p, 0), 0)
  assert !((perm(t0.v_int) != write) || (perm(t0.d_int) != write))
  t0.v_int := 3
  t0.d_int := true
  assert p != null
  assert offset_of(p) < len(block_of(p))
  assert perm(loc(member(p, 0), 0).v_int) == write
  assert perm(loc(member(p, 0), 0).d_int) == write
  assert loc(member(p, 0), 0).d_int
  assert (((-2147483648) <= loc(member(p, 0), 0).v_int) && (loc(member(p, 0), 0).v_int <= 2147483647))
  assert forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(p, 1), k).v_int)
  assert forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> acc(loc(member(p, 1), k).d_int)
  assert forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> loc(member(p, 1), k).d_int
  assert forall k: Int :: { loc(member(p, 1), k) } ((0 <= k) && (k < 4)) ==> (((-2147483648) <= loc(member(p, 1), k).v_int) && (loc(member(p, 1), k).v_int <= 2147483647))
  assert perm(lvloc(block_of(p)).lv) >= amt_0
}

method f_use()
{
  var v_s: Ref
  var v_a: Ref
  var t0: Ref
  var a_0: Perm
  v_s := alloc_struct_0_S()
  t0 := loc(member(v_s, 0), 0)
  assert !((perm(t0.v_int) != write) || (perm(t0.d_int) != write))
  t0.v_int := 7
  t0.d_int := true
  v_a := loc(member(v_s, 1), 0)   // the bound local of s.a
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 0).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 0).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 0).v_int := 1
  loc(block_of(v_a), offset_of(v_a) + 0).d_int := true
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 1).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 1).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 1).v_int := 2
  loc(block_of(v_a), offset_of(v_a) + 1).d_int := true
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 2).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 2).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 2).v_int := 3
  loc(block_of(v_a), offset_of(v_a) + 2).d_int := true
  assert !((offset_of(v_a) + 3 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 3)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 3).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 3).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 3).v_int := 4
  loc(block_of(v_a), offset_of(v_a) + 3).d_int := true
  // touch(&s, 2): the call's rows (cell leaf as today, the array leaf's marked rows over the bound local), then the call
  assert v_s != null
  assert perm(lvloc(block_of(v_s)).lv) > none
  a_0 := perm(lvloc(block_of(v_s)).lv) / 2
  assert none < a_0
  assert a_0 < write
  assert perm(loc(member(v_s, 0), 0).v_int) == write
  assert perm(loc(member(v_s, 0), 0).d_int) == write
  assert loc(member(v_s, 0), 0).d_int
  assert (((-2147483648) <= loc(member(v_s, 0), 0).v_int) && (loc(member(v_s, 0), 0).v_int <= 2147483647))
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int)
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int)
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> loc(block_of(v_a), k).d_int
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> (loc(block_of(v_a), k).d_int ==> (((-2147483648) <= loc(block_of(v_a), k).v_int) && (loc(block_of(v_a), k).v_int <= 2147483647)))
  assert perm(lvloc(block_of(v_s)).lv) >= a_0
  assert ((0 <= 2) && (2 < 4))
  f_touch(v_s, 2, a_0)
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  assert perm(loc(block_of(v_a), offset_of(v_a) + 2).v_int) > none //PERM
  assert loc(block_of(v_a), offset_of(v_a) + 2).d_int //INIT
  assert loc(block_of(v_a), offset_of(v_a) + 2).v_int == 7 // old(p->n) reached a[2]
  assert perm(loc(member(v_s, 0), 0).v_int) > none
  assert loc(member(v_s, 0), 0).d_int
  assert loc(member(v_s, 0), 0).v_int == 3
  assert !((perm(loc(member(v_s, 0), 0).v_int) != write) || (perm(loc(member(v_s, 0), 0).d_int) != write))
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
  assert perm(lvloc(block_of(v_s)).lv) == write //LIVE
  exhale (acc(loc(member(v_s, 0), 0).v_int) && acc(loc(member(v_s, 0), 0).d_int))
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int)
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int)
  exhale acc(lvloc(block_of(v_s)).lv)
}
