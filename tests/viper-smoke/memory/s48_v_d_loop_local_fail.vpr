// expect: error assert:assertion.false @ L115
// expect: error assert:assertion.false @ L133
// S48 after audit round 1, vacuity twin of s48_d_loop_local (audit round 1 issue 6 (a), question 324): an assert false at the end of the loop body and one at the end of the method. 2 asserts (end of a method: 1; end of an inner block: 1); each is reachable and registers one error; nothing else fails. The remaining lines are the positive's, unchanged.
// S48 (d), record 0064 item 10: struct P v[3] local, zeroed, then a loop writing v[i].x = i. Each leaf is its own array place over the bound local (entry marked rows, the quantified permissions, the flags, the range; leaf y, which no write reaches, keeps its values; leaf x is written: no values-kept conjunct) with ONE liveness conjunct for the root; the back-edge rows; v[1].y == 0 read after the loop, the scope exit. Verifies. Time recorded.
// (hand-written spike fixture of record 0064 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}


// cerastes:trusted-contract allocation of a local array of struct P with n elements (record 0064 item 6, S47 (x1)'s shape): each element a struct slot whose members are blocks of length 1; per leaf one quantifier for each permission, each with the trigger loc(member(loc(block_of(r), k), j), 0); every flag false
method alloc_arr_P(n: Int) returns (r: Ref)
  requires 1 <= n
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  ensures forall k: Int :: { loc(block_of(r), k) } (((0 <= k) && (k < n))) ==> ((len(member(loc(block_of(r), k), 0)) == 1) && (len(member(loc(block_of(r), k), 1)) == 1))
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 0), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } (((0 <= k) && (k < n))) ==> (!loc(member(loc(block_of(r), k), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 1), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 1), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 1), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 1), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 1), 0) } (((0 <= k) && (k < n))) ==> (!loc(member(loc(block_of(r), k), 1), 0).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _
method f_loop()
{
  var v_a: Ref
  var tw: Ref
  var tr: Ref
  var q: Ref
  var v_i: Int
  var v_r: Int
  var kl_0: Perm
  v_a := alloc_arr_P(3)
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 0), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 0
  tw.d_int := true
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 0), 1), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 0
  tw.d_int := true
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 1), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 0
  tw.d_int := true
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 1), 1), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 0
  tw.d_int := true
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 2), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 0
  tw.d_int := true
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 2), 1), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 0
  tw.d_int := true
  v_i := 0
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).d_int) //MARKED
  kl_0 := perm(lvloc(block_of(v_a)).lv)
  label lh_0
  while (v_i < 3)
    invariant acc(lvloc(block_of(v_a)).lv, kl_0)
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int)
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int)
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> (old[lh_0](loc(member(loc(block_of(v_a), k), 0), 0).d_int) ==> loc(member(loc(block_of(v_a), k), 0), 0).d_int)
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> (loc(member(loc(block_of(v_a), k), 0), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(v_a), k), 0), 0).v_int) && (loc(member(loc(block_of(v_a), k), 0), 0).v_int <= 2147483647)))
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).v_int)
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).d_int)
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> (old[lh_0](loc(member(loc(block_of(v_a), k), 1), 0).d_int) ==> loc(member(loc(block_of(v_a), k), 1), 0).d_int)
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> (loc(member(loc(block_of(v_a), k), 1), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(v_a), k), 1), 0).v_int) && (loc(member(loc(block_of(v_a), k), 1), 0).v_int <= 2147483647)))
    invariant forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> (loc(member(loc(block_of(v_a), k), 1), 0).v_int == old[lh_0](loc(member(loc(block_of(v_a), k), 1), 0).v_int))
    invariant (0 <= v_i) && (v_i <= 3)
  {
    assert !((offset_of(v_a) + v_i < 0) || (len(block_of(v_a)) <= offset_of(v_a) + v_i)) //BOUND
    tw := loc(member(loc(block_of(v_a), offset_of(v_a) + v_i), 0), 0)
    assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
    tw.v_int := v_i
    tw.d_int := true
    v_i := v_i + 1
    assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int) //MARKED
    assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int) //MARKED
    assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).v_int) //MARKED
    assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).d_int) //MARKED
    assert !(perm(lvloc(block_of(v_a)).lv) < kl_0) //LIVE
    assert false //VAC-IN
  }
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  tr := loc(member(loc(block_of(v_a), offset_of(v_a) + 1), 1), 0)
  assert perm(tr.v_int) > none //PERM
  assert tr.d_int //INIT
  v_r := tr.v_int
  assert v_r == 0 //KEPT
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).d_int) //MARKED
  assert perm(lvloc(block_of(v_a)).lv) == write //LIVE
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int)
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int)
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).v_int)
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).d_int)
  exhale acc(lvloc(block_of(v_a)).lv)
  assert false //VAC-END
}

