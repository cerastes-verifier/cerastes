// expect: error postcondition:assertion.false @ L51
// expect: error assert:assertion.false @ L98
// expect: error assert:assertion.false @ L136
// expect: error assert:assertion.false @ L148
// expect: error assert:assertion.false @ L159
// S24 candidate FINAL: swap_fail
// Final design: a pointer is a Ref; Block domain with four axioms (loc_inv, loc_nonnull, member_inv, member_lv); ghost init flag per cell; liveness token lvloc(b) at slot -2; explicit checks at every access, call, return and pointer use.
//
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field tok: Bool
field lv: Bool

domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define OWN(p) (offset_of(p) < len(block_of(p)) && acc(p.v_int) && acc(p.d_int))
define INIT(p) (OWN(p) && p.d_int)
define UNINIT(p) (OWN(p) && !p.d_int)
define LVQ(p) lvloc(block_of(p))
define LV(p, l) (acc(lvloc(block_of(p)).lv, l))
define BLK(p) (offset_of(p) == 0 && acc(loc(block_of(p), -1).tok) && loc(block_of(p), -1).tok && lvloc(block_of(p)) == loc(block_of(p), -2) && acc(lvloc(block_of(p)).lv) && (forall i: Int :: { loc(block_of(p), i) } 0 <= i && i < len(block_of(p)) ==> acc(loc(block_of(p), i).v_int) && acc(loc(block_of(p), i).d_int)))
define RDP(p, r) (offset_of(p) < len(block_of(p)) && acc(p.v_int, r) && acc(p.d_int, r) && p.d_int)

// cerastes:trusted-contract allocation of an address-taken local of type int: the cell and the block's liveness token (lvloc(b) == loc(b, -2)), full permission
method alloc_int() returns (r: Ref)
  ensures r != null && WF(r) && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures UNINIT(r) && lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)


method swap_wrong(a: Ref, b: Ref, l_a: Perm, l_b: Perm)
  requires none < l_a && l_a < write
  requires none < l_b && l_b < write
  requires WF(a) && WF(b) && INIT(a) && INIT(b) && LV(a, l_a) && LV(b, l_b)
  ensures INIT(a) && INIT(b) && LV(a, l_a) && LV(b, l_b)
  ensures a.v_int == old(a.v_int) && b.v_int == old(b.v_int)
{
  if (lvloc(block_of(a)) == lvloc(block_of(b))) { } // case split on the liveness cells
  assert a != null && b != null ==> a != b // entry: separation of two single owned places of one field (provable; keeps a failed explicit check from cascading)
  var t: Int
  assert a != null
  assert perm(a.v_int) > none
  assert perm(a.d_int) > none && a.d_int
  t := a.v_int
  assert b != null
  assert perm(b.v_int) > none
  assert perm(b.d_int) > none && b.d_int
  assert a != null
  assert perm(a.v_int) == write && perm(a.d_int) == write
  a.v_int := b.v_int
  a.d_int := true
  assert b != null
  assert perm(b.v_int) == write && perm(b.d_int) == write
  b.v_int := t
  b.d_int := true
  // return: the permission clauses of the postcondition
  assert perm(a.v_int) == write && perm(a.d_int) == write
  assert a.d_int
  assert perm(b.v_int) == write && perm(b.d_int) == write
  assert b.d_int
  assert perm(lvloc(block_of(a)).lv) >= l_a + (lvloc(block_of(a)) == lvloc(block_of(b)) ? l_b : none)
  assert perm(lvloc(block_of(b)).lv) >= l_b + (lvloc(block_of(b)) == lvloc(block_of(a)) ? l_a : none)
}

method swap(a: Ref, b: Ref, l_a: Perm, l_b: Perm)
  requires none < l_a && l_a < write
  requires none < l_b && l_b < write
  requires WF(a) && WF(b) && INIT(a) && INIT(b) && LV(a, l_a) && LV(b, l_b)
  ensures INIT(a) && INIT(b) && LV(a, l_a) && LV(b, l_b)
  ensures a.v_int == old(b.v_int) && b.v_int == old(a.v_int)

method swap_drops(a: Ref, b: Ref, l_a: Perm, l_b: Perm)
  requires none < l_a && l_a < write
  requires none < l_b && l_b < write
  requires WF(a) && WF(b) && INIT(a) && INIT(b) && LV(a, l_a) && LV(b, l_b)
  ensures INIT(a) && INIT(b) && LV(a, l_a) && LV(b, l_b)
  ensures a.v_int == old(b.v_int) && b.v_int == old(a.v_int)
{
  if (lvloc(block_of(a)) == lvloc(block_of(b))) { } // case split on the liveness cells
  assert a != null && b != null ==> a != b // entry: separation of two single owned places of one field (provable; keeps a failed explicit check from cascading)
  exhale acc(a.v_int) && acc(a.d_int)
  // return: the permission clauses of the postcondition
  assert perm(a.v_int) == write && perm(a.d_int) == write
  assert perm(b.v_int) == write && perm(b.d_int) == write
  assert b.d_int
  assert perm(lvloc(block_of(a)).lv) >= l_a + (lvloc(block_of(a)) == lvloc(block_of(b)) ? l_b : none)
  assert perm(lvloc(block_of(b)).lv) >= l_b + (lvloc(block_of(b)) == lvloc(block_of(a)) ? l_a : none)
}

method swap_returns_less(a: Ref, b: Ref, l_a: Perm, l_b: Perm)
  requires none < l_a && l_a < write
  requires none < l_b && l_b < write
  requires WF(a) && WF(b) && INIT(a) && INIT(b) && LV(a, l_a) && LV(b, l_b)
  ensures INIT(a) && INIT(b) && LV(a, l_a) && LV(b, l_b)
  ensures a.v_int == old(b.v_int) && b.v_int == old(a.v_int)
{
  if (lvloc(block_of(a)) == lvloc(block_of(b))) { } // case split on the liveness cells
  assert a != null && b != null ==> a != b // entry: separation of two single owned places of one field (provable; keeps a failed explicit check from cascading)
  var t: Int
  assert a != null
  assert perm(a.v_int) > none
  assert perm(a.d_int) > none && a.d_int
  t := a.v_int
  assert b != null
  assert perm(b.v_int) > none
  assert perm(b.d_int) > none && b.d_int
  assert a != null
  assert perm(a.v_int) == write && perm(a.d_int) == write
  a.v_int := b.v_int
  a.d_int := true
  assert b != null
  assert perm(b.v_int) == write && perm(b.d_int) == write
  b.v_int := t
  b.d_int := true
  exhale acc(lvloc(block_of(a)).lv, l_a / 2)
  // return: the permission clauses of the postcondition
  assert perm(a.v_int) == write && perm(a.d_int) == write
  assert a.d_int
  assert perm(b.v_int) == write && perm(b.d_int) == write
  assert b.d_int
  assert perm(lvloc(block_of(a)).lv) >= l_a + (lvloc(block_of(a)) == lvloc(block_of(b)) ? l_b : none)
  assert perm(lvloc(block_of(b)).lv) >= l_b + (lvloc(block_of(b)) == lvloc(block_of(a)) ? l_a : none)
}

method use_returns_less(p: Ref, l_p: Perm)   // gives back half of the liveness fraction: the explicit return check fails
  requires none < l_p && l_p < write
  requires WF(p) && INIT(p) && LV(p, l_p)
  ensures INIT(p) && LV(p, l_p)
{
  exhale acc(lvloc(block_of(p)).lv, l_p / 2)
  assert perm(p.v_int) == write && perm(p.d_int) == write
  assert p.d_int
  assert perm(lvloc(block_of(p)).lv) >= l_p
}

method swap_same()
{
  var x: Ref
  x := alloc_int()
  assert x != null
  assert perm(x.v_int) == write && perm(x.d_int) == write
  x.v_int := 1
  x.d_int := true
  assert x != x // the two owns of swap(&x, &x) cannot both hold
}
