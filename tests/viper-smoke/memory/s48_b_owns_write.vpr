// expect: verified
// S48 (b), record 0064 items 7 and 8: owns_range(p, n) over struct P in a callee that writes p[i].x (the rows of p[i]: null, the liveness cell, the bound, then the cell's), the callee's ensures restating the range and p[1].x == 7; the caller holds struct P v[3], passes &v[0] with 3 (the call rows per leaf: shape, amount, lens, the marked, flag and type-range rows) and reads v[1].x back. Verifies. Time recorded.
// (hand-written spike fixture of record 0064 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}


// cerastes:trusted-contract allocation of a local array of struct P with n elements (record 0064 item 6, S47 (x1)'s shape): each element a struct slot whose members are blocks of length 1; per leaf one quantifier for each permission, each with the trigger loc(member(loc(block_of(r), k), j), 0); every flag false
method alloc_arr_P(n: Int) returns (r: Ref)
  requires 1 <= n
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  ensures forall k: Int :: { loc(block_of(r), k) } (((0 <= k) && (k < n))) ==> ((len(member(loc(block_of(r), k), 0)) == 1) && (len(member(loc(block_of(r), k), 1)) == 1))
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 0), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } (((0 <= k) && (k < n))) ==> (!loc(member(loc(block_of(r), k), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 1), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 1), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 1), 0) } (((0 <= k) && (k < n))) ==> acc(loc(member(loc(block_of(r), k), 1), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 1), 0) } (((0 <= k) && (k < n))) ==> (!loc(member(loc(block_of(r), k), 1), 0).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _
// p[i].x = 7 under owns_range(p, n) over struct P
method f_put(p: Ref, n: Int, i: Int, amt_0: Perm)
  requires none < amt_0 && amt_0 < write
  requires p != null
  requires (p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))
  requires 0 <= n
  requires (offset_of(p) + n) <= len(block_of(p))
  requires forall k: Int :: { loc(block_of(p), k) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> ((len(member(loc(block_of(p), k), 0)) == 1) && (len(member(loc(block_of(p), k), 1)) == 1))
  requires forall k: Int :: { loc(member(loc(block_of(p), k), 0), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> acc(loc(member(loc(block_of(p), k), 0), 0).v_int)
  requires forall k: Int :: { loc(member(loc(block_of(p), k), 0), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> acc(loc(member(loc(block_of(p), k), 0), 0).d_int)
  requires forall k: Int :: { loc(member(loc(block_of(p), k), 0), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> loc(member(loc(block_of(p), k), 0), 0).d_int
  requires forall k: Int :: { loc(member(loc(block_of(p), k), 0), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> (loc(member(loc(block_of(p), k), 0), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(p), k), 0), 0).v_int) && (loc(member(loc(block_of(p), k), 0), 0).v_int <= 2147483647)))
  requires forall k: Int :: { loc(member(loc(block_of(p), k), 1), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> acc(loc(member(loc(block_of(p), k), 1), 0).v_int)
  requires forall k: Int :: { loc(member(loc(block_of(p), k), 1), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> acc(loc(member(loc(block_of(p), k), 1), 0).d_int)
  requires forall k: Int :: { loc(member(loc(block_of(p), k), 1), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> loc(member(loc(block_of(p), k), 1), 0).d_int
  requires forall k: Int :: { loc(member(loc(block_of(p), k), 1), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> (loc(member(loc(block_of(p), k), 1), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(p), k), 1), 0).v_int) && (loc(member(loc(block_of(p), k), 1), 0).v_int <= 2147483647)))
  requires acc(lvloc(block_of(p)).lv, amt_0)
  requires 0 <= i && i < n
  ensures p != null
  ensures (p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))
  ensures 0 <= n
  ensures (offset_of(p) + n) <= len(block_of(p))
  ensures forall k: Int :: { loc(block_of(p), k) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> ((len(member(loc(block_of(p), k), 0)) == 1) && (len(member(loc(block_of(p), k), 1)) == 1))
  ensures forall k: Int :: { loc(member(loc(block_of(p), k), 0), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> acc(loc(member(loc(block_of(p), k), 0), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(p), k), 0), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> acc(loc(member(loc(block_of(p), k), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(p), k), 0), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> loc(member(loc(block_of(p), k), 0), 0).d_int
  ensures forall k: Int :: { loc(member(loc(block_of(p), k), 0), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> (loc(member(loc(block_of(p), k), 0), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(p), k), 0), 0).v_int) && (loc(member(loc(block_of(p), k), 0), 0).v_int <= 2147483647)))
  ensures forall k: Int :: { loc(member(loc(block_of(p), k), 1), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> acc(loc(member(loc(block_of(p), k), 1), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(p), k), 1), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> acc(loc(member(loc(block_of(p), k), 1), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(p), k), 1), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> loc(member(loc(block_of(p), k), 1), 0).d_int
  ensures forall k: Int :: { loc(member(loc(block_of(p), k), 1), 0) } (((offset_of(p) <= k) && (k < (offset_of(p) + n)))) ==> (loc(member(loc(block_of(p), k), 1), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(p), k), 1), 0).v_int) && (loc(member(loc(block_of(p), k), 1), 0).v_int <= 2147483647)))
  ensures acc(lvloc(block_of(p)).lv, amt_0)
  ensures loc(member(loc(block_of(p), offset_of(p) + i), 0), 0).v_int == 7
{
  var tw: Ref
  assert p != null //NULL
  assert perm(lvloc(block_of(p)).lv) > none //LIVEROW
  assert !((offset_of(p) + i < 0) || (len(block_of(p)) <= offset_of(p) + i)) //BOUND
  tw := loc(member(loc(block_of(p), offset_of(p) + i), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 7
  tw.d_int := true
}
method f_use()
{
  var v_a: Ref
  var tw: Ref
  var tr: Ref
  var t4: Ref
  var t5: Int
  var t6: Perm
  var v_r: Int
  var t7: Ref
  var t8: Perm
  v_a := alloc_arr_P(3)
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 0), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 1
  tw.d_int := true
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
