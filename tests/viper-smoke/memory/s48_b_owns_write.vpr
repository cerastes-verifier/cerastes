  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 1), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 11
  tw.d_int := true
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 1), 1), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 12
  tw.d_int := true
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 2), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 21
  tw.d_int := true
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 2), 1), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 22
  tw.d_int := true
  assert !(((offset_of(v_a) + 0) < 0) || (len(block_of(v_a)) < (offset_of(v_a) + 0)))
  t4 := loc(block_of(v_a), offset_of(v_a) + 0)
  t5 := 3
  assert (((t4 != null) && ((t4 == loc(block_of(t4), offset_of(t4))) && (0 <= offset_of(t4)) && (offset_of(t4) <= len(block_of(t4))))) && (0 <= t5)) && ((offset_of(t4) + t5) <= len(block_of(t4))) //SHAPE
  assert perm(lvloc(block_of(t4)).lv) > none //LIVEROW
  t6 := perm(lvloc(block_of(t4)).lv) / 2
  assert none < t6
  assert t6 < write
  assert (0 <= 1) && (1 < t5)
  assert forall k: Int :: { loc(block_of(t4), k) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> ((len(member(loc(block_of(t4), k), 0)) == 1) && (len(member(loc(block_of(t4), k), 1)) == 1)) //LENS
  assert forall k: Int :: { loc(member(loc(block_of(t4), k), 0), 0) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> acc(loc(member(loc(block_of(t4), k), 0), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(t4), k), 0), 0) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> acc(loc(member(loc(block_of(t4), k), 0), 0).d_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(t4), k), 0), 0) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> loc(member(loc(block_of(t4), k), 0), 0).d_int //FLAGS
  assert forall k: Int :: { loc(member(loc(block_of(t4), k), 0), 0) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> (loc(member(loc(block_of(t4), k), 0), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(t4), k), 0), 0).v_int) && (loc(member(loc(block_of(t4), k), 0), 0).v_int <= 2147483647))) //RANGE
  assert forall k: Int :: { loc(member(loc(block_of(t4), k), 1), 0) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> acc(loc(member(loc(block_of(t4), k), 1), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(t4), k), 1), 0) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> acc(loc(member(loc(block_of(t4), k), 1), 0).d_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(t4), k), 1), 0) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> loc(member(loc(block_of(t4), k), 1), 0).d_int //FLAGS
  assert forall k: Int :: { loc(member(loc(block_of(t4), k), 1), 0) } (((offset_of(t4) <= k) && (k < (offset_of(t4) + t5)))) ==> (loc(member(loc(block_of(t4), k), 1), 0).d_int ==> (((-2147483648) <= loc(member(loc(block_of(t4), k), 1), 0).v_int) && (loc(member(loc(block_of(t4), k), 1), 0).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(t4)).lv) >= t6 //LIVE
  f_put(t4, t5, 1, t6)
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  tr := loc(member(loc(block_of(v_a), offset_of(v_a) + 1), 0), 0)
  assert perm(tr.v_int) > none //PERM
  assert tr.d_int //INIT
  v_r := tr.v_int
  assert v_r == 7
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).d_int) //MARKED
  assert perm(lvloc(block_of(v_a)).lv) == write //LIVE
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int)
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int)
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).v_int)
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 1), 0) } (((0 <= k) && (k < 3))) ==> acc(loc(member(loc(block_of(v_a), k), 1), 0).d_int)
  exhale acc(lvloc(block_of(v_a)).lv)
}

