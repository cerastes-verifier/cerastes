// S34 (a) vacuity: s34_a_ptr_result.vpr with an `assert false` at the start of each method, after each allocation, after each call and at the end of each body, one per cloned method (Silicon reports only the first failing `assert false` on a path): every one must FAIL, so no trusted contract, axiom or fact makes the state contradictory.
// Hand-written in the emitted style (see the positive fixture).
field v_int: Int
field d_int: Bool
field v_ptr_int: Ref
field d_ptr_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// the contract atoms, as macros over the emitted shapes (record 0043 items 3, 9; record 0044 items 3-5, 8): WF; a leaf's range; a leaf at allocation (uninitialized); a leaf owned (full permission, flag set, range); one liveness fraction
define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define RNG(c) ((-2147483648) <= c.v_int && c.v_int <= 2147483647)
define RNGV(v) ((-2147483648) <= v && v <= 2147483647)
define LEAFU(c) (acc(c.v_int) && acc(c.d_int) && !c.d_int)
define LEAF(c) (acc(c.v_int) && acc(c.d_int) && c.d_int && RNG(c))
define LVF(p, a) acc(lvloc(block_of(p)).lv, a)
// struct S { int x; int y; }: member 0 is x, member 1 is y; struct T { struct S s; int z; }: member 0 is the slot of the nested S, member 1 is z
define MX(s) loc(member(s, 0), 0)
define MY(s) loc(member(s, 1), 0)
define TS(t) loc(member(t, 0), 0)
define TZ(t) loc(member(t, 1), 0)
define SLEN(s) (len(member(s, 0)) == 1 && len(member(s, 1)) == 1)
define SOWN(s) (SLEN(s) && LEAF(MX(s)) && LEAF(MY(s)))
define TLEN(t) (len(member(t, 0)) == 1 && len(member(t, 1)) == 1)
define TOWN(t) (TLEN(t) && SOWN(TS(t)) && LEAF(TZ(t)))
define ROOT(p) (p != null && WF(p) && offset_of(p) < len(block_of(p)))
define OWNI(p, a) (ROOT(p) && LEAF(p) && LVF(p, a))


// cerastes:trusted-contract allocation of an address-taken local of type int: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_int() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(r.v_int) && acc(r.d_int) && !r.d_int && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of a struct P local (struct P { int *p; int v; }): member 0 is a pointer leaf (the fields of int *), member 1 an int leaf; both uninitialized with full permission; the liveness token is the root block's
method alloc_struct_0_P() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures len(member(r, 0)) == 1 && acc(loc(member(r, 0), 0).v_ptr_int) && acc(loc(member(r, 0), 0).d_ptr_int) && !loc(member(r, 0), 0).d_ptr_int
  ensures len(member(r, 1)) == 1 && acc(loc(member(r, 1), 0).v_int) && acc(loc(member(r, 1), 0).d_int) && !loc(member(r, 1), 0).d_int
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)
  decreases _

// struct P pick(int *pa, int *pb) requires(owns(*pa) && owns(*pb)) ensures(r, owns(*pa) && owns(*pb) && (r.p == pa || r.p == pb) && r.v == 0) { struct P s; s.p = pa; s.v = 0; return s; }   (a pointer leaf: ensures WF(res_m0), the caller case-splits, 0037 item 3)
method f_pick__0(pa: Ref, pb: Ref, a_pa: Perm, a_pb: Perm) returns (res_m0: Ref, res_m1: Int)
  requires none < a_pa && a_pa < write && none < a_pb && a_pb < write
  requires WF(pa) && WF(pb)
  requires OWNI(pa, a_pa) && OWNI(pb, a_pb)
  ensures WF(res_m0) && RNGV(res_m1)
  ensures OWNI(pa, a_pa) && OWNI(pb, a_pb) && (res_m0 == pa || res_m0 == pb) && res_m1 == 0
  decreases
{
  var s: Ref
  if (lvloc(block_of(pa)) == lvloc(block_of(pb))) { } // case split on the liveness cells (0028 item 8)
  s := alloc_struct_0_P()
  assert pa != null ==> perm(lvloc(block_of(pa)).lv) > none
  assert loc(member(s, 0), 0) != null
  assert perm(loc(member(s, 0), 0).v_ptr_int) == write && perm(loc(member(s, 0), 0).d_ptr_int) == write
  loc(member(s, 0), 0).v_ptr_int := pa
  loc(member(s, 0), 0).d_ptr_int := true
  assert loc(member(s, 1), 0) != null
  assert perm(loc(member(s, 1), 0).v_int) == write && perm(loc(member(s, 1), 0).d_int) == write
  loc(member(s, 1), 0).v_int := 0
  loc(member(s, 1), 0).d_int := true
  // return s;: every leaf is read (permission, flag, and a pointer leaf's liveness), assigned to its result, then the scope exits
  assert loc(member(s, 0), 0) != null
  assert perm(loc(member(s, 0), 0).v_ptr_int) > none && perm(loc(member(s, 0), 0).d_ptr_int) > none
  assert loc(member(s, 0), 0).d_ptr_int
  res_m0 := loc(member(s, 0), 0).v_ptr_int
  assert res_m0 != null ==> perm(lvloc(block_of(res_m0)).lv) > none
  assert loc(member(s, 1), 0) != null
  assert perm(loc(member(s, 1), 0).v_int) > none && perm(loc(member(s, 1), 0).d_int) > none
  assert loc(member(s, 1), 0).d_int
  res_m1 := loc(member(s, 1), 0).v_int
  assert perm(loc(member(s, 0), 0).v_ptr_int) == write && perm(loc(member(s, 0), 0).d_ptr_int) == write
  assert perm(loc(member(s, 1), 0).v_int) == write && perm(loc(member(s, 1), 0).d_int) == write
  assert perm(lvloc(block_of(s)).lv) == write
  exhale acc(loc(member(s, 0), 0).v_ptr_int) && acc(loc(member(s, 0), 0).d_ptr_int) && acc(loc(member(s, 1), 0).v_int) && acc(loc(member(s, 1), 0).d_int) && acc(lvloc(block_of(s)).lv)
  assert WF(res_m0)
  assert RNGV(res_m1)
  assert pa != null
  assert WF(pa)
  assert offset_of(pa) < len(block_of(pa))
  assert perm(pa.v_int) == write && perm(pa.d_int) == write
  assert pa.d_int
  assert RNG(pa)
  assert perm(lvloc(block_of(pa)).lv) >= a_pa
  assert pb != null
  assert WF(pb)
  assert offset_of(pb) < len(block_of(pb))
  assert perm(pb.v_int) == write && perm(pb.d_int) == write
  assert pb.d_int
  assert RNG(pb)
  assert perm(lvloc(block_of(pb)).lv) >= a_pb
  assert (res_m0 == pa || res_m0 == pb)
  assert res_m1 == 0
}

