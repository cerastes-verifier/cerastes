// expect: verified
// S48 (j), record 0064 item 14: struct P { int x; int y; } with a range atom (owns_range(p, n)) and user quantifiers whose reads step through a member (p[i].y == 5 in the requires, p[i].x == 1 and p[i].y == 5 in the ensures, p[i].x == 1 below i in the loop invariant of the fill loop): the read class is the pair (p, member), its trigger the leaf's receiver loc(member(loc(block_of(p), q0), j), 0), the framed read (frm ? leaf.v_int : 0); the loop has the FRAME asserts, the FLAG line and the user clause; f__wf in variant M over the leaf's ghost; a caller whose PRE row discharges the requires and reads x and y back. And, in the same file, struct SA { int n; int a[4]; } with a user quantifier over the member array in the block-term form (trigger loc(member(p, 1), q0), framing over the member's block): requires and ensures of get(p), the body reads p->a[2], f__wf in variant M, a caller (&s, PRE row, r >= 0 and a[1] >= 0 after the call). Verifies. Time recorded.
// (hand-written spike fixture of record 0064 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}


// cerastes:trusted-contract allocation of a local of type struct SA (record 0063 item 6): a one-slot block whose members are blocks; the cell member n of length 1 uninitialized with full permission, the array member a of length 4 with each element uninitialized, each quantified permission its own
method alloc_struct_0_SA() returns (r: Ref)
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == 1)
  ensures (((len(member(r, 0)) == 1) && acc(loc(member(r, 0), 0).v_int)) && acc(loc(member(r, 0), 0).d_int)) && (!loc(member(r, 0), 0).d_int)
  ensures len(member(r, 1)) == 4
  ensures forall j: Int :: { loc(member(r, 1), j) } ((0 <= j) && (j < 4)) ==> acc(loc(member(r, 1), j).v_int)
  ensures forall j: Int :: { loc(member(r, 1), j) } ((0 <= j) && (j < 4)) ==> acc(loc(member(r, 1), j).d_int)
  ensures forall j: Int :: { loc(member(r, 1), j) } ((0 <= j) && (j < 4)) ==> (!loc(member(r, 1), j).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _

