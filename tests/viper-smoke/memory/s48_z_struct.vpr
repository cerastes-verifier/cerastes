// expect: verified
// S48 after audit round 1: record 0064 item 6, the trusted zero_arr_0_S per leaf path (audit round 1 issue 6 (b)): struct S { int x; struct T { int a; int b; } t; } v[3] = {{1, {2}}}: alloc_arr_0_S(3), zero_arr_0_S(v, 3) (each leaf path's value and flag quantifier taken and returned, every leaf zero and initialized), the written leaves v[0].x == 1 and v[0].t.a == 2, the unwritten leaves read zero (v[0].t.b, v[2].t.b, v[1].x), the scope exit per leaf path. Each (receiver, field) pair is given once.
// (hand-written spike fixture of record 0064 (draft), not emitted by the tool and not checked by lint_viper.py; no `define`: every row is expanded as lowering will write it; no inhale or assume)
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// cerastes:trusted-contract allocation of a local array of struct S { int x; struct T { int a; int b; } t; } with n elements (record 0064 item 6; name per audit round 1 issue 7: the structure's numbered suffix): each element a struct slot whose members are blocks of length 1 (t's members blocks of length 1 under member 1); per leaf path one quantifier for each permission, each with its own receiver as the trigger; every flag false
method alloc_arr_0_S(n: Int) returns (r: Ref)
  requires 1 <= n
  ensures ((r != null) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  ensures forall k: Int :: { loc(block_of(r), k) } ((0 <= k) && (k < n)) ==> ((len(member(loc(block_of(r), k), 0)) == 1) && (len(member(loc(block_of(r), k), 1)) == 1) && (len(member(loc(member(loc(block_of(r), k), 1), 0), 0)) == 1) && (len(member(loc(member(loc(block_of(r), k), 1), 0), 1)) == 1))
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(block_of(r), k), 0), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(block_of(r), k), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> (!loc(member(loc(block_of(r), k), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> (!loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> (!loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).d_int)
  ensures (lvloc(block_of(r)) == loc(block_of(r), (-2))) && acc(lvloc(block_of(r)).lv)
  decreases _
// cerastes:trusted-contract the static-object part of an array initializer of struct S: it takes and returns the same permissions of every leaf path and ensures every leaf zero and initialized; it states no length facts (record 0064 item 6; its requires is the caller's length facts)
method zero_arr_0_S(r: Ref, n: Int)
  requires ((1 <= n) && (r == loc(block_of(r), 0))) && (len(block_of(r)) == n)
  requires forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(block_of(r), k), 0), 0).v_int)
  requires forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(block_of(r), k), 0), 0).d_int)
  requires forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).v_int)
  requires forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).d_int)
  requires forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).v_int)
  requires forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(block_of(r), k), 0), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(block_of(r), k), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).v_int)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> acc(loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).d_int)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> (loc(member(loc(block_of(r), k), 0), 0).v_int == 0)
  ensures forall k: Int :: { loc(member(loc(block_of(r), k), 0), 0) } ((0 <= k) && (k < n)) ==> loc(member(loc(block_of(r), k), 0), 0).d_int
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> (loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).v_int == 0)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0) } ((0 <= k) && (k < n)) ==> loc(member(loc(member(loc(block_of(r), k), 1), 0), 0), 0).d_int
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> (loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).v_int == 0)
  ensures forall k: Int :: { loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0) } ((0 <= k) && (k < n)) ==> loc(member(loc(member(loc(block_of(r), k), 1), 0), 1), 0).d_int
  decreases _
method f_init(i: Int)
  requires (0 <= i) && (i < 3)
{
  var v_a: Ref
  var tw: Ref
  var tr: Ref
  var v_r: Int
  v_a := alloc_arr_0_S(3)
  zero_arr_0_S(v_a, 3)
  tw := loc(member(loc(block_of(v_a), offset_of(v_a) + 0), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 1
  tw.d_int := true
  tw := loc(member(loc(member(loc(block_of(v_a), offset_of(v_a) + 0), 1), 0), 0), 0)
  assert !((perm(tw.v_int) != write) || (perm(tw.d_int) != write)) //WPERM
  tw.v_int := 2
  tw.d_int := true
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  tr := loc(member(loc(block_of(v_a), offset_of(v_a) + 0), 0), 0)
  assert perm(tr.v_int) > none //PERM
  assert tr.d_int //INIT
  v_r := tr.v_int
  assert v_r == 1 //VALUE
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  tr := loc(member(loc(member(loc(block_of(v_a), offset_of(v_a) + 0), 1), 0), 0), 0)
  assert perm(tr.v_int) > none //PERM
  assert tr.d_int //INIT
  v_r := tr.v_int
  assert v_r == 2 //VALUE
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  tr := loc(member(loc(member(loc(block_of(v_a), offset_of(v_a) + 0), 1), 0), 1), 0)
  assert perm(tr.v_int) > none //PERM
  assert tr.d_int //INIT
  v_r := tr.v_int
  assert v_r == 0 //VALUE
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  tr := loc(member(loc(member(loc(block_of(v_a), offset_of(v_a) + 2), 1), 0), 1), 0)
  assert perm(tr.v_int) > none //PERM
  assert tr.d_int //INIT
  v_r := tr.v_int
  assert v_r == 0 //VALUE
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  tr := loc(member(loc(block_of(v_a), offset_of(v_a) + 1), 0), 0)
  assert perm(tr.v_int) > none //PERM
  assert tr.d_int //INIT
  v_r := tr.v_int
  assert v_r == 0 //VALUE
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int) //MARKED
  assert forall k: Int :: { loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 0), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 0), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 0), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 0), 0).d_int) //MARKED
  assert forall k: Int :: { loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 1), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 1), 0).v_int) //MARKED
  assert forall k: Int :: { loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 1), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 1), 0).d_int) //MARKED
  assert perm(lvloc(block_of(v_a)).lv) == write //LIVE
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).v_int)
  exhale forall k: Int :: { loc(member(loc(block_of(v_a), k), 0), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(block_of(v_a), k), 0), 0).d_int)
  exhale forall k: Int :: { loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 0), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 0), 0).v_int)
  exhale forall k: Int :: { loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 0), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 0), 0).d_int)
  exhale forall k: Int :: { loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 1), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 1), 0).v_int)
  exhale forall k: Int :: { loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 1), 0) } ((0 <= k) && (k < 3)) ==> acc(loc(member(loc(member(loc(block_of(v_a), k), 1), 0), 1), 0).d_int)
  exhale acc(lvloc(block_of(v_a)).lv)
}
