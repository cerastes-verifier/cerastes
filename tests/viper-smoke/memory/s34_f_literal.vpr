// expect: verified
// S34 (f) hidden compound-literal objects in C (record 0044 item 7): `&(struct S){1, 2}` is a hidden local `cl_<n>` allocated at the START of its block (before the first statement), its leaves stored inside the expression (value, then flag), its address used (lifetime assert) and passed to `set_s` (owns(*p)), and its scope exit at the block's end; the same inside a loop body (allocation and scope exit per iteration), for `&(int){5}`, and in an if condition (the wrapper block `{Decl; If}`).
// Hand-written in the emitted style: explicit atomic asserts before every access, call and return (0028 item 11), ghost Perm amounts (0037 item 6), the four axioms with their tags; the allocation methods and program_start are the trusted ones (records 0043 item 4, 0041 item 4, 0044).
field v_int: Int
field d_int: Bool
field lv: Bool

// cerastes:domain-ok 0028
domain Block {
  function loc(b: Block, i: Int): Ref
  function len(b: Block): Int
  function block_of(r: Ref): Block
  function offset_of(r: Ref): Int
  function member(r: Ref, k: Int): Block
  function parent_of(b: Block): Ref
  function index_of(b: Block): Int
  function lvloc(b: Block): Ref
  // cerastes:axiom-ok 0033
  axiom loc_inv { forall b: Block, i: Int :: { loc(b, i) } block_of(loc(b, i)) == b && offset_of(loc(b, i)) == i }
  // cerastes:axiom-ok 0034
  axiom loc_nonnull { forall b: Block, i: Int :: { loc(b, i) } loc(b, i) != null }
  // cerastes:axiom-ok 0035
  axiom member_inv { forall r: Ref, k: Int :: { member(r, k) } parent_of(member(r, k)) == r && index_of(member(r, k)) == k }
  // cerastes:axiom-ok 0036
  axiom member_lv { forall r: Ref, k: Int :: { lvloc(member(r, k)) } lvloc(member(r, k)) == lvloc(block_of(r)) }
}

// the contract atoms, as macros over the emitted shapes (record 0043 items 3, 9; record 0044 items 3-5, 8): WF; a leaf's range; a leaf at allocation (uninitialized); a leaf owned (full permission, flag set, range); one liveness fraction
define WF(p) (p == null || (p == loc(block_of(p), offset_of(p)) && 0 <= offset_of(p) && offset_of(p) <= len(block_of(p))))
define RNG(c) ((-2147483648) <= c.v_int && c.v_int <= 2147483647)
define RNGV(v) ((-2147483648) <= v && v <= 2147483647)
define LEAFU(c) (acc(c.v_int) && acc(c.d_int) && !c.d_int)
define LEAF(c) (acc(c.v_int) && acc(c.d_int) && c.d_int && RNG(c))
define LVF(p, a) acc(lvloc(block_of(p)).lv, a)
// struct S { int x; int y; }: member 0 is x, member 1 is y; struct T { struct S s; int z; }: member 0 is the slot of the nested S, member 1 is z
define MX(s) loc(member(s, 0), 0)
define MY(s) loc(member(s, 1), 0)
define TS(t) loc(member(t, 0), 0)
define TZ(t) loc(member(t, 1), 0)
define SLEN(s) (len(member(s, 0)) == 1 && len(member(s, 1)) == 1)
define SOWN(s) (SLEN(s) && LEAF(MX(s)) && LEAF(MY(s)))
define TLEN(t) (len(member(t, 0)) == 1 && len(member(t, 1)) == 1)
define TOWN(t) (TLEN(t) && SOWN(TS(t)) && LEAF(TZ(t)))
define ROOT(p) (p != null && WF(p) && offset_of(p) < len(block_of(p)))
define OWNI(p, a) (ROOT(p) && LEAF(p) && LVF(p, a))


// cerastes:trusted-contract allocation of a struct S local: a one-slot block; each member is a block of length 1 whose leaf is uninitialized with full permission; the liveness token is the root block's (record 0043 item 4)
method alloc_struct_0_S() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures len(member(r, 0)) == 1 && acc(loc(member(r, 0), 0).v_int) && acc(loc(member(r, 0), 0).d_int) && !loc(member(r, 0), 0).d_int
  ensures len(member(r, 1)) == 1 && acc(loc(member(r, 1), 0).v_int) && acc(loc(member(r, 1), 0).d_int) && !loc(member(r, 1), 0).d_int
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(lvloc(block_of(r)).lv)
  decreases _

// cerastes:trusted-contract allocation of an address-taken local of type int: a fresh one-slot block, the cell uninitialized and the block's liveness token, full permission (decision 0032 item 4)
method alloc_int() returns (r: Ref)
  ensures r != null && r == loc(block_of(r), 0) && len(block_of(r)) == 1
  ensures lvloc(block_of(r)) == loc(block_of(r), -2) && acc(r.v_int) && acc(r.d_int) && !r.d_int && acc(lvloc(block_of(r)).lv)
  decreases _

// void set_s(struct S *s) [owns(*s)]: s->x = 7; ensures s->x == 7 && s->y == old(s->y)
method f_set_s__0(s: Ref, a_s: Perm)
  requires none < a_s && a_s < write
  requires WF(s)
  requires ROOT(s) && SOWN(s) && LVF(s, a_s)
  ensures ROOT(s) && SOWN(s) && LVF(s, a_s) && MX(s).v_int == 7 && MY(s).v_int == old(MY(s).v_int)
  decreases
{
  var oy: Int := loc(member(s, 1), 0).v_int
  assert loc(member(s, 0), 0) != null
  assert perm(loc(member(s, 0), 0).v_int) == write && perm(loc(member(s, 0), 0).d_int) == write
  loc(member(s, 0), 0).v_int := 7
  loc(member(s, 0), 0).d_int := true
  assert s != null
  assert WF(s)
  assert offset_of(s) < len(block_of(s))
  assert len(member(s, 0)) == 1 && len(member(s, 1)) == 1
  assert perm(loc(member(s, 0), 0).v_int) == write && perm(loc(member(s, 0), 0).d_int) == write
  assert loc(member(s, 0), 0).d_int
  assert RNG(loc(member(s, 0), 0))
  assert perm(loc(member(s, 1), 0).v_int) == write && perm(loc(member(s, 1), 0).d_int) == write
  assert loc(member(s, 1), 0).d_int
  assert RNG(loc(member(s, 1), 0))
  assert perm(lvloc(block_of(s)).lv) >= a_s
  assert loc(member(s, 0), 0).v_int == 7
  assert loc(member(s, 1), 0).v_int == oy
}

// void use(void) { int k = 0; struct S *p = &(struct S){1, 2}; set_s(p); check(p->x == 7 && p->y == 2 && k == 0); }   (C: a hidden local of the block, record 0044 item 7)
method f_use__1()
  decreases
{
  var cl_0: Ref
  var p: Ref
  var k: Int
  cl_0 := alloc_struct_0_S()   // the hidden object is allocated at the START of the block, before the first statement
  // int k = 0;
  k := 0
  // struct S *p = &(struct S){1, 2};
  // the literal's leaves are stored inside the expression (value, then flag)
  assert loc(member(cl_0, 0), 0) != null
  assert perm(loc(member(cl_0, 0), 0).v_int) == write && perm(loc(member(cl_0, 0), 0).d_int) == write
  loc(member(cl_0, 0), 0).v_int := 1
  loc(member(cl_0, 0), 0).d_int := true
  assert loc(member(cl_0, 1), 0) != null
  assert perm(loc(member(cl_0, 1), 0).v_int) == write && perm(loc(member(cl_0, 1), 0).d_int) == write
  loc(member(cl_0, 1), 0).v_int := 2
  loc(member(cl_0, 1), 0).d_int := true
  assert perm(lvloc(block_of(cl_0)).lv) > none
  p := cl_0
  // set_s(p);
  assert perm(lvloc(block_of(p)).lv) > none
  assert WF(p)
  assert p != null
  assert WF(p)
  assert offset_of(p) < len(block_of(p))
  assert len(member(p, 0)) == 1 && len(member(p, 1)) == 1
  assert perm(loc(member(p, 0), 0).v_int) == write && perm(loc(member(p, 0), 0).d_int) == write
  assert loc(member(p, 0), 0).d_int
  assert RNG(loc(member(p, 0), 0))
  assert perm(loc(member(p, 1), 0).v_int) == write && perm(loc(member(p, 1), 0).d_int) == write
  assert loc(member(p, 1), 0).d_int
  assert RNG(loc(member(p, 1), 0))
  assert perm(lvloc(block_of(p)).lv) > none
  assert none < (perm(lvloc(block_of(p)).lv) / 2) && (perm(lvloc(block_of(p)).lv) / 2) < write
  assert perm(lvloc(block_of(p)).lv) >= (perm(lvloc(block_of(p)).lv) / 2)
  f_set_s__0(p, (perm(lvloc(block_of(p)).lv) / 2))
  // check(p->x == 7 && p->y == 2 && k == 0)
  assert p != null
  assert loc(member(p, 0), 0) != null
  assert perm(loc(member(p, 0), 0).v_int) > none && perm(loc(member(p, 0), 0).d_int) > none
  assert loc(member(p, 0), 0).d_int
  assert loc(member(p, 1), 0) != null
  assert perm(loc(member(p, 1), 0).v_int) > none && perm(loc(member(p, 1), 0).d_int) > none
  assert loc(member(p, 1), 0).d_int
  assert loc(member(p, 0), 0).v_int == 7 && loc(member(p, 1), 0).v_int == 2 && k == 0
  // the block ends
  assert perm(loc(member(cl_0, 0), 0).v_int) == write && perm(loc(member(cl_0, 0), 0).d_int) == write
  assert perm(loc(member(cl_0, 1), 0).v_int) == write && perm(loc(member(cl_0, 1), 0).d_int) == write
  assert perm(lvloc(block_of(cl_0)).lv) == write
  exhale acc(loc(member(cl_0, 0), 0).v_int) && acc(loc(member(cl_0, 0), 0).d_int) && acc(loc(member(cl_0, 1), 0).v_int) && acc(loc(member(cl_0, 1), 0).d_int) && acc(lvloc(block_of(cl_0)).lv)
}

// void use_loop(void) { for (int i = 0; i < 3; i++) { set_s(&(struct S){1, 2}); } }
method f_use_loop__2()
  decreases
{
  var v_i: Int
  var cl_1: Ref
  v_i := 0
  // for (int i = 0; i < 3; i++) { set_s(&(struct S){1, 2}); }   (the hidden object belongs to the loop body: allocated and exited once per iteration)
  while (v_i < 3)
    invariant RNGV(v_i)
    invariant 0 <= v_i && v_i <= 3
    decreases 3 - v_i
  {
    cl_1 := alloc_struct_0_S()
    // the literal's leaves are stored inside the expression (value, then flag)
    assert loc(member(cl_1, 0), 0) != null
    assert perm(loc(member(cl_1, 0), 0).v_int) == write && perm(loc(member(cl_1, 0), 0).d_int) == write
    loc(member(cl_1, 0), 0).v_int := 1
    loc(member(cl_1, 0), 0).d_int := true
    assert loc(member(cl_1, 1), 0) != null
    assert perm(loc(member(cl_1, 1), 0).v_int) == write && perm(loc(member(cl_1, 1), 0).d_int) == write
    loc(member(cl_1, 1), 0).v_int := 2
    loc(member(cl_1, 1), 0).d_int := true
    assert perm(lvloc(block_of(cl_1)).lv) > none
    assert WF(cl_1)
    assert cl_1 != null
    assert WF(cl_1)
    assert offset_of(cl_1) < len(block_of(cl_1))
    assert len(member(cl_1, 0)) == 1 && len(member(cl_1, 1)) == 1
    assert perm(loc(member(cl_1, 0), 0).v_int) == write && perm(loc(member(cl_1, 0), 0).d_int) == write
    assert loc(member(cl_1, 0), 0).d_int
    assert RNG(loc(member(cl_1, 0), 0))
    assert perm(loc(member(cl_1, 1), 0).v_int) == write && perm(loc(member(cl_1, 1), 0).d_int) == write
    assert loc(member(cl_1, 1), 0).d_int
    assert RNG(loc(member(cl_1, 1), 0))
    assert perm(lvloc(block_of(cl_1)).lv) > none
    assert none < (perm(lvloc(block_of(cl_1)).lv) / 2) && (perm(lvloc(block_of(cl_1)).lv) / 2) < write
    assert perm(lvloc(block_of(cl_1)).lv) >= (perm(lvloc(block_of(cl_1)).lv) / 2)
    f_set_s__0(cl_1, (perm(lvloc(block_of(cl_1)).lv) / 2))
    assert perm(loc(member(cl_1, 0), 0).v_int) == write && perm(loc(member(cl_1, 0), 0).d_int) == write
    assert perm(loc(member(cl_1, 1), 0).v_int) == write && perm(loc(member(cl_1, 1), 0).d_int) == write
    assert perm(lvloc(block_of(cl_1)).lv) == write
    exhale acc(loc(member(cl_1, 0), 0).v_int) && acc(loc(member(cl_1, 0), 0).d_int) && acc(loc(member(cl_1, 1), 0).v_int) && acc(loc(member(cl_1, 1), 0).d_int) && acc(lvloc(block_of(cl_1)).lv)
    assert !((((v_i + 1) < (-2147483648)) || (2147483647 < (v_i + 1))))
    v_i := v_i + 1
  }
}

// void int_lit(void) { int *p = &(int){5}; *p += 1; check(*p == 6); }
method f_int_lit__3()
  decreases
{
  var cl_2: Ref
  var p: Ref
  cl_2 := alloc_int()
  // int *p = &(int){5};
  assert cl_2 != null
  assert perm(cl_2.v_int) == write && perm(cl_2.d_int) == write
  cl_2.v_int := 5
  cl_2.d_int := true
  assert perm(lvloc(block_of(cl_2)).lv) > none
  p := cl_2
  // *p += 1;
  assert p != null
  assert p != null
  assert perm(p.v_int) > none && perm(p.d_int) > none
  assert p.d_int
  assert !(((p.v_int + 1) < (-2147483648)) || (2147483647 < (p.v_int + 1)))
  assert p != null
  assert perm(p.v_int) == write && perm(p.d_int) == write
  p.v_int := p.v_int + 1
  p.d_int := true
  // check(*p == 6)
  assert p != null
  assert p != null
  assert perm(p.v_int) > none && perm(p.d_int) > none
  assert p.d_int
  assert p.v_int == 6
  assert perm(cl_2.v_int) == write && perm(cl_2.d_int) == write
  assert perm(lvloc(block_of(cl_2)).lv) == write
  exhale acc(cl_2.v_int) && acc(cl_2.d_int) && acc(lvloc(block_of(cl_2)).lv)
}

// void cond(void) { struct S *p = NULL; if ((p = &(struct S){1, 2}) != NULL) { check(p->x == 1); } }
method f_cond__4()
  decreases
{
  var cl_3: Ref
  var p: Ref
  // struct S *p = NULL;
  p := null
  // if ((p = &(struct S){1, 2}) != NULL) { check(p->x == 1); }   (the condition's literal belongs to the wrapper block {Decl; If}, C23 6.8.4p3)
  cl_3 := alloc_struct_0_S()
  // the literal's leaves are stored inside the expression (value, then flag)
  assert loc(member(cl_3, 0), 0) != null
  assert perm(loc(member(cl_3, 0), 0).v_int) == write && perm(loc(member(cl_3, 0), 0).d_int) == write
  loc(member(cl_3, 0), 0).v_int := 1
  loc(member(cl_3, 0), 0).d_int := true
  assert loc(member(cl_3, 1), 0) != null
  assert perm(loc(member(cl_3, 1), 0).v_int) == write && perm(loc(member(cl_3, 1), 0).d_int) == write
  loc(member(cl_3, 1), 0).v_int := 2
  loc(member(cl_3, 1), 0).d_int := true
  assert perm(lvloc(block_of(cl_3)).lv) > none
  p := cl_3
  assert p != null ==> perm(lvloc(block_of(p)).lv) > none
  if (p != null) {
    assert p != null
    assert loc(member(p, 0), 0) != null
    assert perm(loc(member(p, 0), 0).v_int) > none && perm(loc(member(p, 0), 0).d_int) > none
    assert loc(member(p, 0), 0).d_int
    assert loc(member(p, 0), 0).v_int == 1
  }
  assert perm(loc(member(cl_3, 0), 0).v_int) == write && perm(loc(member(cl_3, 0), 0).d_int) == write
  assert perm(loc(member(cl_3, 1), 0).v_int) == write && perm(loc(member(cl_3, 1), 0).d_int) == write
  assert perm(lvloc(block_of(cl_3)).lv) == write
  exhale acc(loc(member(cl_3, 0), 0).v_int) && acc(loc(member(cl_3, 0), 0).d_int) && acc(loc(member(cl_3, 1), 0).v_int) && acc(loc(member(cl_3, 1), 0).d_int) && acc(lvloc(block_of(cl_3)).lv)
}
