method same_range_twice()
{
  var v_a: Ref
  var l1: Perm
  var l2: Perm
  var ra1: Ref
  var ra2: Ref
  v_a := alloc_arr_int(4)
  assert !((offset_of(v_a) + 0 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 0)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 0).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 0).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 0).v_int := 1
  loc(block_of(v_a), offset_of(v_a) + 0).d_int := true
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 1).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 1).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 1).v_int := 2
  loc(block_of(v_a), offset_of(v_a) + 1).d_int := true
  assert !((offset_of(v_a) + 2 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 2)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 2).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 2).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 2).v_int := 3
  loc(block_of(v_a), offset_of(v_a) + 2).d_int := true
  assert !((offset_of(v_a) + 3 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 3)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 3).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 3).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 3).v_int := 4
  loc(block_of(v_a), offset_of(v_a) + 3).d_int := true
  ra1 := loc(block_of(v_a), offset_of(v_a) + 0)
  ra2 := loc(block_of(v_a), offset_of(v_a) + 0)
  assert !((ra1 == null) || !((ra1 == loc(block_of(ra1), offset_of(ra1))) && (0 <= offset_of(ra1)) && (offset_of(ra1) <= len(block_of(ra1)))) || (4 < 0) || (len(block_of(ra1)) < offset_of(ra1) + 4)) //SHAPE
  assert !((ra2 == null) || !((ra2 == loc(block_of(ra2), offset_of(ra2))) && (0 <= offset_of(ra2)) && (offset_of(ra2) <= len(block_of(ra2)))) || (4 < 0) || (len(block_of(ra2)) < offset_of(ra2) + 4)) //SHAPE
  assert !((4 > 0) && ((perm(loc(block_of(ra1), offset_of(ra1)).v_int) == none) || (perm(loc(block_of(ra1), offset_of(ra1)).d_int) == none))) //RDROW
  assert perm(lvloc(block_of(ra1)).lv) > none //LIVEROW
  assert !((4 > 0) && ((perm(loc(block_of(ra2), offset_of(ra2)).v_int) == none) || (perm(loc(block_of(ra2), offset_of(ra2)).d_int) == none))) //RDROW
  assert perm(lvloc(block_of(ra2)).lv) > none //LIVEROW
  l1 := ((4 > 0) ? ((perm(loc(block_of(ra1), offset_of(ra1)).v_int) < perm(loc(block_of(ra1), offset_of(ra1)).d_int) ? perm(loc(block_of(ra1), offset_of(ra1)).v_int) : perm(loc(block_of(ra1), offset_of(ra1)).d_int)) < perm(lvloc(block_of(ra1)).lv) ? (perm(loc(block_of(ra1), offset_of(ra1)).v_int) < perm(loc(block_of(ra1), offset_of(ra1)).d_int) ? perm(loc(block_of(ra1), offset_of(ra1)).v_int) : perm(loc(block_of(ra1), offset_of(ra1)).d_int)) : perm(lvloc(block_of(ra1)).lv)) : perm(lvloc(block_of(ra1)).lv)) / 3
  l2 := ((4 > 0) ? ((perm(loc(block_of(ra2), offset_of(ra2)).v_int) < perm(loc(block_of(ra2), offset_of(ra2)).d_int) ? perm(loc(block_of(ra2), offset_of(ra2)).v_int) : perm(loc(block_of(ra2), offset_of(ra2)).d_int)) < perm(lvloc(block_of(ra2)).lv) ? (perm(loc(block_of(ra2), offset_of(ra2)).v_int) < perm(loc(block_of(ra2), offset_of(ra2)).d_int) ? perm(loc(block_of(ra2), offset_of(ra2)).v_int) : perm(loc(block_of(ra2), offset_of(ra2)).d_int)) : perm(lvloc(block_of(ra2)).lv)) : perm(lvloc(block_of(ra2)).lv)) / 3
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> acc(loc(block_of(ra1), k).v_int, l1) //MARKED
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> acc(loc(block_of(ra1), k).d_int, l1) //MARKED
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> loc(block_of(ra1), k).d_int //FLAGS
  assert forall k: Int :: { loc(block_of(ra1), k) } ((offset_of(ra1) <= k) && (k < offset_of(ra1) + 4)) ==> (loc(block_of(ra1), k).d_int ==> ((-2147483648 <= loc(block_of(ra1), k).v_int) && (loc(block_of(ra1), k).v_int <= 2147483647))) //RANGE
  assert forall k: Int :: { loc(block_of(ra2), k) } ((offset_of(ra2) <= k) && (k < offset_of(ra2) + 4)) ==> acc(loc(block_of(ra2), k).v_int, l2) //MARKED
  assert forall k: Int :: { loc(block_of(ra2), k) } ((offset_of(ra2) <= k) && (k < offset_of(ra2) + 4)) ==> acc(loc(block_of(ra2), k).d_int, l2) //MARKED
  assert forall k: Int :: { loc(block_of(ra2), k) } ((offset_of(ra2) <= k) && (k < offset_of(ra2) + 4)) ==> loc(block_of(ra2), k).d_int //FLAGS
  assert forall k: Int :: { loc(block_of(ra2), k) } ((offset_of(ra2) <= k) && (k < offset_of(ra2) + 4)) ==> (loc(block_of(ra2), k).d_int ==> ((-2147483648 <= loc(block_of(ra2), k).v_int) && (loc(block_of(ra2), k).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(ra1)).lv) >= l1 + (lvloc(block_of(ra2)) == lvloc(block_of(ra1)) ? l2 : none) //LIVESUM
  assert perm(lvloc(block_of(ra2)).lv) >= l2 + (lvloc(block_of(ra1)) == lvloc(block_of(ra2)) ? l1 : none) //LIVESUM
  peek2(ra1, 4, ra2, 4, l1, l2)
  assert !((offset_of(v_a) + 1 < 0) || (len(block_of(v_a)) <= offset_of(v_a) + 1)) //BOUND
  assert !((perm(loc(block_of(v_a), offset_of(v_a) + 1).v_int) != write) || (perm(loc(block_of(v_a), offset_of(v_a) + 1).d_int) != write)) //WPERM
  loc(block_of(v_a), offset_of(v_a) + 1).v_int := 8
  loc(block_of(v_a), offset_of(v_a) + 1).d_int := true
  assert loc(block_of(v_a), offset_of(v_a) + 1).v_int == 8
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int) //MARKED
  assert forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int) //MARKED
  assert !(perm(lvloc(block_of(v_a)).lv) != write) //LIVE
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).v_int)
  exhale forall k: Int :: { loc(block_of(v_a), k) } ((0 <= k) && (k < 4)) ==> acc(loc(block_of(v_a), k).d_int)
  exhale acc(lvloc(block_of(v_a)).lv)
  assert false // <- expected failure
}

