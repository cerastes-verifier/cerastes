  requires forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647))
  requires acc(lvloc(block_of(p)).lv, amt)
  ensures ((p != null) && ((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))) && (0 <= n) && (offset_of(p) + n <= len(block_of(p))))
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).v_int, amt)
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).d_int, amt)
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> loc(block_of(p), k).d_int
  ensures forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647))
  ensures acc(lvloc(block_of(p)).lv, amt)
{
  assert forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).v_int, amt) //MARKED
  assert forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> acc(loc(block_of(p), k).d_int, amt) //MARKED
  assert !((p == null) || !((p == loc(block_of(p), offset_of(p))) && (0 <= offset_of(p)) && (offset_of(p) <= len(block_of(p)))) || (n < 0) || (len(block_of(p)) < offset_of(p) + n)) //SHAPE
  assert (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> loc(block_of(p), k).d_int) //FLAGS
  assert (forall k: Int :: { loc(block_of(p), k) } ((offset_of(p) <= k) && (k < offset_of(p) + n)) ==> ((-2147483648 <= loc(block_of(p), k).v_int) && (loc(block_of(p), k).v_int <= 2147483647))) //RANGE
  assert perm(lvloc(block_of(p)).lv) >= amt //LIVE
